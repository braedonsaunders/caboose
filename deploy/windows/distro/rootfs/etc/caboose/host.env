# Settings for caboose-host (apps/host/README.md, "Configuration"), one NAME=value per line.
# They override the defaults in caboose-host.service, and upgrades keep this file.
# Apply a change with: systemctl restart caboose-host
#
# CABOOSE_MEMORY_MB=6144
# CABOOSE_VCPUS=4
# CABOOSE_GUEST_LAN=deny
