#!/bin/sh
# Stand-in for claude, for check-agent-shell.sh: emits stream-json -p ... --output-format stream-json
prompt=""; resume=""; ask=""
while [ $# -gt 0 ]; do
  case "$1" in
    -p) prompt=$2; shift 2 ;;
    --resume) resume=$2; shift 2 ;;
    --permission-prompt-tool) ask=$2; shift 2 ;;
    *) shift ;;
  esac
done
session=${resume:-c237ef1f-3019-47c0-b325-b54d7cb4781d}
printf '{"type":"system","subtype":"init","session_id":"%s","cwd":"%s","task_dir":"%s"}\n' "$session" "$PWD" "$CABOOSE_TASK_DIR"
first=$(printf %s "$prompt" | head -n 1)
printf '{"type":"assistant","message":{"content":[{"type":"text","text":"heard: %s (lines: %s)"}]}}\n' "$first" "$(printf %s "$prompt" | wc -l)"
if [ -n "$ask" ]; then
  id=$(cat /proc/sys/kernel/random/uuid)
  mkdir -p "$CABOOSE_TASK_DIR/approvals"
  printf '{"tool":"Bash","input":{"command":"rm -rf build"},"requestedAt":"2026-01-01T00:00:00Z"}' > "$CABOOSE_TASK_DIR/approvals/$id.json.tmp"
  mv "$CABOOSE_TASK_DIR/approvals/$id.json.tmp" "$CABOOSE_TASK_DIR/approvals/$id.json"
  while [ ! -f "$CABOOSE_TASK_DIR/approvals/$id.decision" ]; do sleep 0.2; done
  printf '{"type":"assistant","message":{"content":[{"type":"text","text":"decision %s"}]}}\n' "$(tr -d '"{}' < "$CABOOSE_TASK_DIR/approvals/$id.decision")"
fi
sleep 1
printf '{"type":"result","subtype":"success","is_error":false,"result":"done: %s as %s in %s"}\n' "$first" "$(id -un)" "$DISPLAY"
