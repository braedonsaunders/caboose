#!/bin/sh
# Stand-in for codex, for check-agent-shell.sh: emits exec --json events exec [resume] --json ...
shift # exec
resume=""; [ "$1" = resume ] && { resume=1; shift; }
pos=""
while [ $# -gt 0 ]; do
  case "$1" in
    -c) printf '%s\n' "$2" >> codex-config.log; shift 2 ;;
    --*) shift ;;
    *) pos="$pos
$1"; shift ;;
  esac
done
if [ -n "$resume" ]; then thread=$(printf %s "$pos" | sed -n 2p); prompt=$(printf %s "$pos" | sed -n '3,$p'); else thread=01a180b6-72e3-7d31-abd8-e6988a958814; prompt=$(printf %s "$pos" | sed -n '2,$p'); fi
printf '{"type":"thread.started","thread_id":"%s"}\n' "$thread"
printf '{"type":"item.completed","item":{"type":"agent_message","text":"codex heard %s"}}\n' "$(printf %s "$prompt" | head -n1)"
sleep 1
printf '{"type":"turn.completed"}\n'
