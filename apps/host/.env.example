# Set this to a long random secret; never commit the real value.
CABOOSE_OWNER_TOKEN=
CABOOSE_BIND=127.0.0.1
CABOOSE_PORT=7310
CABOOSE_IDLE_MS=600000
CABOOSE_IMAGE_ROOT=/var/lib/caboose
CABOOSE_MEMORY_MB=6144
CABOOSE_VCPUS=4
CABOOSE_VMM_PATH=/usr/local/bin/cloud-hypervisor
# Optional absolute path to the built management UI. Defaults to apps/web/dist.
CABOOSE_WEB_ROOT=
# The guest reaches only the public internet. Set to allow to let it reach this LAN.
CABOOSE_GUEST_LAN=deny
# Agents come from the Agent Client Protocol registry. Point this at a mirror to use another.
CABOOSE_AGENT_REGISTRY_URL=https://cdn.agentclientprotocol.com/registry/v1/latest/registry.json
# How long an agent stays running after a turn, waiting for a reply (milliseconds).
CABOOSE_AGENT_IDLE_MS=600000

# Optional APNs provider credentials (all four must be set together). Keep the .p8 private.
CABOOSE_APNS_KEY_PATH=
CABOOSE_APNS_KEY_ID=
CABOOSE_APNS_TEAM_ID=
CABOOSE_APNS_TOPIC=

# Optional Linux microVM memory settings.
# CABOOSE_VM_COW=on
# CABOOSE_VM_FREE_PAGE_REPORTING=on
# Cold snapshot tier: store the private 32-byte hex key outside the bucket and back it up.
# CABOOSE_SNAPSHOT_TIER=on
# CABOOSE_SNAPSHOT_KEY_FILE=/path/to/private-snapshot-key
# APPKIT_STORAGE_ENDPOINT=https://storage.example.com
# APPKIT_STORAGE_BUCKET=caboose-snapshots
# APPKIT_STORAGE_ACCESS_KEY_ID=
# APPKIT_STORAGE_SECRET_ACCESS_KEY=
