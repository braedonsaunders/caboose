Per-thread decode state, so that replays of different files can run on different threads at once:
the decode allocator, the common object info table, the feature structs device creation chains in,
the placeholder swapchain handle counter and the log-once flags.

diff --git a/framework/decode/common_object_info_table.cpp b/framework/decode/common_object_info_table.cpp
--- a/framework/decode/common_object_info_table.cpp
+++ b/framework/decode/common_object_info_table.cpp
@@ -26,8 +26,8 @@
 GFXRECON_BEGIN_NAMESPACE(gfxrecon)
 GFXRECON_BEGIN_NAMESPACE(decode)
 
-CommonObjectInfoTable* CommonObjectInfoTable::singleton_          = nullptr;
-uint32_t               CommonObjectInfoTable::singleton_refcount_ = 0;
+thread_local CommonObjectInfoTable* CommonObjectInfoTable::singleton_          = nullptr;
+thread_local uint32_t               CommonObjectInfoTable::singleton_refcount_ = 0;
 
 CommonObjectInfoTable* CommonObjectInfoTable::GetSingleton()
 {
diff --git a/framework/decode/common_object_info_table.h b/framework/decode/common_object_info_table.h
--- a/framework/decode/common_object_info_table.h
+++ b/framework/decode/common_object_info_table.h
@@ -49,8 +49,10 @@
     static void                   ReleaseSingleton();
 
   private:
-    static CommonObjectInfoTable* singleton_;
-    static uint32_t               singleton_refcount_;
+    // One table per thread: a replay consumer gets and releases it on the thread that replays its file, so consumers
+    // replaying different files on different threads do not share capture handle ids.
+    static thread_local CommonObjectInfoTable* singleton_;
+    static thread_local uint32_t               singleton_refcount_;
 };
 
 GFXRECON_END_NAMESPACE(decode)
