+            if (sub == commandBuffer) continue;
+            if (auto* subInfo = gfxstream::base::find(commandBufferInfos, sub)) {
+                subInfo->cabooseParentPrimaries.erase(commandBuffer);
+            }
+        }
+        cbInfo->cabooseBeginFailure = VK_SUCCESS;
+        cbInfo->cabooseSecondaryFailure = VK_SUCCESS;
+        cbInfo->cabooseRecordingActive = false;
+        cbInfo->cabooseRecordingInvalid = false;
+        cbInfo->cabooseParentPrimaries.clear();
+        cbInfo->reset();
+    }
