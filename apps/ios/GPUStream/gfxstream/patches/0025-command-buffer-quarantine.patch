+    static void resetCommandBufferWithInfos(
+        VkCommandBuffer commandBuffer,
+        std::unordered_map<VkCommandBuffer, CommandBufferInfo>& commandBufferInfos) {
+        auto* cbInfo = gfxstream::base::find(commandBufferInfos, commandBuffer);
+        if (!cbInfo) return;
+        for (VkCommandBuffer parentPrimary : cbInfo->cabooseParentPrimaries) {
+            if (parentPrimary == commandBuffer) continue;
+            if (auto* parentInfo = gfxstream::base::find(commandBufferInfos, parentPrimary)) {
+                parentInfo->cabooseRecordingInvalid = true;
+                parentInfo->subCmds.erase(
+                    std::remove(parentInfo->subCmds.begin(), parentInfo->subCmds.end(),
+                                commandBuffer),
