+            worklist.pop_back();
+            if (!visited.insert(cmdBuffer).second) {
+                continue;
+            }
+            const auto* cbInfo = gfxstream::base::find(mCommandBufferInfo, cmdBuffer);
+            if (!cbInfo) {
+                VkCommandBuffer unboxed = try_unbox_VkCommandBuffer(cmdBuffer);
+                if (unboxed) {
+                    cbInfo = gfxstream::base::find(mCommandBufferInfo, unboxed);
+                }
+            }
+            if (!cbInfo || cbInfo->cabooseRecordingActive || cbInfo->cabooseRecordingInvalid ||
+                cbInfo->cabooseBeginFailure != VK_SUCCESS ||
+                cbInfo->cabooseSecondaryFailure != VK_SUCCESS) {
+                return false;
+            }
+            for (VkCommandBuffer sub : cbInfo->subCmds) {
+                worklist.push_back(sub);
+            }
+        }
+        return true;
+    }
