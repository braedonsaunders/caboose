+    VkResult acquireCabooseSwapchainDevice(uint32_t contextId, VkInstance boxedInstance,
+        VkDevice boxedDevice, std::unique_ptr<CabooseSwapchainDevice>* out) {
+        if (!out) return VK_ERROR_INITIALIZATION_FAILED;
+        out->reset();
+        if (!contextId || !boxedInstance || !boxedDevice) return VK_ERROR_INITIALIZATION_FAILED;
+        auto result = std::make_unique<CabooseSwapchainDevice>();
+        std::lock_guard<std::mutex> lock(mMutex);
+        VkInstance instance = try_unbox_VkInstance(boxedInstance);
+        VkDevice device = try_unbox_VkDevice(boxedDevice);
+        auto* inst = gfxstream::base::find(mInstanceInfo, instance);
+        auto* dev = gfxstream::base::find(mDeviceInfo, device);
+        if (!inst || !dev || inst->boxed != boxedInstance || inst->contextId != contextId ||
+            dev->boxed != boxedDevice) return VK_ERROR_INITIALIZATION_FAILED;
+        auto* physical = gfxstream::base::find(mPhysdevInfo, dev->physicalDevice);
+        if (!physical || physical->instance != instance) return VK_ERROR_INITIALIZATION_FAILED;
+        if (!dev->caboosePresentFenceEnabled) return VK_ERROR_FEATURE_NOT_PRESENT;
+        if (!result->lease.acquire(inst->cabooseLifetime) || !result->lease.acquire(dev->cabooseLifetime))
+            return VK_ERROR_INITIALIZATION_FAILED;
+        result->vk = dispatch_VkDevice(boxedDevice);
+        if (!result->vk) return VK_ERROR_INITIALIZATION_FAILED;
+        result->instance = instance; result->physicalDevice = dev->physicalDevice; result->device = device;
