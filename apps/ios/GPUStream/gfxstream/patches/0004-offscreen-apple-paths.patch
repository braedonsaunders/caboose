@@ -341,0 +347,19 @@
+#elif defined(__APPLE__) && TARGET_OS_IPHONE
+    // Query the current executable without the macOS libproc API.
+    std::vector<char> path(PATH_MAX);
+    uint32_t pathSize = static_cast<uint32_t>(path.size());
+    int status = _NSGetExecutablePath(path.data(), &pathSize);
+    if (status != 0 && pathSize > path.size()) {
+        path.resize(pathSize);
+        status = _NSGetExecutablePath(path.data(), &pathSize);
+    }
+    if (status == 0) {
+        char* slash = ::strrchr(path.data(), '/');
+        if (slash) {
+            while (slash > path.data() + 1 && slash[-1] == '/') --slash;
+            if (slash == path.data()) ++slash;
+            *slash = '\0';
+            res.assign(path.data());
+        }
+    }
+    if (res.empty()) res.assign("<unknown-application-dir>");
