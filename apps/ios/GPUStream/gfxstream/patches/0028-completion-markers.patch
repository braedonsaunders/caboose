+// A completion marker: an empty batch submitted to a queue after the guest's work, whose
+// fence signals once everything submitted to that queue before it has completed. The
+// lease keeps the instance and device alive until the fence has been waited for and
+// destroyed; destroy the fence with vk before releasing the marker.
+struct CabooseCompletionMarker {
+    caboose::gpuv2::PresentationLease lease;
+    VkDevice device = VK_NULL_HANDLE;
+    VkFence fence = VK_NULL_HANDLE;
+    VulkanDispatch* vk = nullptr;
+    CabooseCompletionMarker() = default;
+    CabooseCompletionMarker(const CabooseCompletionMarker&) = delete;
+    CabooseCompletionMarker& operator=(const CabooseCompletionMarker&) = delete;
+    // A marker never waited for still completes before its lease releases the device.
+    ~CabooseCompletionMarker() {
+        if (fence && vk) {
+            vk->vkWaitForFences(device, 1, &fence, VK_TRUE, UINT64_MAX);
+            vk->vkDestroyFence(device, fence, nullptr);
+        }
+    }
+};
