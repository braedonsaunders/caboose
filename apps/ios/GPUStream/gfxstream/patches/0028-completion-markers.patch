+    VkResult submitCabooseCompletionMarker(uint32_t contextId, VkQueue boxedQueue,
+        std::unique_ptr<CabooseCompletionMarker>* out) {
+        if (!out) return VK_ERROR_INITIALIZATION_FAILED;
+        out->reset();
+        if (!contextId || !boxedQueue) return VK_ERROR_INITIALIZATION_FAILED;
+        auto marker = std::make_unique<CabooseCompletionMarker>();
+        VkQueue queue = VK_NULL_HANDLE;
+        std::shared_ptr<std::mutex> queueMutex;
+        {
+            std::lock_guard<std::mutex> lock(mMutex);
+            queue = try_unbox_VkQueue(boxedQueue);
+            auto* q = gfxstream::base::find(mQueueInfo, queue);
+            if (!q || q->boxed != boxedQueue || q->usingSharedPhysicalQueue || !q->queueMutex)
+                return VK_ERROR_FEATURE_NOT_PRESENT;
+            auto* dev = gfxstream::base::find(mDeviceInfo, q->device);
+            auto* physical = dev ? gfxstream::base::find(mPhysdevInfo, dev->physicalDevice) : nullptr;
+            auto* inst = physical ? gfxstream::base::find(mInstanceInfo, physical->instance) : nullptr;
+            if (!inst || inst->contextId != contextId) return VK_ERROR_INITIALIZATION_FAILED;
+            if (!marker->lease.acquire(inst->cabooseLifetime) ||
+                !marker->lease.acquire(dev->cabooseLifetime))
+                return VK_ERROR_INITIALIZATION_FAILED;
+            marker->vk = dispatch_VkDevice(dev->boxed);
+            if (!marker->vk) return VK_ERROR_INITIALIZATION_FAILED;
+            marker->device = q->device;
+            queueMutex = q->queueMutex;
+        }
+        VkFenceCreateInfo fenceInfo = {VK_STRUCTURE_TYPE_FENCE_CREATE_INFO, nullptr, 0};
+        VkResult result = marker->vk->vkCreateFence(marker->device, &fenceInfo, nullptr, &marker->fence);
+        if (result != VK_SUCCESS) return result;
+        {
+            auto guestWork = beginCabooseGuestQueueWork(boxedQueue);
+            std::lock_guard<std::mutex> queueLock(*queueMutex);
+            // An empty batch with a fence signals once all work submitted before it completes.
+            result = marker->vk->vkQueueSubmit(queue, 0, nullptr, marker->fence);
+        }
+        if (result != VK_SUCCESS) {
+            marker->vk->vkDestroyFence(marker->device, marker->fence, nullptr);
+            marker->fence = VK_NULL_HANDLE;
+            return result;
+        }
+        *out = std::move(marker);
+        return VK_SUCCESS;
+    }
