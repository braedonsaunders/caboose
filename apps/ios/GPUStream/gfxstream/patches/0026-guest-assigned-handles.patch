+thread_local BoxedHandle tNextGuestHandle = 0;
+thread_local BoxedHandleTypeTag tNextGuestTag = Tag_Invalid;
+}  // namespace
+
+void setNextGuestAssignedHandle(BoxedHandle handle, BoxedHandleTypeTag tag) {
+    tNextGuestHandle = (handle >> 56) == 0xCA ? handle : 0;
+    tNextGuestTag = tag;
