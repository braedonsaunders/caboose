+// Internal surface lifetime: the decoder instance remains alive while leased.
+struct CaboosePresentationInstance {
+    caboose::gpuv2::PresentationLease lease;
+    VkInstance instance = VK_NULL_HANDLE;
+};
+
+// Surface capability queries retain the owning instance and actual physical device.
+struct CaboosePresentationPhysicalDevice {
+    caboose::gpuv2::PresentationLease lease;
+    VkInstance instance = VK_NULL_HANDLE;
+    VkPhysicalDevice physicalDevice = VK_NULL_HANDLE;
+};
+
+// Long-lived surface/swapchain ownership, independent of image frame leases.
+struct CaboosePresentationDevice {
+    caboose::gpuv2::PresentationLease lease;
+    VkInstance instance = VK_NULL_HANDLE;
+    VkPhysicalDevice physicalDevice = VK_NULL_HANDLE;
+    VkDevice device = VK_NULL_HANDLE;
+    VkQueue queue = VK_NULL_HANDLE;
+    uint32_t queueFamily = 0;
+    std::shared_ptr<std::mutex> queueMutex;
+    VulkanDispatch* vk = nullptr;
+};
+
+// Internal validated native handles; lease must outlive all GPU references.
+struct CaboosePresentationObjects {
+    caboose::gpuv2::PresentationLease lease;
+    VkInstance instance = VK_NULL_HANDLE;
+    VkPhysicalDevice physicalDevice = VK_NULL_HANDLE;
+    VkDevice device = VK_NULL_HANDLE;
+    VkQueue queue = VK_NULL_HANDLE;
+    VkImage image = VK_NULL_HANDLE;
+    VkDeviceMemory memory = VK_NULL_HANDLE;
+    uint32_t queueFamily = 0;
+    VkFormat format = VK_FORMAT_UNDEFINED;
+    VkExtent3D extent{};
+    std::shared_ptr<std::mutex> queueMutex;
+    std::vector<VkSemaphore> waitSemaphores;
+    VulkanDispatch* vk = nullptr;
+};
