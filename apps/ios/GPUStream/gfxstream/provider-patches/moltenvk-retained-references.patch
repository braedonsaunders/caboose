+void MVKQueue::cabooseEncoded(uint64_t nanoseconds) {
+	std::lock_guard<std::mutex> lock(_cabooseOrderLock);
+	_cabooseEncodeNs += nanoseconds;
+}
+
+uint64_t MVKQueue::cabooseCommitted(id<MTLCommandBuffer> mtlCmdBuff) {
+	std::lock_guard<std::mutex> lock(_cabooseOrderLock);
+	uint64_t sequence = ++_cabooseSequence;
+	if (_caboosePending.size() < 4096) { _caboosePending.emplace_back(sequence, [mtlCmdBuff retain]); }
+	return sequence;
+}
+
+// Completion handlers can run late, so an earlier command buffer counts as unfinished only
+// when Metal's own status says so at the moment this one has completed.
+void MVKQueue::cabooseCompleted(uint64_t sequence, id<MTLCommandBuffer> mtlCmdBuff) {
+	std::lock_guard<std::mutex> lock(_cabooseOrderLock);
+	size_t unfinished = 0;
+	uint64_t oldest = 0;
+	for (auto it = _caboosePending.begin(); it != _caboosePending.end(); ) {
+		if (it->first == sequence) { [it->second release]; it = _caboosePending.erase(it); continue; }
+		if (it->first < sequence && it->second.status < MTLCommandBufferStatusCompleted) {
+			if (!unfinished) { oldest = it->first; }
+			++unfinished;
+		}
+		++it;
+	}
+	const double start = mtlCmdBuff.GPUStartTime, end = mtlCmdBuff.GPUEndTime;
+	if (end > start && start > 0) {
+		if (start >= _cabooseGpuLastEnd) { _cabooseGpuBusy += end - start; }
+		else if (end > _cabooseGpuLastEnd) { _cabooseGpuBusy += end - _cabooseGpuLastEnd; }
+		if (end > _cabooseGpuLastEnd) { _cabooseGpuLastEnd = end; }
+	}
+	++_cabooseCompleted;
+	const uint64_t now = (uint64_t)std::chrono::duration_cast<std::chrono::nanoseconds>(
+		std::chrono::steady_clock::now().time_since_epoch()).count();
+	if (!_caboosePeriodStartNs) { _caboosePeriodStartNs = now; }
+	if (now - _caboosePeriodStartNs >= 1000000000ull) {
+		fprintf(stderr, "CABOOSE_MVK_QUEUE_PERIOD queue=%s ms=%.0f gpu_busy_ms=%.1f encode_ms=%.1f command_buffers=%u\n",
+		        _name.c_str(), (now - _caboosePeriodStartNs) / 1e6, _cabooseGpuBusy * 1e3, _cabooseEncodeNs / 1e6, _cabooseCompleted);
+		_caboosePeriodStartNs = now; _cabooseGpuBusy = 0; _cabooseEncodeNs = 0; _cabooseCompleted = 0;
+	}
+	if (unfinished && _cabooseOrderReports < 64) {
+		++_cabooseOrderReports;
+		fprintf(stderr, "CABOOSE_MVK_COMPLETION_ORDER queue=%s sequence=%llu unfinished_earlier=%zu oldest=%llu label=%s\n",
+		        _name.c_str(), (unsigned long long)sequence, unfinished, (unsigned long long)oldest,
+		        mtlCmdBuff.label.UTF8String ?: "");
+	}
+}
