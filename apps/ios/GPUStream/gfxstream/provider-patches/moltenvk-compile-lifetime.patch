+
+// A further submission for this compile begins (from a completion, so the lock is not held).
+void MVKMetalCompiler::cabooseSubmitting() {
+	lock_guard<mutex> lock(_completionLock);
+	_cabooseSubmitting++;
+}
+
+// A submission has returned: deletes this compiler if it was destroyed and its compile is done.
+void MVKMetalCompiler::cabooseSubmitted() {
+	bool remove;
+	{
+		lock_guard<mutex> lock(_completionLock);
+		_cabooseSubmitting--;
+		remove = _isDestroyed && _isCompileDone && !_cabooseSubmitting;
+	}
+	if (remove) { MVKBaseObject::destroy(); }
 }
 
