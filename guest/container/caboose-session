#!/bin/bash
set -euo pipefail
# The session runs as root; everything it starts for the owner runs as caboose with this
# home. Root's own commands keep root's HOME, so nothing root writes lands in the owner's.
CABOOSE_HOME=/home/caboose
TOKEN=/run/caboose/display-token
# Accessibility trees for a11y.py: Chromium and Electron, Firefox, Qt.
export ACCESSIBILITY_ENABLED=1 GNOME_ACCESSIBILITY=1 QT_LINUX_ACCESSIBILITY_ALWAYS_ON=1
case ${CABOOSE_GPU:-none} in
  wsl) export GALLIUM_DRIVER=d3d12; unset MESA_D3D12_DEFAULT_ADAPTER_NAME ;;
  nvidia|dri|none) unset GALLIUM_DRIVER MESA_D3D12_DEFAULT_ADAPTER_NAME LIBVA_DRIVER_NAME ;;
  *) echo "Unsupported CABOOSE_GPU: ${CABOOSE_GPU}" >&2; exit 2 ;;
esac
export XDG_RUNTIME_DIR=/run/user/1000
install -d -o caboose -g caboose -m 0700 "$XDG_RUNTIME_DIR"
install -d -m 0755 /run/dbus
# /run survives a container stop. Only a failed connection with a known stale-socket
# error permits removing the socket; a live pid or any other failure stops recovery.
if python3 - <<'SYSTEM_BUS'
import errno, os, pathlib, socket, stat
path = pathlib.Path('/run/dbus/system_bus_socket')
with socket.socket(socket.AF_UNIX) as connection:
    connection.settimeout(2)
    try:
        connection.connect(str(path))
    except OSError as error:
        if error.errno not in (errno.ENOENT, errno.ECONNREFUSED):
            raise SystemExit(2)
    else:
        raise SystemExit(0)
pidfile = pathlib.Path('/run/dbus/pid')
if pidfile.exists():
    value = pidfile.read_text().strip()
    if not value.isdecimal() or int(value) <= 1:
        raise SystemExit(2)
    try:
        os.kill(int(value), 0)
    except ProcessLookupError:
        pass
    else:
        raise SystemExit(2)
try:
    if not stat.S_ISSOCK(path.lstat().st_mode):
        raise SystemExit(2)
    path.unlink()
except FileNotFoundError:
    pass
pidfile.unlink(missing_ok=True)
raise SystemExit(1)
SYSTEM_BUS
then :; else
  status=$?
  [ "$status" = 1 ] || { echo 'System bus recovery requires operator attention' >&2; exit "$status"; }
  dbus-daemon --system --fork
fi
install -d -o caboose -g caboose -m 0700 "$CABOOSE_HOME/.cache"

# Each seat has its own session bus, so the agents' notifications never reach the owner.
session_bus() {
  local bus=$1
  # /run survives a container stop. A socket file alone does not prove its daemon lives.
  if runuser -u caboose -- python3 - "$bus" <<'PY'
import errno, socket, sys
with socket.socket(socket.AF_UNIX) as connection:
    connection.settimeout(2)
    try:
        connection.connect(sys.argv[1])
    except OSError as error:
        sys.exit(1 if error.errno in (errno.ENOENT, errno.ECONNREFUSED) else 2)
PY
  then
    if [ "$bus" = "$XDG_RUNTIME_DIR/agent-bus" ]; then
      runuser -u caboose -- python3 /opt/caboose/keyring/secret-forwarder.py --check-bus
    fi
    return
  else
    local status=$?
    [ "$status" = 1 ] || return "$status"
  fi
  rm -f -- "$bus"
  if [ "$bus" = "$XDG_RUNTIME_DIR/agent-bus" ]; then
    runuser -u caboose -- python3 /opt/caboose/agent-profile.py exec dbus-daemon --config-file=/opt/caboose/keyring/agent-bus.conf --fork
  else
    runuser -u caboose -- dbus-daemon --session --address="unix:path=$bus" --fork
  fi
}

# Starts the seat's accessibility bus before any app, so every app on its Xwayland joins that
# bus (see guest/desktop-mcp/README.md). Safe to repeat; an app still runs without it.
a11y_bus() {
  local envfile=$1 bus=$2
  runuser -u caboose -- env HOME="$CABOOSE_HOME" DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" /bin/sh -c 'set -a; . "$0"; exec python3 /opt/caboose/a11y.py bus --display "$DISPLAY" --wait 30' "$envfile" >/dev/null ||
    echo "No accessibility bus for the display in $envfile" >&2
}

# Publish only the seat's display variables, after display readiness. Portal processes
# can start before the bridge's file watcher has observed the new display environment.
activation_environment() {
  local envfile=$1 bus=$2
  runuser -u caboose -- env HOME="$CABOOSE_HOME" DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" \
    timeout 5 /bin/sh -c 'set -a; . "$0"; exec dbus-update-activation-environment DISPLAY WAYLAND_DISPLAY XDG_RUNTIME_DIR' "$envfile"
}

seat_ready() {
  local port=$1 envfile=$2 bus=$3
  caboose-display-ready 120 "$port" || return
  activation_environment "$envfile" "$bus" || return
  a11y_bus "$envfile" "$bus"
}

# A caboose-display instance (docs/display.md). Its launch environment goes to ENVFILE once
# it is ready, and video passthrough uses VIDEO_SOCKET; extra arguments select the instance
# (port, sockets, X display).
start_display() {
  local name=$1 port=$2 bus=$3 envfile=$4 video_socket=$5; shift 5
  if caboose-display-probe --check --url "ws://127.0.0.1:$port/" --token-file "$TOKEN" >/dev/null 2>&1; then return; fi
  install -d -m 0755 /run/caboose
  install -o caboose -g caboose -m 0644 /dev/null "$envfile"
  local wrapper=()
  if [ "$port" = 14601 ]; then wrapper=(python3 /opt/caboose/agent-profile.py exec); fi
  local libs=
  if [ "${CABOOSE_GPU:-none}" = wsl ]; then libs=/usr/lib/wsl/lib; fi
  local log="$CABOOSE_HOME/.cache/$name.log"
  # The redirect below is opened by this root shell, so the log must already be caboose's.
  touch "$log" && chown caboose:caboose "$log"
  runuser -u caboose -- env HOME="$CABOOSE_HOME" XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" LD_LIBRARY_PATH="$libs" CABOOSE_VIDEO_SOCKET="$video_socket" \
    "${wrapper[@]}" setsid caboose-display --env-file "$envfile" "$@" >>"$log" 2>&1 < /dev/null &
}

notification_endpoint() {
  local name=$1 bus=$2
  [ -f "$3" ] || return 0
  local pidfile="$XDG_RUNTIME_DIR/$name.pid" log="$CABOOSE_HOME/.cache/$name.log"
  if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then return; fi
  touch "$log" && chown caboose:caboose "$log"
  runuser -u caboose -- env HOME="$CABOOSE_HOME" XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" \
    /bin/sh -c 'echo $$ > "$0"; exec python3 "$1"' "$pidfile" "$3" >>"$log" 2>&1 < /dev/null &
}

# The native bridge (guest/bridge): Now Playing, the phone's appearance and the seat's
# activation environment for the portals.
bridge_daemon() {
  local bus=$1 pidfile="$XDG_RUNTIME_DIR/caboose-bridge.pid" log="$CABOOSE_HOME/.cache/caboose-bridge.log"
  [ -f /opt/caboose/bridge/caboose-bridge ] || return 0
  if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then return; fi
  touch "$log" && chown caboose:caboose "$log"
  runuser -u caboose -- env HOME="$CABOOSE_HOME" XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" \
    /bin/sh -c 'echo $$ > "$0"; exec python3 /opt/caboose/bridge/caboose-bridge daemon' "$pidfile" >>"$log" 2>&1 < /dev/null &
}

start_owner() {
  local bus="$XDG_RUNTIME_DIR/bus"
  session_bus "$bus"
  # The monitor records the owner's notifications; the endpoint owns the D-Bus name.
  notification_endpoint caboose-notifications "$bus" /opt/caboose/notifications/monitor.py
  notification_endpoint caboose-notification-daemon "$bus" /opt/caboose/notifications/daemon.py
  # The VA-API passthrough driver exports decode surfaces through /dev/udmabuf (passed in
  # on hosts with a render node); this container's node is the session user's to use.
  if [ -e /dev/udmabuf ]; then chgrp caboose /dev/udmabuf && chmod 0660 /dev/udmabuf; fi
  # The phone-GPU driver tracks stores to mapped memory through /dev/userfaultfd (passed
  # in when the host has it); this container's node is the session user's to use.
  if [ -e /dev/userfaultfd ]; then chgrp caboose /dev/userfaultfd && chmod 0660 /dev/userfaultfd; fi
  # The vgem nodes are the computer's render node (docs/gpu-buffers.md), passed in when
  # the host has them: the session user's to allocate shared buffers on.
  for node in /dev/dri/card* /dev/dri/renderD*; do
    [ -e "$node" ] || continue
    [ "$(basename "$(readlink -f "/sys/class/drm/${node##*/}/device/driver")")" = vgem ] || continue
    chgrp caboose "$node" && chmod 0660 "$node"
  done
  start_display caboose-display 14600 "$bus" /run/caboose/display.env "$XDG_RUNTIME_DIR/caboose-video.sock"
  bridge_daemon "$bus"
}

start_agent() {
  local bus="$XDG_RUNTIME_DIR/agent-bus"
  session_bus "$bus"
  notification_endpoint caboose-agent-notification-daemon "$bus" /opt/caboose/notifications/daemon.py
  # Agents see and drive its apps through its control socket; it plays no sound.
  start_display caboose-display-agent 14601 "$bus" /run/caboose/agent-display.env "$XDG_RUNTIME_DIR/caboose-video-agent.sock" \
    --listen 0.0.0.0:14601 --socket wayland-caboose-agent --x-display 101 --no-audio --no-games --no-devices
}

start_printing() {
  [ -x /usr/local/libexec/caboose-phone-printer-setup ] && command -v lpstat >/dev/null && [ -x /usr/sbin/cupsd ] || return 0
  if ! lpstat -r 2>/dev/null | grep -q 'scheduler is running'; then /usr/sbin/cupsd; fi
  /usr/local/libexec/caboose-phone-printer-setup
}

case ${1:-} in
  start) start_printing || echo "Printing unavailable" >&2; start_owner ;;
  ready) seat_ready 14600 /run/caboose/display.env "$XDG_RUNTIME_DIR/bus" ;;
  start-agent) start_agent; seat_ready 14601 /run/caboose/agent-display.env "$XDG_RUNTIME_DIR/agent-bus" ;;
  start-files)
    start-stop-daemon --start --oknodo --background --make-pidfile --pidfile /run/caboose/files.pid \
      --chuid caboose:caboose --exec /usr/bin/python3 -- /opt/caboose/files/caboose-files.py
    # Listening on 14700 (0x396C, state 0A), read from /proc: the image has no iproute2 for ss.
    for _ in $(seq 1 60); do grep -Eq '^ *[0-9]+: [0-9A-F]+:396C [0-9A-F]+:[0-9A-F]+ 0A ' /proc/net/tcp /proc/net/tcp6 2>/dev/null && exit 0; sleep 1; done
    echo 'File service did not become ready' >&2; exit 1
    ;;
  *) echo 'Usage: caboose-session start | ready | start-agent | start-files' >&2; exit 2 ;;
esac
