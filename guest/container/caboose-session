#!/bin/bash
set -euo pipefail
# The session runs as root; everything it starts for the owner runs as caboose with this
# home. Root's own commands keep root's HOME, so nothing root writes lands in the owner's.
CABOOSE_HOME=/home/caboose
# Accessibility trees for a11y.py: Chromium and Electron, Firefox, Qt.
export ACCESSIBILITY_ENABLED=1 GNOME_ACCESSIBILITY=1 QT_LINUX_ACCESSIBILITY_ALWAYS_ON=1
case ${CABOOSE_GPU:-none} in
  wsl)
    export GALLIUM_DRIVER=d3d12 XPRA_PYCUDA_WSL=1
    unset MESA_D3D12_DEFAULT_ADAPTER_NAME
    if [ -x /usr/lib/wsl/lib/nvidia-smi ] && /usr/lib/wsl/lib/nvidia-smi --query-gpu=name --format=csv,noheader >/dev/null 2>&1; then
      export XPRA_NVIDIA_HARDWARE=1 XPRA_NVENC_PRESET=P1 XPRA_NVENC_TUNING=low-latency
    else
      unset XPRA_NVIDIA_HARDWARE XPRA_NVENC_PRESET XPRA_NVENC_TUNING
    fi ;;
  nvidia)
    unset GALLIUM_DRIVER MESA_D3D12_DEFAULT_ADAPTER_NAME XPRA_PYCUDA_WSL XPRA_NVIDIA_HARDWARE LIBVA_DRIVER_NAME
    export XPRA_NVENC_PRESET=P1 XPRA_NVENC_TUNING=low-latency ;;
  dri|none)
    unset GALLIUM_DRIVER MESA_D3D12_DEFAULT_ADAPTER_NAME XPRA_PYCUDA_WSL XPRA_NVIDIA_HARDWARE XPRA_NVENC_PRESET XPRA_NVENC_TUNING LIBVA_DRIVER_NAME ;;
  *) echo "Unsupported CABOOSE_GPU: ${CABOOSE_GPU}" >&2; exit 2 ;;
esac
export XDG_RUNTIME_DIR=/run/user/1000
install -d -o caboose -g caboose -m 0700 "$XDG_RUNTIME_DIR"
install -d -m 0755 /run/dbus
if [ ! -S /run/dbus/system_bus_socket ]; then dbus-daemon --system --fork; fi
if [ ! -S "$XDG_RUNTIME_DIR/bus" ]; then
  runuser -u caboose -- dbus-daemon --session --address="unix:path=$XDG_RUNTIME_DIR/bus" --fork
fi
# One monitor per session bus; it does not own the notification service.
start_notifications() {
  local pidfile="$XDG_RUNTIME_DIR/caboose-notifications.pid"
  if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then return; fi
  runuser -u caboose -- env HOME="$CABOOSE_HOME" XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus" \
    /bin/sh -c 'echo $$ > "$XDG_RUNTIME_DIR/caboose-notifications.pid"; exec python3 /opt/caboose/notifications/monitor.py' \
    >>"$CABOOSE_HOME/.cache/caboose-notifications.log" 2>&1 < /dev/null &
}
install -d -o caboose -g caboose -m 0700 "$CABOOSE_HOME/.cache"
start_notifications
# Start the display's accessibility bus before any app, so every app on it joins that bus
# (see guest/desktop-mcp/README.md). Safe to repeat; an app still runs without it.
a11y_bus() {
  runuser -u caboose -- env HOME="$CABOOSE_HOME" DISPLAY="$1" python3 /opt/caboose/a11y.py bus --display "$1" --wait 30 >/dev/null ||
    echo "No accessibility bus for $1" >&2
}
start_display() {
  local display=$1 port=$2 speaker=$3
  if runuser -u caboose -- env DISPLAY="$display" xpra info "$display" >/dev/null 2>&1; then a11y_bus "$display"; return; fi
  # Each seat has its own session bus, so agent notifications never reach the owner.
  local bus="$XDG_RUNTIME_DIR/bus"
  if [ "$display" = :101 ]; then
    bus="$XDG_RUNTIME_DIR/agent-bus"
    if [ ! -S "$bus" ]; then runuser -u caboose -- dbus-daemon --session --address="unix:path=$bus" --fork; fi
  fi
  # Xpra's packaged config switches GTK's accessibility bridge off for the apps it starts.
  runuser -u caboose -- env HOME="$CABOOSE_HOME" XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" \
    xpra seamless "$display" --daemon=yes --bind-ws="0.0.0.0:$port" \
    --ws-auth=file:filename=/run/caboose/xpra-token --html=off --clipboard=on \
    --dbus-launch=no --notifications=on --file-transfer=on --mdns=off --printing=off --webcam=off \
    --speaker="$speaker" --microphone=off --env=NO_AT_BRIDGE=0 --start-env=GTK_A11Y=atspi
  a11y_bus "$display"
}
ready() {
  local display=$1
  for _ in $(seq 1 120); do
    if runuser -u caboose -- env DISPLAY="$display" XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" xpra info "$display" >/dev/null 2>&1; then return; fi
    sleep 1
  done
  echo "Xpra $display did not become ready" >&2; return 1
}
# Caboose Display (docs/display.md): the owner seat as a Wayland compositor with
# Xwayland, streaming each window on WebSocket port 14600. Launchers read the
# application environment from /run/caboose/display.env once it is ready.
start_caboose_display() {
  if caboose-display-probe --check --token-file /run/caboose/xpra-token >/dev/null 2>&1; then return; fi
  # Caboose Display does not provide Xpra's notification D-Bus service.
  local notification_pid="$XDG_RUNTIME_DIR/caboose-notification-daemon.pid"
  if ! [ -f "$notification_pid" ] || ! kill -0 "$(cat "$notification_pid")" 2>/dev/null; then
    runuser -u caboose -- env HOME="$CABOOSE_HOME" XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus" \
      /bin/sh -c 'echo $$ > "$XDG_RUNTIME_DIR/caboose-notification-daemon.pid"; exec python3 /opt/caboose/notifications/daemon.py' \
      >>"$CABOOSE_HOME/.cache/caboose-notification-daemon.log" 2>&1 < /dev/null &
  fi
  # The VA-API passthrough driver exports decode surfaces through /dev/udmabuf (passed in
  # on hosts with a render node); this container's node is the session user's to use.
  if [ -e /dev/udmabuf ]; then chgrp caboose /dev/udmabuf && chmod 0660 /dev/udmabuf; fi
  install -d -m 0755 /run/caboose
  install -o caboose -g caboose -m 0644 /dev/null /run/caboose/display.env
  local log=$CABOOSE_HOME/.cache/caboose-display.log
  runuser -u caboose -- install -d -m 0700 "$CABOOSE_HOME/.cache"
  # The redirect below is opened by this root shell, so the log must already be caboose's.
  touch "$log" && chown caboose:caboose "$log"
  local libs=
  if [ "${CABOOSE_GPU:-none}" = wsl ]; then libs=/usr/lib/wsl/lib; fi
  runuser -u caboose -- env HOME="$CABOOSE_HOME" XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus" LD_LIBRARY_PATH="$libs" \
    setsid caboose-display --env-file /run/caboose/display.env >>"$log" 2>&1 < /dev/null &
}
case ${1:-} in
  start) start_display :100 14500 on ;;
  start-agent) start_display :101 14501 off; ready :101 ;;
  ready) ready "${2:?display required}" ;;
  start-display) start_caboose_display ;;
  ready-display) caboose-display-ready 120 ;;
  *) echo 'Usage: caboose-session start | start-agent | ready DISPLAY | start-display | ready-display' >&2; exit 2 ;;
esac
