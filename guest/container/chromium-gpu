# On a seat that renders on the phone's GPU (its display names the broker's socket;
# docs/gpu-live.md, "Applications"), Chromium renders with ANGLE on Vulkan as an X11
# client through Xwayland, whose windows the phone's driver presents. Without a phone
# Vulkan is the computer's CPU renderer, and the GPU process restarts onto the phone
# when one attaches (guest/gpu/executor-switch), as often as it comes and goes. The GPU
# process runs outside Chromium's GPU sandbox, which does not let it reach the socket.
# The computer's render node is vgem (docs/gpu-buffers.md), which Chromium passes over
# when it looks for one.
render_node=
for node in /dev/dri/renderD*; do
  [ -e "$node" ] || continue
  [ "$(basename "$(readlink -f "/sys/class/drm/${node##*/}/device")")" = vgem ] || continue
  render_node=$node
  break
done
if [ -n "${CABOOSE_GFXSTREAM_SOCKET:-}" ] && [ -n "${DISPLAY:-}" ]; then
  features=Vulkan,VulkanFromANGLE,DefaultANGLEVulkan
  # Video decodes through the Caboose VA-API driver on the phone, which fills the frames
  # Chromium samples (docs/gpu-media.md); Xwayland's DRI3 gives it the GBM device for them
  # (guest/xwayland).
  if [ "${LIBVA_DRIVER_NAME:-}" = caboose ] && [ -n "$render_node" ]; then
    features="$features,VaapiVideoDecoder,VaapiIgnoreDriverChecks,VaapiVideoDecodeLinuxGL,AcceleratedVideoDecodeLinuxGL,AcceleratedVideoDecodeLinuxZeroCopyGL"
    CHROMIUM_FLAGS="$CHROMIUM_FLAGS --hardware-video-device-path=$render_node"
  fi
  CHROMIUM_FLAGS="$CHROMIUM_FLAGS --ozone-platform=x11 --ignore-gpu-blocklist --use-gl=angle --use-angle=vulkan --enable-features=$features --disable-gpu-sandbox --disable-gpu-process-crash-limit"
else
  # Under Caboose Display, Chromium is a native Wayland client (no X11 round trips).
  if [ -n "${WAYLAND_DISPLAY:-}" ]; then
    CHROMIUM_FLAGS="$CHROMIUM_FLAGS --ozone-platform=wayland"
  fi
  # Name the render node, so Chromium's Wayland GPU path allocates shared buffers there.
  if [ -n "$render_node" ]; then
    CHROMIUM_FLAGS="$CHROMIUM_FLAGS --render-node-override=$render_node"
  fi
  # Mesa D3D12 is available to WSL containers through /dev/dxg.
  if [ "${CABOOSE_GPU:-none}" = wsl ]; then
    export GALLIUM_DRIVER=d3d12
    if [ -n "${WAYLAND_DISPLAY:-}" ]; then
      # Chromium's Wayland GPU path needs a DRM render node, which WSL does not have: its
      # GPU process fails over and presents fewer frames than software raster (measured
      # on an RTX 4080: 41 against 52 fps for 1080p video).
      CHROMIUM_FLAGS="$CHROMIUM_FLAGS --disable-gpu"
    else
      CHROMIUM_FLAGS="$CHROMIUM_FLAGS --ignore-gpu-blocklist --use-gl=angle --use-angle=gl"
    fi
  fi
  # With the Caboose VA-API driver (set only in Caboose Display sessions, on hosts with a
  # render node), Chromium decodes video through it, so video reaches the phone as its own
  # stream (guest/vaapi).
  if [ -n "${WAYLAND_DISPLAY:-}" ] && [ "${LIBVA_DRIVER_NAME:-}" = caboose ]; then
    CHROMIUM_FLAGS="$CHROMIUM_FLAGS --ignore-gpu-blocklist --enable-features=VaapiVideoDecoder,VaapiVideoDecodeLinuxGL,AcceleratedVideoDecodeLinuxGL,AcceleratedVideoDecodeLinuxZeroCopyGL,VaapiIgnoreDriverChecks"
  fi
fi
