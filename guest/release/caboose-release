#!/usr/bin/python3 -I
"""One release of the computer's GPU and display stack, on every computer (README.md).

usage: caboose-release new ID [--from ID]          start a release, a copy of another
       caboose-release add ID SOURCE PATH [MODE]   a file installed at PATH (octal MODE)
       caboose-release capture ID COMPUTER PATH... files as COMPUTER has them now
       caboose-release deb ID DEB                  a package installed with dpkg
       caboose-release remove ID PATH              a path deleted on install
       caboose-release seal ID NOTE...             check the driver, write the SBOM and MANIFEST, sign; final
       caboose-release sign ID                     sign a sealed release's MANIFEST again
       caboose-release install ID [--wait S] [COMPUTER...]   every running computer by default
       caboose-release status                      what each running computer runs
       caboose-release list                        the releases

Run as root on the host. Releases live in $CABOOSE_RELEASES (default /root/caboose-release).
The signing key is $CABOOSE_RELEASE_KEY (default /root/.config/caboose-release/release-ed25519.key.pem);
installs verify with $CABOOSE_RELEASE_PUB (default caboose-release.pub.pem beside this program,
then /usr/local/share/caboose-release/caboose-release.pub.pem). Sealing runs the Linux
executor check configured in $CABOOSE_RELEASE_CHECK (default /root/.config/caboose-release/check.conf)."""
import base64
import datetime
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import time

ROOT = Path(os.environ.get("CABOOSE_RELEASES", "/root/caboose-release"))
# A game is running when any of these match a process (the game gate).
GAME = "MCC-Win64|steam_app_[0-9]|AppId=[0-9]"
MARKER = "/etc/caboose-release"
STEAM = "/home/caboose/.var/app/com.valvesoftware.Steam/.local/share/Steam"
KEY = Path(os.environ.get("CABOOSE_RELEASE_KEY", "/root/.config/caboose-release/release-ed25519.key.pem"))
PUBLIC_NAME = "caboose-release.pub.pem"
# Written by seal, outside the MANIFEST it signs.
UNLISTED = ("MANIFEST", "MANIFEST.sig")
CHECK_CONF = Path(os.environ.get("CABOOSE_RELEASE_CHECK", "/root/.config/caboose-release/check.conf"))
# The release's 64-bit guest driver, which the check runs.
DRIVER = "usr/local/lib/caboose-gpu-live/libvulkan_gfxstream.so"
CHECK_SCRIPT = "apps/ios/GPUStream/gfxstream/linux-executor/check.sh"
CHECK_KEYS = ("repo", "image", "work", "sync_check", "capability_probe", "dxvk_computer", "dxvk_bench", "chaos_home")


class Failure(Exception):
    pass


def release(id_):
    if not id_ or "/" in id_ or id_.startswith("."):
        raise Failure(f"not a release id: {id_!r}")
    return ROOT / id_


def manifest_lines(directory):
    """`sha256  mode  relative path` for every file of a release, sorted: files/, debs/,
    remove, notes and sbom.spdx.json."""
    lines = []
    for path in sorted(p for p in directory.rglob("*") if p.is_file() and str(p.relative_to(directory)) not in UNLISTED):
        digest = hashlib.sha256(path.read_bytes()).hexdigest()
        mode = path.stat().st_mode & 0o7777 if path.parts[len(directory.parts)] == "files" else 0
        lines.append(f"{digest}  {mode:04o}  {path.relative_to(directory)}")
    return lines


def sealed(directory):
    return (directory / "MANIFEST").is_file()


def verify(directory):
    if not sealed(directory):
        raise Failure(f"{directory.name} is not sealed")
    if (directory / "MANIFEST").read_text().splitlines() != manifest_lines(directory):
        raise Failure(f"{directory.name} does not match its MANIFEST")


def openssl(*args):
    result = subprocess.run(["openssl", *args], capture_output=True)
    if result.returncode:
        raise Failure(f"openssl {args[0]}: {result.stderr.decode(errors='replace').strip()}")
    return result.stdout


def public_key():
    named = os.environ.get("CABOOSE_RELEASE_PUB")
    candidates = [Path(named)] if named else [Path(__file__).resolve().parent / PUBLIC_NAME,
                                              Path("/usr/local/share/caboose-release") / PUBLIC_NAME]
    for path in candidates:
        if path.is_file():
            return path
    raise Failure(f"no release public key ({', '.join(map(str, candidates))})")


def sign(directory, key=None):
    """MANIFEST.sig: base64 of the Ed25519 signature over MANIFEST's exact bytes, kept only
    once the public key verifies it."""
    key = key or KEY
    if not key.is_file():
        raise Failure(f"no signing key at {key}")
    signature = openssl("pkeyutl", "-sign", "-rawin", "-inkey", str(key), "-in", str(directory / "MANIFEST"))
    check_signature(directory, signature)
    (directory / "MANIFEST.sig").write_text(base64.b64encode(signature).decode() + "\n")


def check_signature(directory, signature):
    with tempfile.NamedTemporaryFile() as sigfile:
        sigfile.write(signature)
        sigfile.flush()
        result = subprocess.run(["openssl", "pkeyutl", "-verify", "-pubin", "-inkey", str(public_key()), "-rawin",
                                 "-in", str(directory / "MANIFEST"), "-sigfile", sigfile.name], capture_output=True)
    if result.returncode:
        raise Failure(f"{directory.name}: not the release key's signature over its MANIFEST")


def verify_signature(directory):
    """Raises unless MANIFEST.sig is the release key's signature over MANIFEST."""
    try:
        signature = base64.b64decode((directory / "MANIFEST.sig").read_text().strip(), validate=True)
    except (OSError, ValueError):
        raise Failure(f"{directory.name} is not signed")
    check_signature(directory, signature)


def check_settings(path=None):
    """The check's settings, `key=value` lines: repo (a checkout whose broker and check
    script run), image (the computer image), work (the Linux executor's build directory)
    and sync_check (the synchronization probe binary)."""
    path = path or CHECK_CONF
    try:
        text = path.read_text()
    except OSError:
        raise Failure(f"no executor check settings at {path} ({', '.join(CHECK_KEYS)})")
    settings = {}
    for line in text.splitlines():
        key, sep, value = line.partition("=")
        if sep and not line.lstrip().startswith("#"):
            settings[key.strip()] = value.strip()
    missing = [k for k in CHECK_KEYS if not settings.get(k)]
    if missing:
        raise Failure(f"{path} lacks {', '.join(missing)}")
    return settings


def run_check(directory, settings):
    """Runs the Linux executor check (the synchronization probe, then vkcube's frames)
    against the release's driver; its logs go to check/ in the release. The exit status and
    the check's summary lines."""
    driver = directory / "files" / DRIVER
    if not driver.is_file():
        raise Failure(f"{directory.name} has no driver at /{DRIVER}")
    out = directory / "check"
    shutil.rmtree(out, ignore_errors=True)
    out.mkdir()
    result = subprocess.run(["sh", str(Path(settings["repo"]) / CHECK_SCRIPT), settings["image"], settings["work"],
                             str(driver), settings["sync_check"], str(out)],
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    summary = result.stdout.decode(errors="replace")
    if result.returncode:
        return result.returncode, summary
    packaged = subprocess.run(["sh", str(Path(settings["repo"]) / "guest/release/check-packaged.sh"),
                               settings["image"], str(directory), str(out)],
                              stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    summary += packaged.stdout.decode(errors="replace")
    if packaged.returncode:
        return packaged.returncode, summary
    capabilities = subprocess.run([
        "sh", str(Path(settings["repo"]) / "apps/ios/GPUStream/gfxstream/linux-executor/check-capabilities.sh"),
        settings["image"], settings["work"], str(driver), settings["capability_probe"],
        str(out / "capabilities"), str(directory)], stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    summary += capabilities.stdout.decode(errors="replace")
    if capabilities.returncode:
        return capabilities.returncode, summary
    # DXVK must find an adapter and present on the executor with the release's driver under
    # each negotiation a phone makes: a device that lacks a feature DXVK requires fails here.
    dxvk = subprocess.run([
        "sh", str(Path(settings["repo"]) / "apps/ios/GPUStream/gfxstream/linux-executor/check-dxvk.sh"),
        settings["dxvk_computer"], settings["work"], str(driver), settings["dxvk_bench"], str(out / "dxvk")],
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    summary += dxvk.stdout.decode(errors="replace")
    if dxvk.returncode:
        return dxvk.returncode, summary
    # Chromium must draw real pictures (not noise, not blank) through a seat of the check's own
    # in the same computer, and a fresh Chromium again after the seat's executor was replaced.
    pixels = subprocess.run([
        "sh", str(Path(settings["repo"]) / "apps/ios/GPUStream/gfxstream/linux-executor/check-loss-pixels.sh"),
        settings["dxvk_computer"], settings["work"], str(driver), str(out / "loss-pixels")],
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    summary += pixels.stdout.decode(errors="replace")
    if pixels.returncode:
        return pixels.returncode, summary
    # Fifty random executor losses, replacements, stalls and viewer reconnects through a seat
    # running the release's compositor, broker and driver: every app must present real
    # pictures after each.
    home = settings["chaos_home"]
    chaos = subprocess.run([
        "python3", str(Path(settings["repo"]) / "apps/ios/GPUStream/gfxstream/linux-executor/check_chaos.py"),
        settings["dxvk_computer"], settings["work"], str(directory), str(out / "chaos"), "--cycles", "50",
        "--steam-home", home, "--triangle", f"{home}/.var/app/com.valvesoftware.Steam/caboose-bench/triangle.exe"],
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    summary += "\n".join(line for line in chaos.stdout.decode(errors="replace").splitlines()
                         if not line.startswith("PASS cycle")) + "\n"
    return chaos.returncode, summary


def check(directory, run=None):
    """The executor check of the release's driver; raises, keeping the logs, unless it
    passed. check/result records the summary."""
    status, summary = (run or run_check)(directory, check_settings())
    (directory / "check").mkdir(exist_ok=True)
    (directory / "check" / "result").write_text(f"{'PASS' if status == 0 else 'FAIL'}\n{summary}")
    if status != 0:
        raise Failure(f"the executor check failed; {directory.name} stays open (logs in {directory / 'check'}):\n{summary.strip()}")


def deb_fields(deb):
    """Package, Version and Architecture of a .deb."""
    out = subprocess.run(["dpkg-deb", "-f", str(deb), "Package", "Version", "Architecture"],
                         capture_output=True, check=True).stdout.decode()
    fields = dict(line.split(": ", 1) for line in out.splitlines() if ": " in line)
    return fields.get("Package", deb.stem), fields.get("Version", "NOASSERTION"), fields.get("Architecture", "NOASSERTION")


def spdx_id(text):
    return "SPDXRef-" + "".join(c if c.isalnum() or c in ".-" else "-" for c in text)


def sbom(directory, created=None, fields=deb_fields):
    """An SPDX 2.3 document for the release: the release as a package containing every file
    it installs (with SHA-1 and SHA-256) and every Debian package it installs."""
    files = directory / "files"
    release_id = spdx_id("release-" + directory.name)
    document = {
        "spdxVersion": "SPDX-2.3",
        "dataLicense": "CC0-1.0",
        "SPDXID": "SPDXRef-DOCUMENT",
        "name": f"caboose-stack-{directory.name}",
        "documentNamespace": f"https://github.com/braedonsaunders/caboose/releases/stack/{directory.name}",
        "creationInfo": {"created": created or datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
                         "creators": ["Tool: caboose-release"]},
        "packages": [{"SPDXID": release_id, "name": "caboose-stack", "versionInfo": directory.name,
                      "downloadLocation": "NOASSERTION", "filesAnalyzed": True, "licenseConcluded": "NOASSERTION",
                      "licenseDeclared": "NOASSERTION", "copyrightText": "NOASSERTION",
                      "comment": " ".join(lines_of(directory / "notes")) or "NOASSERTION"}],
        "files": [],
        "relationships": [{"spdxElementId": "SPDXRef-DOCUMENT", "relationshipType": "DESCRIBES", "relatedSpdxElement": release_id}],
    }
    for path in sorted(p for p in files.rglob("*") if p.is_file()) if files.is_dir() else []:
        data = path.read_bytes()
        name = "/" + str(path.relative_to(files))
        ident = spdx_id("file" + name)
        document["files"].append({"SPDXID": ident, "fileName": "." + name,
                                  "checksums": [{"algorithm": "SHA1", "checksumValue": hashlib.sha1(data).hexdigest()},
                                                {"algorithm": "SHA256", "checksumValue": hashlib.sha256(data).hexdigest()}],
                                  "licenseConcluded": "NOASSERTION", "copyrightText": "NOASSERTION"})
        document["relationships"].append({"spdxElementId": release_id, "relationshipType": "CONTAINS", "relatedSpdxElement": ident})
    for deb in sorted((directory / "debs").glob("*.deb")) if (directory / "debs").is_dir() else []:
        package, version, arch = fields(deb)
        ident = spdx_id(f"deb-{package}-{arch}")
        document["packages"].append({"SPDXID": ident, "name": package, "versionInfo": version,
                                     "downloadLocation": "NOASSERTION", "filesAnalyzed": False,
                                     "packageFileName": deb.name,
                                     "checksums": [{"algorithm": "SHA256", "checksumValue": hashlib.sha256(deb.read_bytes()).hexdigest()}],
                                     "externalRefs": [{"referenceCategory": "PACKAGE-MANAGER", "referenceType": "purl",
                                                       "referenceLocator": f"pkg:deb/{package}@{version}?arch={arch}"}],
                                     "licenseConcluded": "NOASSERTION", "licenseDeclared": "NOASSERTION", "copyrightText": "NOASSERTION"})
        document["relationships"].append({"spdxElementId": release_id, "relationshipType": "CONTAINS", "relatedSpdxElement": ident})
    return json.dumps(document, indent=1, sort_keys=True) + "\n"


def writable(id_):
    directory = release(id_)
    if not directory.is_dir():
        raise Failure(f"no release {id_}")
    if sealed(directory):
        raise Failure(f"{id_} is sealed; start a new release with --from {id_}")
    return directory


def placed(directory, path):
    path = Path(path)
    if not path.is_absolute() or ".." in path.parts:
        raise Failure(f"not an absolute path: {path}")
    return directory / "files" / path.relative_to("/")


def lines_of(path):
    return [l for l in path.read_text().splitlines() if l.strip()] if path.is_file() else []


def docker(*args, input_=None, check=True):
    result = subprocess.run(["docker", *args], input=input_, capture_output=True)
    if check and result.returncode:
        raise Failure(f"docker {' '.join(args[:3])}: {result.stderr.decode(errors='replace').strip()}")
    return result


def computers():
    """Running computers' containers (not their network sidecars)."""
    names = docker("ps", "--format", "{{.Names}}").stdout.decode().split()
    return sorted(n for n in names if n.startswith("caboose-c-") and not n.endswith("-net"))


def game_running(container):
    return docker("exec", container, "pgrep", "-f", GAME, check=False).returncode == 0


def steam_running(container):
    return docker("exec", container, "pgrep", "-f", f"{STEAM}/ubuntu12_64/steamwebhelper|{STEAM}/steamrt64", check=False).returncode == 0


def install_one(directory, container, marker):
    """Copies the release in, restarts the owner's display (Steam with it, if it ran) and
    writes the marker. The game gate is checked again just before anything changes."""
    if game_running(container):
        return False
    steam = steam_running(container)
    files = directory / "files"
    if files.is_dir():
        tar = subprocess.run(["tar", "-C", str(files), "-cf", "-", "."], capture_output=True, check=True).stdout
        docker("exec", "-i", container, "tar", "-C", "/", "-xf", "-", "--no-same-owner", input_=tar)
        listed = subprocess.run(["tar", "-tf", "-"], input=tar, capture_output=True, check=True).stdout.decode().split("\n")
        paths = ["/" + p.removeprefix("./") for p in listed if p and not p.endswith("/")]
        docker("exec", container, "chown", "root:root", *paths)
    for path in lines_of(directory / "remove"):
        docker("exec", container, "rm", "-rf", "--", path)
    debs = sorted((directory / "debs").glob("*.deb")) if (directory / "debs").is_dir() else []
    for deb in debs:
        docker("exec", "-i", container, "sh", "-c", "cat > /tmp/caboose-release.deb", input_=deb.read_bytes())
        docker("exec", container, "sh", "-c", "dpkg -i /tmp/caboose-release.deb >/dev/null && rm -f /tmp/caboose-release.deb")
    # Steam ends with its X server; asked first, it quits cleanly.
    if steam:
        docker("exec", "-u", "caboose", container, "sh", "-c",
               "set -a; . /run/caboose/display.env; set +a; timeout 20 flatpak run com.valvesoftware.Steam -shutdown >/dev/null 2>&1", check=False)
    # The display and its supervisor stop together, so the supervisor does not start the
    # old display again while the new session starts its own.
    docker("exec", container, "caboose-session", "stop-display")
    docker("exec", container, "sh", "-c", "caboose-session start >/dev/null && caboose-session ready >/dev/null")
    if steam:
        docker("exec", "-d", "-u", "caboose", container, "sh", "-c",
               "set -a; . /run/caboose/display.env; set +a; exec flatpak run com.valvesoftware.Steam >/tmp/steam-launch.log 2>&1")
    docker("exec", "-i", container, "sh", "-c", f"cat > {MARKER}", input_=marker.encode())
    return True


def marker_text(directory):
    manifest = hashlib.sha256((directory / "MANIFEST").read_bytes()).hexdigest()
    return f"{directory.name}\nmanifest_sha256={manifest}\n" + "".join(f"{l}\n" for l in lines_of(directory / "notes"))


def install(id_, wait, targets):
    directory = release(id_)
    verify(directory)
    verify_signature(directory)
    marker = marker_text(directory)
    pending = list(targets or computers())
    deadline = time.monotonic() + wait
    while pending:
        for container in list(pending):
            if install_one(directory, container, marker):
                print(f"{container}: {id_} installed", flush=True)
                pending.remove(container)
            else:
                print(f"{container}: a game is running; waiting", flush=True)
        if not pending or time.monotonic() >= deadline:
            break
        time.sleep(30)
    for container in pending:
        print(f"{container}: not installed (a game ran throughout)", flush=True)
    return not pending


def status():
    for container in computers():
        first = docker("exec", container, "sh", "-c", f"head -1 {MARKER} 2>/dev/null", check=False).stdout.decode().strip()
        print(f"{container}  {first or 'no release'}{'  (game running)' if game_running(container) else ''}")


def main(argv):
    if not argv:
        raise Failure(__doc__.split("\n\n")[1])
    command, args = argv[0], argv[1:]
    if command == "new" and args:
        directory = release(args[0])
        if directory.exists():
            raise Failure(f"{args[0]} exists")
        if len(args) == 3 and args[1] == "--from":
            base = release(args[2])
            verify(base)
            shutil.copytree(base, directory, symlinks=False)
            for name in ("MANIFEST", "MANIFEST.sig", "notes", "sbom.spdx.json"):
                (directory / name).unlink(missing_ok=True)
            shutil.rmtree(directory / "check", ignore_errors=True)
        elif len(args) == 1:
            directory.mkdir(parents=True)
        else:
            raise Failure("usage: new ID [--from ID]")
    elif command == "add" and len(args) in (3, 4):
        target = placed(writable(args[0]), args[2])
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(args[1], target)
        target.chmod(int(args[3], 8) if len(args) == 4 else 0o644)
    elif command == "capture" and len(args) >= 3:
        directory = writable(args[0])
        for path in args[2:]:
            target = placed(directory, path)
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(docker("exec", args[1], "cat", path).stdout)
            mode = docker("exec", args[1], "stat", "-c", "%a", path).stdout.decode().strip()
            target.chmod(int(mode, 8))
    elif command == "deb" and len(args) == 2:
        debs = writable(args[0]) / "debs"
        debs.mkdir(exist_ok=True)
        shutil.copyfile(args[1], debs / Path(args[1]).name)
    elif command == "remove" and len(args) == 2:
        directory = writable(args[0])
        placed(directory, args[1])  # validates the path
        with (directory / "remove").open("a") as out:
            out.write(args[1] + "\n")
    elif command == "seal" and len(args) >= 2:
        directory = writable(args[0])
        if not KEY.is_file():
            raise Failure(f"no signing key at {KEY}")
        check(directory)
        (directory / "notes").write_text(" ".join(args[1:]) + "\n")
        (directory / "sbom.spdx.json").write_text(sbom(directory))
        (directory / "MANIFEST").write_text("".join(f"{l}\n" for l in manifest_lines(directory)))
        sign(directory)
    elif command == "sign" and len(args) == 1:
        directory = release(args[0])
        verify(directory)
        sign(directory)
    elif command == "install" and args:
        wait, rest = 0.0, args[1:]
        if rest[:1] == ["--wait"] and len(rest) >= 2:
            wait, rest = float(rest[1]), rest[2:]
        return 0 if install(args[0], wait, rest) else 1
    elif command == "status" and not args:
        status()
    elif command == "list" and not args:
        for directory in sorted(p for p in ROOT.glob("*") if p.is_dir()):
            note = lines_of(directory / "notes")
            state = ("sealed, signed" if (directory / "MANIFEST.sig").is_file() else "sealed") if sealed(directory) else "open"
            print(f"{directory.name}  {state}  {note[0] if note else ''}")
    else:
        raise Failure(__doc__.split("\n\n")[1])
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Failure as error:
        sys.exit(f"caboose-release: {error}")
