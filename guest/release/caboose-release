#!/usr/bin/python3 -I
"""One release of the computer's GPU and display stack, on every computer (README.md).

usage: caboose-release new ID [--from ID]          start a release, a copy of another
       caboose-release add ID SOURCE PATH [MODE]   a file installed at PATH (octal MODE)
       caboose-release capture ID COMPUTER PATH... files as COMPUTER has them now
       caboose-release deb ID DEB                  a package installed with dpkg
       caboose-release remove ID PATH              a path deleted on install
       caboose-release seal ID NOTE...             write MANIFEST; the release is final
       caboose-release install ID [--wait S] [COMPUTER...]   every running computer by default
       caboose-release status                      what each running computer runs
       caboose-release list                        the releases

Run as root on the host. Releases live in $CABOOSE_RELEASES (default /root/caboose-release)."""
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import time

ROOT = Path(os.environ.get("CABOOSE_RELEASES", "/root/caboose-release"))
# A game is running when any of these match a process (the game gate).
GAME = "MCC-Win64|steam_app_[0-9]|AppId=[0-9]"
MARKER = "/etc/caboose-release"
STEAM = "/home/caboose/.var/app/com.valvesoftware.Steam/.local/share/Steam"


class Failure(Exception):
    pass


def release(id_):
    if not id_ or "/" in id_ or id_.startswith("."):
        raise Failure(f"not a release id: {id_!r}")
    return ROOT / id_


def manifest_lines(directory):
    """`sha256  relative path` for every file of a release, sorted: files/, debs/, remove, notes."""
    lines = []
    for path in sorted(p for p in directory.rglob("*") if p.is_file() and p.name != "MANIFEST"):
        digest = hashlib.sha256(path.read_bytes()).hexdigest()
        mode = path.stat().st_mode & 0o7777 if path.parts[len(directory.parts)] == "files" else 0
        lines.append(f"{digest}  {mode:04o}  {path.relative_to(directory)}")
    return lines


def sealed(directory):
    return (directory / "MANIFEST").is_file()


def verify(directory):
    if not sealed(directory):
        raise Failure(f"{directory.name} is not sealed")
    if (directory / "MANIFEST").read_text().splitlines() != manifest_lines(directory):
        raise Failure(f"{directory.name} does not match its MANIFEST")


def writable(id_):
    directory = release(id_)
    if not directory.is_dir():
        raise Failure(f"no release {id_}")
    if sealed(directory):
        raise Failure(f"{id_} is sealed; start a new release with --from {id_}")
    return directory


def placed(directory, path):
    path = Path(path)
    if not path.is_absolute() or ".." in path.parts:
        raise Failure(f"not an absolute path: {path}")
    return directory / "files" / path.relative_to("/")


def lines_of(path):
    return [l for l in path.read_text().splitlines() if l.strip()] if path.is_file() else []


def docker(*args, input_=None, check=True):
    result = subprocess.run(["docker", *args], input=input_, capture_output=True)
    if check and result.returncode:
        raise Failure(f"docker {' '.join(args[:3])}: {result.stderr.decode(errors='replace').strip()}")
    return result


def computers():
    """Running computers' containers (not their network sidecars)."""
    names = docker("ps", "--format", "{{.Names}}").stdout.decode().split()
    return sorted(n for n in names if n.startswith("caboose-c-") and not n.endswith("-net"))


def game_running(container):
    return docker("exec", container, "pgrep", "-f", GAME, check=False).returncode == 0


def steam_running(container):
    return docker("exec", container, "pgrep", "-f", f"{STEAM}/ubuntu12_64/steamwebhelper|{STEAM}/steamrt64", check=False).returncode == 0


def install_one(directory, container, marker):
    """Copies the release in, restarts the owner's display (Steam with it, if it ran) and
    writes the marker. The game gate is checked again just before anything changes."""
    if game_running(container):
        return False
    steam = steam_running(container)
    files = directory / "files"
    if files.is_dir():
        tar = subprocess.run(["tar", "-C", str(files), "-cf", "-", "."], capture_output=True, check=True).stdout
        docker("exec", "-i", container, "tar", "-C", "/", "-xf", "-", "--no-same-owner", input_=tar)
        listed = subprocess.run(["tar", "-tf", "-"], input=tar, capture_output=True, check=True).stdout.decode().split("\n")
        paths = ["/" + p.removeprefix("./") for p in listed if p and not p.endswith("/")]
        docker("exec", container, "chown", "root:root", *paths)
    for path in lines_of(directory / "remove"):
        docker("exec", container, "rm", "-rf", "--", path)
    debs = sorted((directory / "debs").glob("*.deb")) if (directory / "debs").is_dir() else []
    for deb in debs:
        docker("exec", "-i", container, "sh", "-c", "cat > /tmp/caboose-release.deb", input_=deb.read_bytes())
        docker("exec", container, "sh", "-c", "dpkg -i /tmp/caboose-release.deb >/dev/null && rm -f /tmp/caboose-release.deb")
    # Steam ends with its X server; asked first, it quits cleanly.
    if steam:
        docker("exec", "-u", "caboose", container, "sh", "-c",
               "set -a; . /run/caboose/display.env; set +a; timeout 20 flatpak run com.valvesoftware.Steam -shutdown >/dev/null 2>&1", check=False)
    # The display and its supervisor stop together, so the supervisor does not start the
    # old display again while the new session starts its own.
    docker("exec", container, "caboose-session", "stop-display")
    docker("exec", container, "sh", "-c", "caboose-session start >/dev/null && caboose-session ready >/dev/null")
    if steam:
        docker("exec", "-d", "-u", "caboose", container, "sh", "-c",
               "set -a; . /run/caboose/display.env; set +a; exec flatpak run com.valvesoftware.Steam >/tmp/steam-launch.log 2>&1")
    docker("exec", "-i", container, "sh", "-c", f"cat > {MARKER}", input_=marker.encode())
    return True


def marker_text(directory):
    manifest = hashlib.sha256((directory / "MANIFEST").read_bytes()).hexdigest()
    return f"{directory.name}\nmanifest_sha256={manifest}\n" + "".join(f"{l}\n" for l in lines_of(directory / "notes"))


def install(id_, wait, targets):
    directory = release(id_)
    verify(directory)
    marker = marker_text(directory)
    pending = list(targets or computers())
    deadline = time.monotonic() + wait
    while pending:
        for container in list(pending):
            if install_one(directory, container, marker):
                print(f"{container}: {id_} installed", flush=True)
                pending.remove(container)
            else:
                print(f"{container}: a game is running; waiting", flush=True)
        if not pending or time.monotonic() >= deadline:
            break
        time.sleep(30)
    for container in pending:
        print(f"{container}: not installed (a game ran throughout)", flush=True)
    return not pending


def status():
    for container in computers():
        first = docker("exec", container, "sh", "-c", f"head -1 {MARKER} 2>/dev/null", check=False).stdout.decode().strip()
        print(f"{container}  {first or 'no release'}{'  (game running)' if game_running(container) else ''}")


def main(argv):
    if not argv:
        raise Failure(__doc__.split("\n\n")[1])
    command, args = argv[0], argv[1:]
    if command == "new" and args:
        directory = release(args[0])
        if directory.exists():
            raise Failure(f"{args[0]} exists")
        if len(args) == 3 and args[1] == "--from":
            base = release(args[2])
            verify(base)
            shutil.copytree(base, directory, symlinks=False)
            (directory / "MANIFEST").unlink()
            (directory / "notes").unlink(missing_ok=True)
        elif len(args) == 1:
            directory.mkdir(parents=True)
        else:
            raise Failure("usage: new ID [--from ID]")
    elif command == "add" and len(args) in (3, 4):
        target = placed(writable(args[0]), args[2])
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(args[1], target)
        target.chmod(int(args[3], 8) if len(args) == 4 else 0o644)
    elif command == "capture" and len(args) >= 3:
        directory = writable(args[0])
        for path in args[2:]:
            target = placed(directory, path)
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(docker("exec", args[1], "cat", path).stdout)
            mode = docker("exec", args[1], "stat", "-c", "%a", path).stdout.decode().strip()
            target.chmod(int(mode, 8))
    elif command == "deb" and len(args) == 2:
        debs = writable(args[0]) / "debs"
        debs.mkdir(exist_ok=True)
        shutil.copyfile(args[1], debs / Path(args[1]).name)
    elif command == "remove" and len(args) == 2:
        directory = writable(args[0])
        placed(directory, args[1])  # validates the path
        with (directory / "remove").open("a") as out:
            out.write(args[1] + "\n")
    elif command == "seal" and len(args) >= 2:
        directory = writable(args[0])
        (directory / "notes").write_text(" ".join(args[1:]) + "\n")
        (directory / "MANIFEST").write_text("".join(f"{l}\n" for l in manifest_lines(directory)))
    elif command == "install" and args:
        wait, rest = 0.0, args[1:]
        if rest[:1] == ["--wait"] and len(rest) >= 2:
            wait, rest = float(rest[1]), rest[2:]
        return 0 if install(args[0], wait, rest) else 1
    elif command == "status" and not args:
        status()
    elif command == "list" and not args:
        for directory in sorted(p for p in ROOT.glob("*") if p.is_dir()):
            note = lines_of(directory / "notes")
            print(f"{directory.name}  {'sealed' if sealed(directory) else 'open'}  {note[0] if note else ''}")
    else:
        raise Failure(__doc__.split("\n\n")[1])
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Failure as error:
        sys.exit(f"caboose-release: {error}")
