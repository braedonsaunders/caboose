[Unit]
Description=Caboose agent seat session bus
Requires=user@1000.service
After=user@1000.service

[Service]
Slice=caboose-workloads.slice
User=caboose
Group=caboose
ExecStart=/usr/libexec/caboose/agent-profile exec /usr/bin/dbus-daemon --config-file=/opt/caboose/keyring/agent-bus.conf --nofork
Restart=on-failure
