[Unit]
Description=Caboose owner desktop notification monitor
Requires=user@1000.service
After=user@1000.service

[Service]
Slice=caboose-workloads.slice
User=caboose
Group=caboose
Environment=HOME=/home/caboose
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=/usr/bin/python3 /opt/caboose/notifications/monitor.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
