{
  "manifest_version": 3,
  "name": "Caboose scroll reporter",
  "version": "1.0.0",
  "description": "Tells the Caboose app where each page is scrolled in every frame, so your iPhone scrolls it locally at display rate.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file://*/*"],
      "all_frames": false,
      "run_at": "document_start",
      "js": ["core.js", "content.js"]
    }
  ]
}
