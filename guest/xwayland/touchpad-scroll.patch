+}
+
+/* XI2 clients turn scroll valuators' absolute positions into deltas from the last event
+ * of the same device, and forget that position when the core pointer switches devices or
+ * enters a window; the first event after that scrolls nothing. An event that moves the
+ * scroll valuators (2 and 3 on every pointer device here) by nothing gives them the
+ * position, so the next delta counts. */
+static void
+prime_scroll_valuators(DeviceIntPtr device)
+{
+    ValuatorMask mask;
+
+    valuator_mask_zero(&mask);
+    valuator_mask_set_double(&mask, 2, 0.0);
+    valuator_mask_set_double(&mask, 3, 0.0);
+    QueuePointerEvents(device, MotionNotify, 0, POINTER_RELATIVE, &mask);
+}
+
+/* Whether scroll events from `device` would follow events of another device of the
+ * core pointer, which switches it and resets clients' scroll baselines. */
+static Bool
+switches_slave(DeviceIntPtr device)
+{
+    DeviceIntPtr master = GetMaster(device, MASTER_POINTER);
+
+    return master && master->lastSlave != device;
+}
+
+/* Finger scrolling as smooth scroll valuators of the touchpad device, in surface pixels.
+ * A sequence starts with prime_scroll_valuators, as the pointer may have entered a
+ * window (or switched devices) with the frame's motion. */
+static void
+dispatch_finger_scroll(struct xwl_seat *xwl_seat)
+{
+    DeviceIntPtr touchpad = xwl_seat->touchpad;
+    Bool vertical = xwl_seat->pending_pointer_event.has_vertical_scroll;
+    Bool horizontal = xwl_seat->pending_pointer_event.has_horizontal_scroll;
+    double dy = wl_fixed_to_double(xwl_seat->pending_pointer_event.scroll_dy);
+    double dx = wl_fixed_to_double(xwl_seat->pending_pointer_event.scroll_dx);
+    ValuatorMask mask;
+
+    if (!xwl_seat->finger_scrolling || switches_slave(touchpad)) {
+        if (dx == 0.0 && dy == 0.0)
+            return; /* the stop of a sequence that delivered nothing */
+        prime_scroll_valuators(touchpad);
+    }
+
+    valuator_mask_zero(&mask);
+    if (horizontal)
+        valuator_mask_set_double(&mask, 2, dx);
+    if (vertical)
+        valuator_mask_set_double(&mask, 3, dy);
+    QueuePointerEvents(touchpad, MotionNotify, 0, POINTER_RELATIVE, &mask);
+
+    /* axis_stop is a zero value: the sequence ends. */
+    xwl_seat->finger_scrolling = dx != 0.0 || dy != 0.0;
 }
 
