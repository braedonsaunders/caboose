+/* Whether the pending frame is finger scrolling: axis events with axis_source finger and
+ * no discrete steps, or the axis_stop that ends them. */
+static Bool
+is_finger_scroll(struct xwl_seat *xwl_seat)
+{
+    return xwl_seat->touchpad &&
+        xwl_seat->pending_pointer_event.has_axis_source &&
+        xwl_seat->pending_pointer_event.axis_source == WL_POINTER_AXIS_SOURCE_FINGER &&
+        (xwl_seat->pending_pointer_event.has_vertical_scroll ||
+         xwl_seat->pending_pointer_event.has_horizontal_scroll) &&
+        !xwl_seat->pending_pointer_event.has_vertical_scroll_v120 &&
+        !xwl_seat->pending_pointer_event.has_horizontal_scroll_v120;
+}
