+/* Caboose: finger scrolling (wl_pointer axis_source finger) comes from this device. Its X
+ * input type is TOUCHPAD, so clients take its smooth scroll valuators for a touchpad's
+ * precise scrolling rather than a wheel's. The scroll valuators count the compositor's
+ * axis value (X pixels), and one increment is the device's XWL_SCROLL_PIXEL_DISTANCE
+ * property of them, 120 unless the compositor sets it. Chromium scrolls 120 of its
+ * pixels per increment, so at a distance of 120 times the X screen's scale a pan moves
+ * its content as far as the finger moved. The X server emulates a core button 4-7
+ * click per increment. */
+#define XWL_SCROLL_PIXEL_DISTANCE "Xwayland Scroll Pixel Distance"
+#define XWL_TOUCHPAD_SCROLL_INCREMENT 120
+
 static int
+xwl_touchpad_proc(DeviceIntPtr device, int what)
+{
+#define NAXES 4
+    Atom axes_labels[NAXES] = { 0 };
+
+    switch (what) {
+    case DEVICE_INIT:
+        device->public.on = FALSE;
+
+        axes_labels[0] = XIGetKnownProperty(AXIS_LABEL_PROP_REL_X);
+        axes_labels[1] = XIGetKnownProperty(AXIS_LABEL_PROP_REL_Y);
+        axes_labels[2] = XIGetKnownProperty(AXIS_LABEL_PROP_REL_HSCROLL);
+        axes_labels[3] = XIGetKnownProperty(AXIS_LABEL_PROP_REL_VSCROLL);
+
+        if (!init_pointer_buttons(device))
+            return BadValue;
+
+        if (!InitValuatorClassDeviceStruct(device, NAXES, axes_labels,
+                                           GetMotionHistorySize(), Relative))
+            return BadValue;
+
+        InitValuatorAxisStruct(device, 0, axes_labels[0],
+                               NO_AXIS_LIMITS, NO_AXIS_LIMITS, 0, 0, 0, Relative);
+        InitValuatorAxisStruct(device, 1, axes_labels[1],
+                               NO_AXIS_LIMITS, NO_AXIS_LIMITS, 0, 0, 0, Relative);
+        InitValuatorAxisStruct(device, 2, axes_labels[2],
+                               NO_AXIS_LIMITS, NO_AXIS_LIMITS, 0, 0, 0, Relative);
+        InitValuatorAxisStruct(device, 3, axes_labels[3],
+                               NO_AXIS_LIMITS, NO_AXIS_LIMITS, 0, 0, 0, Relative);
+
+        SetScrollValuator(device, 2, SCROLL_TYPE_HORIZONTAL,
+                          XWL_TOUCHPAD_SCROLL_INCREMENT, SCROLL_FLAG_NONE);
+        SetScrollValuator(device, 3, SCROLL_TYPE_VERTICAL,
+                          XWL_TOUCHPAD_SCROLL_INCREMENT, SCROLL_FLAG_PREFERRED);
+
+        if (!InitPtrFeedbackClassDeviceStruct(device, xwl_pointer_control))
+            return BadValue;
+
+        return Success;
+
+    case DEVICE_ON:
+        device->public.on = TRUE;
+        return Success;
+
+    case DEVICE_OFF:
+    case DEVICE_CLOSE:
+        device->public.on = FALSE;
+        return Success;
+    }
+
+    return BadMatch;
+
+#undef NAXES
+}
+
+/* XWL_SCROLL_PIXEL_DISTANCE: one CARD32, X pixels of finger scrolling per increment. */
+static int
+xwl_touchpad_set_property(DeviceIntPtr device, Atom property,
+                          XIPropertyValuePtr prop, BOOL checkonly)
+{
+    uint32_t distance;
+
+    if (property != MakeAtom(XWL_SCROLL_PIXEL_DISTANCE,
+                             strlen(XWL_SCROLL_PIXEL_DISTANCE), TRUE))
+        return Success;
+    if (prop->format != 32 || prop->size != 1 || prop->type != XA_CARDINAL)
+        return BadMatch;
+    distance = *(uint32_t *) prop->data;
+    if (distance == 0 || distance > 100000)
+        return BadValue;
+    if (checkonly)
+        return Success;
+
+    SetScrollValuator(device, 2, SCROLL_TYPE_HORIZONTAL, distance, SCROLL_FLAG_NONE);
+    SetScrollValuator(device, 3, SCROLL_TYPE_VERTICAL, distance, SCROLL_FLAG_PREFERRED);
+    return Success;
+}
