#!/usr/bin/python3
"""caboose-scan: scan a document with the phone and print where it was saved.

  caboose-scan [--format pdf|jpeg] [--output PATH]

The request goes through the native bridge (docs/native-bridge.md § Scan): the phone shows
its document scanner, uploads the scan to `~/Caboose Documents/<uuid>/`, and answers with
its paths. With --output the scan moves there: a PDF to that file, or into that folder;
JPEG pages (one file each) into that folder, made when missing. Each file's path is
printed on its own line.

Exit status: 0 scanned, 1 cancelled or failed, 2 usage, 3 the phone is not there (Caboose
not open and connected, or it left before answering). There is no scanner on the computer
to fall back to, so it fails fast rather than waiting for the phone.
"""
import argparse
import os
import pwd
import shutil
import signal
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bridgecore as core  # noqa: E402

POLL_SECONDS = 0.2
ABSENT = 3


def fail(status, message):
    print(f'caboose-scan: {message}', file=sys.stderr)
    sys.exit(status)


def wait_for_answer(request):
    """The phone's answer, by the portal's presence rules: claimed within 3 seconds, then
    no time limit while the phone stays; withdrawn when it is gone for 10 seconds."""
    ident = request['id']
    created = time.monotonic()
    claimed = False
    absent_since = None
    while True:
        answer = core.read_json(core.RESPONSES / f'{ident}.json')
        if answer is not None:
            (core.RESPONSES / f'{ident}.json').unlink(missing_ok=True)
            (core.CLAIMED / f'{ident}.json').unlink(missing_ok=True)
            return answer
        now = time.monotonic()
        if not claimed:
            if (core.CLAIMED / f'{ident}.json').exists():
                claimed = True
            elif now - created > core.CLAIM_SECONDS:
                (core.REQUESTS / f'{ident}.json').unlink(missing_ok=True)
                if (core.CLAIMED / f'{ident}.json').exists():
                    claimed = True  # taken as it was withdrawn
                else:
                    fail(ABSENT, 'the phone did not take the request. Open Caboose on your phone, connected to this computer, and try again.')
        elif core.present():
            absent_since = None
        elif absent_since is None:
            absent_since = now
        elif now - absent_since > core.ABSENT_SECONDS:
            core.withdraw(ident)
            fail(ABSENT, 'the phone left before the scan arrived.')
        time.sleep(POLL_SECONDS)


def main(argv):
    parser = argparse.ArgumentParser(prog='caboose-scan', description='Scan a document with the phone and print where it was saved.')
    parser.add_argument('--format', choices=sorted(core.SCAN_FORMATS), default='pdf', help='pdf (one file, the default) or jpeg (one image per page)')
    parser.add_argument('--output', metavar='PATH', help='move the scan here: a PDF to this file or into this folder; JPEG pages into this folder')
    args = parser.parse_args(argv)
    try:
        owner = pwd.getpwnam('caboose').pw_uid
    except KeyError:
        fail(2, 'this is not a Caboose computer')
    if os.geteuid() != owner:
        fail(2, 'run it as caboose, the computer\'s owner')
    if args.output is not None:
        problem = core.scan_output_problem(args.output, args.format)
        if problem:
            fail(2, problem)
    if not core.present():
        fail(ABSENT, 'the phone is not connected. Open Caboose on your phone, connected to this computer, and try again.')

    core.prepare()
    request = core.new_scan_request(args.format)

    def interrupted(signum, _frame):
        core.withdraw(request['id'])
        sys.exit(128 + signum)
    for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(signum, interrupted)
    core.write_json(core.REQUESTS / f"{request['id']}.json", request)
    raw = wait_for_answer(request)

    try:
        answer = core.check_answer(raw, request)
    except core.Invalid as error:
        fail(1, f'the phone\'s answer was not usable ({error}).')
    if answer['response'] == 'cancel':
        fail(1, 'scanning was cancelled.')
    if answer['response'] == 'computer':
        fail(1, 'the phone did not scan: it has no document scanner, or could not show it now.')
    paths = core.chosen(request, answer)
    if paths is None:
        fail(1, 'the scan did not arrive on the computer.')
    if args.output is not None:
        if args.format == 'jpeg':
            os.makedirs(args.output, exist_ok=True)
        moved = []
        for source, destination in core.scan_destinations(paths, args.output, args.format):
            shutil.move(source, destination)
            moved.append(os.path.abspath(destination))
        # The phone's upload folder (Caboose Documents/<uuid>) is empty now.
        for folder in {os.path.dirname(p) for p in paths}:
            try:
                os.rmdir(folder)
            except OSError:
                pass
        paths = moved
    for path in paths:
        print(path)


if __name__ == '__main__':
    main(sys.argv[1:])
