From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Caboose <caboose@invalid>
Date: Sat, 31 Oct 2026 00:00:00 +0000
Subject: [PATCH 12/15] Share one encoder among all threads of a process

On the socket transport every thread uses the first thread's encoder, so the
device sees one ordered stream: a fence reset on one thread can never be
overtaken by another thread's submit, and replies can be deferred safely. The
encoder lock serializes threads. With a single encoder, vkResetCommandPool's
reply is deferred like a fence reset's.
---
 .../guest/vulkan_enc/ResourceTracker.cpp          | 15 +++++++++++++++
 .../guest/vulkan_enc/autogenerated/VkEncoder.cpp  |  7 ++++++-
 2 files changed, 21 insertions(+), 1 deletion(-)

diff --git a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
index cacd171..7371795 100644
--- a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
+++ b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
@@ -1,3 +1,4 @@
+#include <atomic>
 #include <cstdlib>
 #include <new>
 /*
@@ -8767,8 +8768,22 @@ ALWAYS_INLINE_GFXSTREAM VkEncoder* ResourceTracker::getQueueEncoder(VkQueue queu
 
 // static
 ALWAYS_INLINE_GFXSTREAM VkEncoder* ResourceTracker::getThreadLocalEncoder() {
+    // On the private socket transport every thread shares the first thread's encoder,
+    // so the device sees one ordered stream: a fence reset on one thread can never be
+    // overtaken by another thread's submit, and replies can be deferred safely. The
+    // encoder lock serializes threads; the first caller is the process's Vulkan owner.
+    static std::atomic<VkEncoder*> shared{nullptr};
+    static const bool sharedStream = std::getenv("CABOOSE_GFXSTREAM_SOCKET") != nullptr;
+    if (sharedStream) {
+        if (VkEncoder* existing = shared.load(std::memory_order_acquire)) return existing;
+    }
     auto hostConn = ResourceTracker::threadingCallbacks.hostConnectionGetFunc();
     auto vkEncoder = ResourceTracker::threadingCallbacks.vkEncoderGetFunc(hostConn);
+    if (sharedStream && vkEncoder) {
+        VkEncoder* expected = nullptr;
+        shared.compare_exchange_strong(expected, vkEncoder, std::memory_order_acq_rel);
+        return shared.load(std::memory_order_acquire);
+    }
     return vkEncoder;
 }
 
diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
index 4859834..8aebcd8 100644
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
+++ b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
@@ -5089,7 +5089,12 @@ VkResult VkEncoder::vkResetCommandPool(VkDevice device, VkCommandPool commandPoo
     memcpy(*streamPtrPtr, (VkCommandPoolResetFlags*)&local_flags, sizeof(VkCommandPoolResetFlags));
     *streamPtrPtr += sizeof(VkCommandPoolResetFlags);
     VkResult vkResetCommandPool_VkResult_return = (VkResult)0;
-    caboose_read_profile::read(stream, &vkResetCommandPool_VkResult_return, sizeof(VkResult));
+    if (caboose::memory::deferredReplies.singleEncoder(this)) {
+        stream->flush();
+        caboose::memory::deferredReplies.add(this, 1, packetSize_vkResetCommandPool);
+    } else {
+        caboose_read_profile::read(stream, &vkResetCommandPool_VkResult_return, sizeof(VkResult));
+    }
     ++encodeCount;
     if (0 == encodeCount % POOL_CLEAR_INTERVAL) {
         pool->freeAll();
