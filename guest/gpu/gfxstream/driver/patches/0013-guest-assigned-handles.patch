From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Caboose <caboose@invalid>
Date: Sat, 31 Oct 2026 00:00:00 +0000
Subject: [PATCH 13/17] Assign Vulkan handles in the guest when the client
 device supports it

The hello offers feature bit 0x80. When the broker echoes it, the connected
device registers created objects under handles the guest chose (0xCA top byte,
a per-process tag, a counter), so buffer, image, image view, framebuffer,
sampler, shader module, render pass, pipeline cache, pipeline layout,
descriptor set layout, descriptor pool and command pool creation never waits
for a round trip; each reply is checked when it is drained. A device that
refuses or renames such a handle has diverged from the application's view and
the device is lost. CABOOSE_GFXSTREAM_GUEST_HANDLES=0 opts out. Fences,
semaphores and device memory keep device-assigned handles.
---
 .../vulkan_enc/autogenerated/VkEncoder.cpp    | 82 +++++++++++++++++--
 1 file changed, 74 insertions(+), 8 deletions(-)

diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
index 8aebcd8..cfc4f86 100644
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
+++ b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
@@ -136,6 +136,28 @@ template <class T> static T* vk_extract_struct(void* start, VkStructureType sTyp
 // creation waits a full round trip for the host's handle. A destroyed view of an image
 // this encoder created is parked instead, and an identical request reuses it. Parked
 // views are destroyed for real before their image or device is.
+
+#include <random>
+// Guest-assigned Vulkan handles: the device registers each created object under the
+// handle the guest chose (0xCA top byte, a per-process tag, a counter), so a create
+// never waits for the device. Enabled only where the connected device supports it.
+namespace caboose_guest_handles {
+}  // namespace caboose_guest_handles
+extern "C" int caboose_gfxstream_guest_handles;
+namespace caboose_guest_handles {
+// Negotiated by the device stream's hello (SocketStream.cpp), never assumed.
+inline bool enabled() { return caboose_gfxstream_guest_handles == 1; }
+inline uint64_t next() {
+    static const uint64_t tag = [] {
+        std::random_device random;
+        uint64_t value = (uint64_t(random()) ^ (uint64_t(getpid()) << 8)) & 0xFFFFFFull;
+        return value ? value : 1;
+    }();
+    static std::atomic<uint32_t> counter{0};
+    uint32_t n = counter.fetch_add(1, std::memory_order_relaxed) + 1;
+    return (0xCAull << 56) | (tag << 32) | n;
+}
+}  // namespace caboose_guest_handles
