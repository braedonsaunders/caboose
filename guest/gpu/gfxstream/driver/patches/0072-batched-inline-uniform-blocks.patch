             mesa_loge("%s: did not find inline uniform block\n", __func__);
             return;
         }
+        // Caboose: the binding's bytes are kept whole: a write lands at its offset
+        // (dstArrayElement), and the next commit sends every byte written so far, so a
+        // partial write never undoes an earlier one.
         auto& entry = table[dstBinding][0];
+        const size_t end = size_t(dstArrayElement) + descInlineUniformBlock->dataSize;
+        if (entry.inlineUniformBlockBuffer.size() < end) entry.inlineUniformBlockBuffer.resize(end);
+        memcpy(entry.inlineUniformBlockBuffer.data() + dstArrayElement, descInlineUniformBlock->pData,
+               descInlineUniformBlock->dataSize);
         entry.inlineUniformBlock = *descInlineUniformBlock;
-        entry.inlineUniformBlockBuffer.assign(
-            static_cast<const uint8_t*>(descInlineUniformBlock->pData),
-            static_cast<const uint8_t*>(descInlineUniformBlock->pData) +
-                descInlineUniformBlock->dataSize);
+        entry.inlineUniformBlock.pNext = nullptr;
+        entry.inlineUniformBlock.dataSize = uint32_t(entry.inlineUniformBlockBuffer.size());
         entry.type = DescriptorWriteType::InlineUniformBlock;
         entry.descriptorType = descType;
-        entry.dstArrayElement = dstArrayElement;
+        entry.dstArrayElement = 0;
     } else if (isDescriptorTypeAccelerationStructure(descType)) {
         // TODO
         // Look for pNext inline uniform block or acceleration structure.
