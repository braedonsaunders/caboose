 #include <random>
 // Guest-assigned Vulkan handles: the device registers each created object under the
-// handle the guest chose (0xCA top byte, a per-process tag, a counter), so a create
-// never waits for the device. Enabled only where the connected device supports it.
-namespace caboose_guest_handles {
-}  // namespace caboose_guest_handles
+// handle the guest chose (0xCA top byte, a 24-bit per-process tag, a 32-bit counter), so
+// a create never waits for the device. Enabled only where the connected device supports
+// it: hello feature bit 0x80 for single-handle creates and pipelines, 0x100 for
+// descriptor sets and command buffers.
 extern "C" int caboose_gfxstream_guest_handles;
+extern "C" int caboose_gfxstream_guest_handle_arrays;
+extern "C" int caboose_gfxstream_device_fd;
 namespace caboose_guest_handles {
 // Negotiated by the device stream's hello (SocketStream.cpp), never assumed.
 inline bool enabled() { return caboose_gfxstream_guest_handles == 1; }
-inline uint64_t next() {
-    static const uint64_t tag = [] {
-        std::random_device random;
+inline bool arrays() { return enabled() && caboose_gfxstream_guest_handle_arrays == 1; }
+struct Space {
+    std::mutex mutex;
+    uint64_t tag = 0;
+    uint64_t used = 0;  // counter values handed out under `tag`
+};
+inline Space space;
+inline uint64_t randomTag(uint64_t avoid) {
+    std::random_device random;
+    for (;;) {
         uint64_t value = (uint64_t(random()) ^ (uint64_t(getpid()) << 8)) & 0xFFFFFFull;
-        return value ? value : 1;
-    }();
-    static std::atomic<uint32_t> counter{0};
-    uint32_t n = counter.fetch_add(1, std::memory_order_relaxed) + 1;
-    return (0xCAull << 56) | (tag << 32) | n;
+        if (value && value != avoid) return value;
+    }
+}
+// The first of `count` consecutive handles. A process that exhausts a tag's counter
+// continues under a fresh tag, so no handle is ever handed out twice.
+inline uint64_t nextBlock(uint32_t count) {
+    std::lock_guard<std::mutex> lock(space.mutex);
+    if (!space.tag || space.used + count > 0xFFFFFFFFull) {
+        space.tag = randomTag(space.tag);
+        space.used = 0;
+    }
+    const uint64_t first = (0xCAull << 56) | (space.tag << 32) | (space.used + 1);
+    space.used += count;
+    return first;
 }
+inline uint64_t next() { return nextBlock(1); }
 }  // namespace caboose_guest_handles
