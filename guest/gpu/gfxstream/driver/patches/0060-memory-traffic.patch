From: Caboose <caboose@local>
Subject: [PATCH 60/60] Count the memory a process moves to and from the phone

The encoder counts the bytes each flush sends and each invalidate reads back, by whether the
application asked or the driver kept its host-coherent type coherent, and the readback
ranges copies into buffers mark, in caboose-bounded-memory/memory_traffic.h, which reports
them every five seconds in which anything moved.
---
diff --git a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
index def6e40..334cb3c 100644
--- a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
+++ b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
@@ -1477,6 +1477,7 @@ bool cabooseCoherentLogEnabled() {
 } // namespace
 
 VkResult ResourceTracker::cabooseFlushCoherentMappings(VkEncoder* enc) {
+    caboose::memory::traffic::CoherentUpkeep upkeep;
     if (!enc || usingDirectMapping()) return VK_SUCCESS;
     struct Candidate {
         VkDevice device;
@@ -1598,6 +1599,7 @@ VkResult ResourceTracker::cabooseFlushCoherentMappings(VkEncoder* enc) {
 }
 
 VkResult ResourceTracker::cabooseInvalidateCoherentMappings(VkEncoder* enc, VkDevice device, uint32_t doLock) {
+    caboose::memory::traffic::CoherentUpkeep upkeep;
     if (!enc || usingDirectMapping()) return VK_SUCCESS;
     struct InvalidateItem {
         VkDevice device;
@@ -1795,7 +1797,7 @@ void ResourceTracker::cabooseRecordBufferMemoryBind(VkBuffer buffer, VkDeviceMem
     }
 }
 
-void ResourceTracker::cabooseMarkBufferGpuWritten(VkCommandBuffer commandBuffer, VkBuffer buffer, VkDeviceSize dstOffset, VkDeviceSize size, bool requireReadbackBuffer) {
+void ResourceTracker::cabooseMarkBufferGpuWritten(VkCommandBuffer commandBuffer, VkBuffer buffer, VkDeviceSize dstOffset, VkDeviceSize size, bool requireReadbackBuffer, bool queryResults) {
     std::lock_guard<std::recursive_mutex> lock(mLock);
     auto bufIt = info_VkBuffer.find(buffer);
     if (bufIt == info_VkBuffer.end() || bufIt->second.currentBacking == VK_NULL_HANDLE) return;
@@ -1842,6 +1844,10 @@ void ResourceTracker::cabooseMarkBufferGpuWritten(VkCommandBuffer commandBuffer,
         return;
     }
     memInfo.socketGpuWrittenEver = true;
+    caboose::memory::traffic::counters().marked(
+        queryResults ? caboose::memory::traffic::copyQueryResults
+        : requireReadbackBuffer ? caboose::memory::traffic::copyBuffer : caboose::memory::traffic::copyImageToBuffer,
+        absEnd - absBegin);
     if (commandBuffer != VK_NULL_HANDLE) {
         auto& ranges = mCabooseCommandDirtyRanges[caboose::handle_key(commandBuffer)];
         for (auto& existing : ranges) {
