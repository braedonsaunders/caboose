+// One-way start (caboose-bounded-memory/one_way_start.h): whether this stream reads no reply of
+// silent success's commands now, the condition for sending a start command one-way. A process's
+// first start command may come before its feed runs: it waits briefly for the feed, then
+// switches. Called with the lock held.
+bool VkEncoder::cabooseOneWayReady() {
+    if (!caboose::one_way::granted()) return false;
+    if (caboose::silent::replyMode().silent(this)) return true;
+    if (!caboose::one_way::awaitFeed()) return false;
+    if (caboose::silent::replyMode().due(this, caboose::completion::feedActive.load(std::memory_order_acquire))) {
+        auto* stream = mImpl->stream();
+        caboose::silent::encodeReplyMode(stream->reserve(caboose::silent::kReplyModePacketSize));
+    }
+    return caboose::silent::replyMode().silent(this);
+}
+
+// REPLY_MODE(`mode`) on this stream, in order with the commands around it.
+void VkEncoder::cabooseReplyMode(uint32_t mode) {
+    caboose::silent::encodeReplyMode(mImpl->stream()->reserve(caboose::silent::kReplyModePacketSize), mode);
+}
