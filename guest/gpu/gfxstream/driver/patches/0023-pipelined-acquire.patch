From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Caboose <caboose@invalid>
Date: Sat, 31 Oct 2026 00:00:00 +0000
Subject: [PATCH 23/24] Hand images acquired ahead of time to the application

Submits without staged command buffers (the hand-off of a pipelined acquire,
or an application's semaphore-only submit) no longer wait for their result
with guest-assigned handles; any failure is device loss, as for staged
submits. With ordered presents and the completion feed, the virtual WSI
acquires the next image on the phone against a private semaphore right after
each present, and the application's acquire hands that semaphore's signal to
its own semaphore and fence with one submission, without a round trip.
---
 .../vulkan_enc/autogenerated/VkEncoder.cpp    | 42 ++++++++++++++++---
 1 file changed, 36 insertions(+), 6 deletions(-)

diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
index 32892e4..b3e452a 100644
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
+++ b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
@@ -2013,7 +2013,11 @@ VkResult VkEncoder::vkQueueSubmit(VkQueue queue, uint32_t submitCount, const VkS
     if (!queueSubmitWithCommandsEnabled && doLock) caboose_rpc_timing.lock([&] { this->lock(); });
     auto stream = mImpl->stream();
     caboose_read_profile::currentOpcode = OP_vkQueueSubmit;
-    caboose::memory::deferredReplies.drain(this, stream);
+    // A submit's failure is device loss once the application has moved on: with guest
+    // handles it never waits for its result.
+    const bool cabooseDeferredSubmit = !queueSubmitWithCommandsEnabled && caboose_guest_handles::enabled() &&
+                                       caboose::memory::deferredReplies.singleEncoder(this);
+    if (!cabooseDeferredSubmit) caboose::memory::deferredReplies.drain(this, stream);
     auto pool = mImpl->pool();
     VkQueue local_queue;
     uint32_t local_submitCount;
@@ -2079,7 +2083,13 @@ VkResult VkEncoder::vkQueueSubmit(VkQueue queue, uint32_t submitCount, const VkS
     memcpy(*streamPtrPtr, (uint64_t*)&cgen_var_1, 1 * 8);
     *streamPtrPtr += 1 * 8;
     VkResult vkQueueSubmit_VkResult_return = (VkResult)0;
-    caboose_read_profile::read(stream, &vkQueueSubmit_VkResult_return, sizeof(VkResult));
+    if (cabooseDeferredSubmit) {
+        stream->flush();
+        caboose::memory::deferredReplies.reserve(this, stream, packetSize_vkQueueSubmit);
+        caboose::memory::deferredReplies.addCheckedResult(this, packetSize_vkQueueSubmit);
+    } else {
+        caboose_read_profile::read(stream, &vkQueueSubmit_VkResult_return, sizeof(VkResult));
+    }
     if (vkQueueSubmit_VkResult_return == VK_SUCCESS)
         cabooseWatchSubmission(stream, queue, submitCount, pSubmits, fence);
     ++encodeCount;
@@ -16709,7 +16719,11 @@ VkResult VkEncoder::vkQueueSubmit2(VkQueue queue, uint32_t submitCount,
     if (!queueSubmitWithCommandsEnabled && doLock) this->lock();
     auto stream = mImpl->stream();
     caboose_read_profile::currentOpcode = OP_vkQueueSubmit2;
-    caboose::memory::deferredReplies.drain(this, stream);
+    // A submit's failure is device loss once the application has moved on: with guest
+    // handles it never waits for its result.
+    const bool cabooseDeferredSubmit = !queueSubmitWithCommandsEnabled && caboose_guest_handles::enabled() &&
+                                       caboose::memory::deferredReplies.singleEncoder(this);
+    if (!cabooseDeferredSubmit) caboose::memory::deferredReplies.drain(this, stream);
     auto pool = mImpl->pool();
     VkQueue local_queue;
     uint32_t local_submitCount;
@@ -16775,7 +16789,13 @@ VkResult VkEncoder::vkQueueSubmit2(VkQueue queue, uint32_t submitCount,
     memcpy(*streamPtrPtr, (uint64_t*)&cgen_var_1, 1 * 8);
     *streamPtrPtr += 1 * 8;
     VkResult vkQueueSubmit2_VkResult_return = (VkResult)0;
-    caboose_read_profile::read(stream, &vkQueueSubmit2_VkResult_return, sizeof(VkResult));
+    if (cabooseDeferredSubmit) {
+        stream->flush();
+        caboose::memory::deferredReplies.reserve(this, stream, packetSize_vkQueueSubmit2);
+        caboose::memory::deferredReplies.addCheckedResult(this, packetSize_vkQueueSubmit2);
+    } else {
+        caboose_read_profile::read(stream, &vkQueueSubmit2_VkResult_return, sizeof(VkResult));
+    }
     if (vkQueueSubmit2_VkResult_return == VK_SUCCESS)
         cabooseWatchSubmission(stream, queue, submitCount, pSubmits, fence);
     ++encodeCount;
@@ -23861,7 +23881,11 @@ VkResult VkEncoder::vkQueueSubmit2KHR(VkQueue queue, uint32_t submitCount,
     if (!queueSubmitWithCommandsEnabled && doLock) this->lock();
     auto stream = mImpl->stream();
     caboose_read_profile::currentOpcode = OP_vkQueueSubmit2KHR;
-    caboose::memory::deferredReplies.drain(this, stream);
+    // A submit's failure is device loss once the application has moved on: with guest
+    // handles it never waits for its result.
+    const bool cabooseDeferredSubmit = !queueSubmitWithCommandsEnabled && caboose_guest_handles::enabled() &&
+                                       caboose::memory::deferredReplies.singleEncoder(this);
+    if (!cabooseDeferredSubmit) caboose::memory::deferredReplies.drain(this, stream);
     auto pool = mImpl->pool();
     VkQueue local_queue;
     uint32_t local_submitCount;
@@ -23928,7 +23952,13 @@ VkResult VkEncoder::vkQueueSubmit2KHR(VkQueue queue, uint32_t submitCount,
     memcpy(*streamPtrPtr, (uint64_t*)&cgen_var_1, 1 * 8);
     *streamPtrPtr += 1 * 8;
     VkResult vkQueueSubmit2KHR_VkResult_return = (VkResult)0;
-    caboose_read_profile::read(stream, &vkQueueSubmit2KHR_VkResult_return, sizeof(VkResult));
+    if (cabooseDeferredSubmit) {
+        stream->flush();
+        caboose::memory::deferredReplies.reserve(this, stream, packetSize_vkQueueSubmit2KHR);
+        caboose::memory::deferredReplies.addCheckedResult(this, packetSize_vkQueueSubmit2KHR);
+    } else {
+        caboose_read_profile::read(stream, &vkQueueSubmit2KHR_VkResult_return, sizeof(VkResult));
+    }
     if (vkQueueSubmit2KHR_VkResult_return == VK_SUCCESS)
         cabooseWatchSubmission(stream, queue, submitCount, pSubmits, fence);
     ++encodeCount;
