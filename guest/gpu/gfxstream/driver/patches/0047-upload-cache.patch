+bool VkEncoder::cabooseUploadInventory(std::vector<uint8_t>* prefixes, uint32_t* allowance,
+                                       uint32_t doLock) {
+    if (caboose::completion::lostCall()) return false;
+    bool queueSubmitWithCommandsEnabled =
+        sFeatureBits & VULKAN_STREAM_FEATURE_QUEUE_SUBMIT_WITH_COMMANDS_BIT;
+    const bool locked = !queueSubmitWithCommandsEnabled && doLock;
+    if (locked) this->lock();
+    auto stream = mImpl->stream();
+    // The reply follows every reply already owed on this stream.
+    bool answered = caboose::memory::deferredReplies.drain(this, stream);
+    if (answered) {
+        uint8_t* packet = stream->reserve(caboose::upload_cache::kInventoryPacketBytes);
+        caboose::upload_cache::encodeInventoryRequest(packet);
+        stream->flush();
+        uint8_t head[8];
+        stream->read(head, sizeof(head));
+        uint32_t count = 0;
+        answered = caboose::upload_cache::inventoryHead(head, &count, allowance) &&
+                   !caboose::completion::lostCall();
+        if (answered) {
+            prefixes->resize(size_t(count) * caboose::upload_cache::kPrefixBytes);
+            if (count) stream->read(prefixes->data(), prefixes->size());
+            answered = !caboose::completion::lostCall();
+        } else if (!caboose::completion::lostCall()) {
+            // A malformed head leaves the rest of the reply unknown: the stream is unusable.
+            stream->invalidate();
+        }
+    }
+    if (locked) this->unlock();
+    return answered;
+}
