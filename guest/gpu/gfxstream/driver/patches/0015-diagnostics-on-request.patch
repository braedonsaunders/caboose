From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Caboose <caboose@invalid>
Date: Sat, 31 Oct 2026 00:00:00 +0000
Subject: [PATCH 15/17] Report diagnostics only when asked

CABOOSE_READ_PROFILE=1 turns on the per-opcode blocking-read profile; without
it a reply read is only a read, with no clock or global lock. The coherent
memory flush and invalidate reports are printed only with
CABOOSE_PRIVATE_GPU_COHERENT_LOG=1, and without it every submit batches its
coherent flushes per device. The unused flush window header is no longer
included.
---
 .../guest/vulkan_enc/ResourceTracker.cpp          | 15 ++++++++++++---
 .../guest/vulkan_enc/autogenerated/VkEncoder.cpp  | 13 ++++++++++++-
 2 files changed, 24 insertions(+), 4 deletions(-)

diff --git a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
index 7371795..4c91ed2 100644
--- a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
+++ b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
@@ -1446,6 +1446,15 @@ std::atomic<uint64_t> gCabooseCoherentSubmitOrdinal{0};
 std::atomic<uint64_t> gCabooseCoherentInvalidateOrdinal{0};
 std::atomic<bool> gCabooseCoherentPendingPostInvalidateLog{false};
 std::atomic<uint32_t> gCabooseCoherentPostInvalidateLogged{0};
+// CABOOSE_PRIVATE_GPU_COHERENT_LOG=1 reports the first 64 coherent flushes, the first 64
+// after an invalidate, and the first 64 invalidates on stderr.
+bool cabooseCoherentLogEnabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("CABOOSE_PRIVATE_GPU_COHERENT_LOG");
+        return value && value[0] == '1' && value[1] == '\0';
+    }();
+    return enabled;
+}
 } // namespace
 
 VkResult ResourceTracker::cabooseFlushCoherentMappings(VkEncoder* enc) {
@@ -1490,8 +1499,8 @@ VkResult ResourceTracker::cabooseFlushCoherentMappings(VkEncoder* enc) {
     }
     const uint64_t submitOrd = gCabooseCoherentSubmitOrdinal.fetch_add(1, std::memory_order_relaxed);
     const bool postInv = gCabooseCoherentPendingPostInvalidateLog.exchange(false, std::memory_order_relaxed);
-    const bool shouldLog = (submitOrd < 64) ||
-        (postInv && gCabooseCoherentPostInvalidateLogged.fetch_add(1, std::memory_order_relaxed) < 64);
+    const bool shouldLog = cabooseCoherentLogEnabled() && (submitOrd < 64 ||
+        (postInv && gCabooseCoherentPostInvalidateLogged.fetch_add(1, std::memory_order_relaxed) < 64));
     if (mapped.empty()) {
         if (shouldLog) {
             std::fprintf(stderr,
@@ -1604,7 +1613,7 @@ VkResult ResourceTracker::cabooseInvalidateCoherentMappings(VkEncoder* enc, VkDe
     gCabooseCoherentPendingPostInvalidateLog.store(true, std::memory_order_relaxed);
     uint64_t totalBytes = 0;
     for (const auto& item : mapped) totalBytes += item.range.size;
-    if (invOrd < 64) {
+    if (cabooseCoherentLogEnabled() && invOrd < 64) {
         std::fprintf(stderr,
             "CABOOSE_COHERENT_INVALIDATE ordinal=%" PRIu64 " ranges=%zu total_bytes=%" PRIu64,
             invOrd, mapped.size(), totalBytes);
diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
index 1695734..c37d019 100644
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
+++ b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
@@ -1,5 +1,4 @@
 #include "caboose-bounded-memory/ranges.h"
-#include "caboose-bounded-memory/flush_window.h"
 #include "caboose-bounded-memory/flush_packet.h"
 #include "caboose-bounded-memory/flush_timing.h"
 #include "caboose-bounded-memory/rpc_timing.h"
@@ -69,7 +68,19 @@ inline void note(uint64_t us) {
     std::fprintf(stderr, "\n");
     totals = Totals{};
 }
+// CABOOSE_READ_PROFILE=1 turns the profile on; otherwise a read is only a read.
+inline bool enabled() {
+    static const bool on = [] {
+        const char* value = std::getenv("CABOOSE_READ_PROFILE");
+        return value && value[0] == '1' && value[1] == '\0';
+    }();
+    return on;
+}
 template <class S, class P> inline void read(S* stream, P* ptr, size_t size) {
+    if (!enabled()) {
+        stream->read(ptr, size);
+        return;
+    }
     auto t0 = std::chrono::steady_clock::now();
     stream->read(ptr, size);
     note(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0).count());
