From: Caboose <caboose@invalid>
Date: Sun, 1 Nov 2026 00:00:00 +0000
Subject: [PATCH 48/48] Skip coherent mappings another thread released before a
 submit's flush

Before a submit the socket path flushes every coherent mapping it finds under
the tracker lock, then flushes them without it. Chromium's ANGLE frees memory
on its garbage collection thread meanwhile; the freed mapping failed the
flush's lookup, the flush returned VK_ERROR_OUT_OF_HOST_MEMORY and the submit
with it, and an acquire's hand-off submit turned that into a lost context.
That flush now skips a mapping that is gone
(caboose::memory::skipVanishedMappings, ../bounded-memory/ranges.h).

diff --git a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
index 29000df..f914d20 100644
--- a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
+++ b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
@@ -1510,6 +1510,13 @@ VkResult ResourceTracker::cabooseFlushCoherentMappings(VkEncoder* enc) {
             });
         }
     }
+    // The mappings were found under the lock and are flushed without it: one another thread
+    // unmaps or frees meanwhile (ANGLE frees on its garbage collection thread) needs no flush,
+    // and must not fail the submit.
+    struct SkipVanished {
+        SkipVanished() { caboose::memory::skipVanishedMappings = true; }
+        ~SkipVanished() { caboose::memory::skipVanishedMappings = false; }
+    } skipVanished;
     const uint64_t submitOrd = gCabooseCoherentSubmitOrdinal.fetch_add(1, std::memory_order_relaxed);
     const bool postInv = gCabooseCoherentPendingPostInvalidateLog.exchange(false, std::memory_order_relaxed);
     const bool shouldLog = cabooseCoherentLogEnabled() && (submitOrd < 64 ||
diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
index 4d39082..a353732 100644
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
