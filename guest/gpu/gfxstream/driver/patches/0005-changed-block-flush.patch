 src/gfxstream/guest/vulkan_enc/ResourceTracker.h |  1 +
 .../guest/vulkan_enc/autogenerated/VkEncoder.cpp | 16 ++++++++++++++--
 3 files changed, 17 insertions(+), 2 deletions(-)

