+        out->waits.push_back({caboose::handle_key(submit.pWaitSemaphores[i]), value});
+    }
+    for (uint32_t i = 0; submit.pSignalSemaphores && i < submit.signalSemaphoreCount; ++i)
+        out->signaled.push_back(caboose::handle_key(submit.pSignalSemaphores[i]));
