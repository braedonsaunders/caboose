From: Caboose <caboose@local>
Subject: [PATCH 86/89] Answer query results and capture coherent writes from
 completion records

vkGetQueryPoolResults asked the device for the values of ended queries: in five seconds
of Halo 11 calls waited 117 ms, and a WAIT always waited for its reply. With hello 0x200000
(completion payloads, with the completion feed) a watched batch that ends occlusion or
timestamp queries, or writes coherent memory on the GPU, is watched with
COMPLETION_WATCH2, naming those query ranges and memory ranges; the phone captures them
once the batch completes and sends the captures in its record
(caboose-bounded-memory/completion_payloads.h). vkGetQueryPoolResults answers every flag
and layout of captured queries locally, a WAIT by waiting for the records, without the
encoder lock; what it cannot answer is asked on the device as before. Captured memory is
stored in its allocation's shadow before the batch completes, unless a later batch writes
it too or an idle wait completed the batch first; the invalidate still reads it.
vkDestroyQueryPool waits for the records that capture the pool, since the phone captures
without a lock against the destroy. A batch submitted without a running feed leaves its
queries to the device.
---
diff --git a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
--- a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
+++ b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
@@ -1937,6 +1937,39 @@ bool ResourceTracker::cabooseHasCommandBuffersGpuWritten(const std::vector<uint6
     return false;
 }
 
+std::vector<caboose::completion::Tracker::MemoryWrite> ResourceTracker::cabooseCommandBuffersGpuWrittenRanges(
+    const std::vector<uint64_t>& commandBuffers) {
+    std::vector<caboose::completion::Tracker::MemoryWrite> out;
+    std::lock_guard<ResourceTracker::TrackerMutex> lock(mLock);
+    for (uint64_t cb : commandBuffers) {
+        auto it = mCabooseCommandDirtyRanges.find(cb);
+        if (it == mCabooseCommandDirtyRanges.end()) continue;
+        for (const auto& r : it->second) {
+            auto memIt = info_VkDeviceMemory.find(r.memory);
+            if (memIt == info_VkDeviceMemory.end() || !memIt->second.socketShadow || r.end <= r.begin) continue;
+            out.push_back({caboose::handle_key(r.memory), 0, uint64_t(r.begin), uint64_t(r.end - r.begin)});
+        }
+    }
+    return out;
+}
+
+// Caboose: a capture is stored where an invalidate would write it, the mapped part of the
+// allocation's shadow, which stays alive while it is written.
+bool ResourceTracker::cabooseCaptureTarget(uint64_t memory, caboose::completion::Tracker::MemoryTarget* out) {
+    std::lock_guard<ResourceTracker::TrackerMutex> lock(mLock);
+    auto found = info_VkDeviceMemory.find(caboose::to_handle<VkDeviceMemory>(memory));
+    if (found == info_VkDeviceMemory.end()) return false;
+    const auto& info = found->second;
+    if (!info.socketShadow || !info.socketMapped || !info.ptr || info.socketMapOffset > info.allocationSize ||
+        info.socketMapSize > info.allocationSize - info.socketMapOffset) return false;
+    out->keep = info.socketShadow;
+    out->base = info.ptr;
+    out->begin = info.socketMapOffset;
+    out->end = info.socketMapOffset + info.socketMapSize;
+    out->allocation = info.allocationSize;
+    return true;
+}
+
 void ResourceTracker::cabooseSubmitCommandBuffersGpuWritten(const std::vector<uint64_t>& commandBuffers, uint64_t serial) {
     if (commandBuffers.empty()) return;
     std::lock_guard<ResourceTracker::TrackerMutex> lock(mLock);
@@ -10098,6 +10131,16 @@ static ResourceTracker* sTracker = nullptr;
 ResourceTracker::ResourceTracker() {
     mCreateMapping = new CreateMapping();
     mDestroyMapping = new DestroyMapping();
+    // Caboose: captured coherent memory goes into its shadow; the flush shadow then knows the
+    // host holds those bytes, and the written blocks are not sent back.
+    caboose::completion::tracker().memoryHooks(
+        [](uint64_t memory, caboose::completion::Tracker::MemoryTarget* out) {
+            return ResourceTracker::get()->cabooseCaptureTarget(memory, out);
+        },
+        [](uint64_t memory, const caboose::completion::Tracker::MemoryTarget& target, uint64_t offset, uint64_t size) {
+            caboose::memory::flushShadow.noteRefreshed(memory, target.base, target.allocation, offset, size);
+            caboose::memory::writeWatch().written(target.base, offset, offset + size, [](uint64_t, uint64_t) {});
+        });
     static const bool hooked = caboose::completion::onNewGeneration([] { ResourceTracker::get()->cabooseNewGeneration(); });
     (void)hooked;
 }
