+    std::vector<caboose::completion::Tracker::MemoryWrite> cabooseCommandBuffersGpuWrittenRanges(
+        const std::vector<uint64_t>& commandBuffers);
+    bool cabooseCaptureTarget(uint64_t memory, caboose::completion::Tracker::MemoryTarget* out);
     void cabooseSubmitCommandBuffersGpuWritten(const std::vector<uint64_t>& commandBuffers, uint64_t serial);
     VkDevice caboosePrefetchFenceDevice(VkFence fence);
     uint32_t getStreamFeatures() const;
diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
+++ b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
@@ -370,6 +370,8 @@ extern "C" int caboose_gfxstream_guest_query_pools;
 extern "C" int caboose_gfxstream_guest_buffer_views;
 // 1 when the guest chooses its batched descriptor pools' set ids (hello feature 0x100000).
 extern "C" int caboose_gfxstream_guest_set_ids;
+// 1 when completion watches name what the phone captures for their records (hello 0x200000).
+extern "C" int caboose_gfxstream_completion_payloads;
 namespace caboose_guest_handles {
 // Negotiated by the device stream's hello (SocketStream.cpp), never assumed.
 inline bool enabled() { return caboose_gfxstream_guest_handles == 1; }
@@ -754,6 +756,7 @@ static void cabooseWatchSubmission(VkEncoder* enc, Stream* stream, VkQueue queue
         if (fence != VK_NULL_HANDLE) caboose::completion::tracker().fenceUntracked(caboose::handle_key(fence));
         for (const auto& signal : signals) caboose::completion::tracker().semaphoreUntracked(signal.first);
         if (events) caboose::completion::tracker().eventsUntracked(commandBuffers);
+        if (queries) caboose::completion::tracker().queriesUntracked(commandBuffers);
         if (gpuWrites) ResourceTracker::get()->cabooseSubmitCommandBuffersGpuWritten(commandBuffers, 0);
         return;
     }
@@ -765,12 +768,29 @@ static void cabooseWatchSubmission(VkEncoder* enc, Stream* stream, VkQueue queue
         caboose_deferred_destroy::sendReady(stream);
         return;
     }
+    // Caboose: with completion payloads (hello 0x200000) the watch also names the batch's ended
+    // occlusion and timestamp queries and the coherent memory it writes, which the phone
+    // captures for its record (caboose-bounded-memory/completion_payloads.h).
+    const bool cabooseCaptures = __atomic_load_n(&caboose_gfxstream_completion_payloads, __ATOMIC_ACQUIRE) == 1;
+    caboose::completion::Tracker::Captures captures;
+    if (cabooseCaptures && gpuWrites) {
+        for (auto write : ResourceTracker::get()->cabooseCommandBuffersGpuWrittenRanges(commandBuffers)) {
+            write.handle = get_host_u64_VkDeviceMemory(caboose::to_handle<VkDeviceMemory>(write.memory));
+            captures.memory.push_back(write);
+        }
+    }
     const uint64_t serial = caboose::completion::tracker().submitted(
         caboose::handle_key(fence), signals, caboose::handle_key(queue), caboose::handle_key(device),
-        commandBuffers);
+        commandBuffers, cabooseCaptures ? &captures : nullptr);
     if (gpuWrites) ResourceTracker::get()->cabooseSubmitCommandBuffersGpuWritten(commandBuffers, serial);
-    uint8_t* packet = stream->reserve(caboose::completion::kWatchPacketSize);
-    caboose::completion::encodeWatch(packet, get_host_u64_VkQueue(queue), serial);
+    if (!captures.entries.empty()) {
+        const auto watch2 = caboose::completion::payloads::encodeWatch2(get_host_u64_VkQueue(queue), serial,
+                                                                        captures.entries);
+        memcpy(stream->reserve(watch2.size()), watch2.data(), watch2.size());
+    } else {
+        uint8_t* packet = stream->reserve(caboose::completion::kWatchPacketSize);
+        caboose::completion::encodeWatch(packet, get_host_u64_VkQueue(queue), serial);
+    }
     caboose::memory::deferredDestroys.watched(caboose::handle_key(queue));
     stream->flush();
     caboose_deferred_destroy::sendReady(stream);
@@ -5074,6 +5094,11 @@ VkResult VkEncoder::vkCreateQueryPool(VkDevice device, const VkQueryPoolCreateIn
     } else {
         caboose_read_profile::read(stream, &vkCreateQueryPool_VkResult_return, sizeof(VkResult));
     }
+    // Caboose: an occlusion or timestamp pool's queries are captured with completion payloads
+    // (caboose-bounded-memory/completion_payloads.h).
+    if (vkCreateQueryPool_VkResult_return == VK_SUCCESS && pCreateInfo)
+        caboose::completion::tracker().queryPoolCreated(caboose::handle_key(*pQueryPool), cgen_var_3,
+                                                        caboose::handle_key(device), int32_t(pCreateInfo->queryType));
     ++encodeCount;
     if (0 == encodeCount % POOL_CLEAR_INTERVAL) {
         pool->freeAll();
@@ -5089,6 +5114,12 @@ void VkEncoder::vkDestroyQueryPool(VkDevice device, VkQueryPool queryPool,
     caboose::memory::queryResults.poolDestroyed(caboose::handle_key(queryPool));
     // The executor is gone: report device loss, and never read garbage replies into outputs.
     if (caboose::completion::lostCall(cabooseGenerationOf(device))) return;
+    // Caboose: the phone destroys a pool without a lock against capturing its queries, so the
+    // destroy goes once every record that captures it has arrived (completion_payloads.h).
+    if (caboose::completion::tracker().poolCaptured(caboose::handle_key(queryPool))) {
+        caboose::completion::WaitTimer timer{OP_vkDestroyQueryPool};
+        caboose::completion::tracker().waitPoolCaptures(caboose::handle_key(queryPool));
+    }
     bool queueSubmitWithCommandsEnabled =
         sFeatureBits & VULKAN_STREAM_FEATURE_QUEUE_SUBMIT_WITH_COMMANDS_BIT;
     if (!queueSubmitWithCommandsEnabled && doLock) this->lock();
@@ -5171,6 +5202,24 @@ VkResult VkEncoder::vkGetQueryPoolResults(VkDevice device, VkQueryPool queryPool
     (void)doLock;
     // The executor is gone: report device loss, and never read garbage replies into outputs.
     if (caboose::completion::lostCall(cabooseGenerationOf(device))) return VkResult(caboose::completion::lostResult());
+    // Caboose: with completion payloads the records brought the values of captured queries;
+    // they answer every flag and layout here, a WAIT by waiting for the records, without the
+    // encoder lock (caboose-bounded-memory/completion_payloads.h). What they cannot answer is
+    // asked on the device as before.
+    if (__atomic_load_n(&caboose_gfxstream_completion_payloads, __ATOMIC_ACQUIRE) == 1 &&
+        caboose::completion::feedActive.load(std::memory_order_acquire)) {
+        auto& cabooseTracker = caboose::completion::tracker();
+        const uint64_t caboosePool = caboose::handle_key(queryPool);
+        if ((flags & VK_QUERY_RESULT_WAIT_BIT) &&
+            cabooseTracker.queryValues(caboosePool, firstQuery, queryCount) ==
+                caboose::completion::Tracker::Values::Pending) {
+            caboose::completion::WaitTimer timer{OP_vkGetQueryPoolResults};
+            cabooseTracker.waitQueryValues(caboosePool, firstQuery, queryCount);
+        }
+        const int32_t cabooseLocal = cabooseTracker.queryResults(caboosePool, firstQuery, queryCount, dataSize,
+                                                                 pData, uint64_t(stride), uint32_t(flags));
+        if (cabooseLocal != caboose::completion::payloads::kAskDevice) return VkResult(cabooseLocal);
+    }
     bool queueSubmitWithCommandsEnabled =
         sFeatureBits & VULKAN_STREAM_FEATURE_QUEUE_SUBMIT_WITH_COMMANDS_BIT;
     if (!queueSubmitWithCommandsEnabled && doLock) this->lock();
