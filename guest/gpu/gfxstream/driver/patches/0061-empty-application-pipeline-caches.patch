From: Caboose <caboose@local>
Subject: [PATCH 61/61] Keep application pipeline caches empty in the guest

The phone keeps every pipeline a computer builds in a persistent cache and seeds it into each
pipeline cache an application creates, so vkGetPipelineCacheData returned all of it: Zink
saves one cache per GL program, read back about 14 MiB each time a program gained a
pipeline and sent it again as initial data at the next load. vkCreatePipelineCache now
drops the initial data, and vkGetPipelineCacheData answers in the guest with an empty cache
of the device (its VkPipelineCacheHeaderVersionOne), without a round trip. Pipelines still
come from the phone's cache.
---
diff --git a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
index 334cb3c..4b6a1be 100644
--- a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
+++ b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
@@ -1926,6 +1926,17 @@ VkBufferUsageFlags ResourceTracker::cabooseBufferUsage(VkDeviceMemory memory) {
     return found == info_VkDeviceMemory.end() ? 0 : found->second.socketBufferUsageMask;
 }
 
+bool ResourceTracker::caboosePipelineCacheHeader(VkDevice device, uint8_t header[32]) {
+    std::lock_guard<std::recursive_mutex> lock(mLock);
+    auto owner = info_VkDevice.find(device);
+    if (owner == info_VkDevice.end()) return false;
+    const VkPhysicalDeviceProperties& props = owner->second.props;
+    const uint32_t fields[4] = {32, VK_PIPELINE_CACHE_HEADER_VERSION_ONE, props.vendorID, props.deviceID};
+    memcpy(header, fields, sizeof(fields));
+    memcpy(header + sizeof(fields), props.pipelineCacheUUID, VK_UUID_SIZE);
+    return true;
+}
+
 bool ResourceTracker::cabooseMappedRange(VkDevice device, VkDeviceMemory memory,
                                          caboose::memory::Range& out) {
     std::lock_guard<std::recursive_mutex> lock(mLock);
diff --git a/src/gfxstream/guest/vulkan_enc/ResourceTracker.h b/src/gfxstream/guest/vulkan_enc/ResourceTracker.h
index 92b8921..47b5857 100644
--- a/src/gfxstream/guest/vulkan_enc/ResourceTracker.h
+++ b/src/gfxstream/guest/vulkan_enc/ResourceTracker.h
@@ -547,6 +547,8 @@ class ResourceTracker {
     // The usage of every buffer bound to `memory` (upload cache: staging memory is stored).
     VkBufferUsageFlags cabooseBufferUsage(VkDeviceMemory memory);
     bool cabooseMappedRange(VkDevice device, VkDeviceMemory memory, caboose::memory::Range& out);
+    // The header of an empty pipeline cache of `device` (VkPipelineCacheHeaderVersionOne).
+    bool caboosePipelineCacheHeader(VkDevice device, uint8_t header[32]);
     VkResult cabooseFlushCoherentMappings(VkEncoder* enc);
     VkResult cabooseInvalidateCoherentMappings(VkEncoder* enc, VkDevice device, uint32_t doLock);
     VkDevice cabooseGetQueueDevice(VkQueue queue);
diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
index 8c3ea16..af399e0 100644
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
+++ b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
@@ -8908,6 +8908,10 @@ VkResult VkEncoder::vkCreatePipelineCache(VkDevice device,
             (VkPipelineCacheCreateInfo*)pool->alloc(sizeof(const VkPipelineCacheCreateInfo));
         deepcopy_VkPipelineCacheCreateInfo(pool, VK_STRUCTURE_TYPE_MAX_ENUM, pCreateInfo,
                                            (VkPipelineCacheCreateInfo*)(local_pCreateInfo));
+        // An application's saved data is never sent: the phone's own cache holds its pipelines
+        // (vkGetPipelineCacheData).
+        local_pCreateInfo->initialDataSize = 0;
+        local_pCreateInfo->pInitialData = nullptr;
     }
     // Deepcopy intentionally skipped for `const VkAllocationCallbacks* pAllocator`
     local_pAllocator = nullptr;
@@ -9090,6 +9094,20 @@ VkResult VkEncoder::vkGetPipelineCacheData(VkDevice device, VkPipelineCache pipe
     (void)doLock;
     // The executor is gone: report device loss, and never read garbage replies into outputs.
     if (caboose::completion::lostCall()) { if (pDataSize) *pDataSize = 0; return VK_SUCCESS; }
+    // The phone keeps every pipeline this computer builds in a cache of its own, and seeds it
+    // into each cache an application creates: the application's copy is all of it, read back
+    // at each save and sent again at each load. An application's cache is empty here, in the
+    // guest; its pipelines still come from the phone's.
+    {
+        uint8_t header[32];
+        if (!pDataSize || !sResourceTracker->caboosePipelineCacheHeader(device, header))
+            return VK_ERROR_INITIALIZATION_FAILED;
+        if (!pData) { *pDataSize = sizeof(header); return VK_SUCCESS; }
+        if (*pDataSize < sizeof(header)) { *pDataSize = 0; return VK_INCOMPLETE; }
+        memcpy(pData, header, sizeof(header));
+        *pDataSize = sizeof(header);
+        return VK_SUCCESS;
+    }
     bool queueSubmitWithCommandsEnabled =
         sFeatureBits & VULKAN_STREAM_FEATURE_QUEUE_SUBMIT_WITH_COMMANDS_BIT;
     if (!queueSubmitWithCommandsEnabled && doLock) this->lock();
-- 
