+// After a queue submission that signals a fence or timeline semaphores, while the
+// completion feed runs: records its signal operations and sends COMPLETION_WATCH on the
+// same stream, so the phone reports the serial once the submission completes.
+static void cabooseAddTimelineSignals(const VkSubmitInfo& submit,
+                                      std::vector<std::pair<uint64_t, uint64_t>>* out) {
+    const VkTimelineSemaphoreSubmitInfo* timeline = nullptr;
+    for (auto* next = static_cast<const VkBaseInStructure*>(submit.pNext); next; next = next->pNext)
+        if (next->sType == VK_STRUCTURE_TYPE_TIMELINE_SEMAPHORE_SUBMIT_INFO)
+            timeline = reinterpret_cast<const VkTimelineSemaphoreSubmitInfo*>(next);
+    if (!timeline || !timeline->pSignalSemaphoreValues || !submit.pSignalSemaphores) return;
+    for (uint32_t i = 0; i < submit.signalSemaphoreCount && i < timeline->signalSemaphoreValueCount; ++i)
+        out->push_back({uint64_t(uintptr_t(submit.pSignalSemaphores[i])), timeline->pSignalSemaphoreValues[i]});
+}
+static void cabooseAddTimelineSignals(const VkSubmitInfo2& submit,
+                                      std::vector<std::pair<uint64_t, uint64_t>>* out) {
+    if (!submit.pSignalSemaphoreInfos) return;
+    for (uint32_t i = 0; i < submit.signalSemaphoreInfoCount; ++i)
+        out->push_back({uint64_t(uintptr_t(submit.pSignalSemaphoreInfos[i].semaphore)),
+                        submit.pSignalSemaphoreInfos[i].value});
+}
+template <class Stream, class Submit>
+static void cabooseWatchSubmission(Stream* stream, VkQueue queue, uint32_t submitCount,
+                                   const Submit* submits, VkFence fence) {
+    std::vector<std::pair<uint64_t, uint64_t>> signals;
+    for (uint32_t i = 0; submits && i < submitCount; ++i) cabooseAddTimelineSignals(submits[i], &signals);
+    if (fence == VK_NULL_HANDLE && signals.empty()) return;
+    if (!caboose::completion::feedActive.load(std::memory_order_acquire)) {
+        // Without a running feed nothing will report this submission: its objects are
+        // asked about on the device stream until they are reset.
+        if (fence != VK_NULL_HANDLE) caboose::completion::tracker().fenceUntracked(uint64_t(uintptr_t(fence)));
+        for (const auto& signal : signals) caboose::completion::tracker().semaphoreUntracked(signal.first);
+        return;
+    }
+    const uint64_t serial = caboose::completion::tracker().submitted(
+        uint64_t(uintptr_t(fence)), signals, uint64_t(uintptr_t(queue)),
+        uint64_t(uintptr_t(ResourceTracker::get()->cabooseGetQueueDevice(queue))));
+    uint8_t* packet = stream->reserve(caboose::completion::kWatchPacketSize);
+    caboose::completion::encodeWatch(packet, get_host_u64_VkQueue(queue), serial);
+    stream->flush();
+}
