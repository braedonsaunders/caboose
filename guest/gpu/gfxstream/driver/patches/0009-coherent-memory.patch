+void ResourceTracker::cabooseRecordBufferMemoryBind(VkBuffer buffer, VkDeviceMemory memory, VkDeviceSize memoryOffset) {
+    std::lock_guard<std::recursive_mutex> lock(mLock);
+    auto it = info_VkBuffer.find(buffer);
+    if (it != info_VkBuffer.end()) {
+        it->second.currentBacking = memory;
+        it->second.currentBackingOffset = memoryOffset;
+        it->second.currentBackingSize = it->second.createInfo.size;
+        auto memIt = info_VkDeviceMemory.find(memory);
+        if (memIt != info_VkDeviceMemory.end()) {
+            memIt->second.socketBufferUsageMask |= it->second.createInfo.usage;
+        }
+    }
+}
