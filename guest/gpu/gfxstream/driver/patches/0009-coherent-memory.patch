+VkResult ResourceTracker::cabooseInvalidateCoherentMappings(VkEncoder* enc, VkDevice device, uint32_t doLock) {
+    if (!enc || usingDirectMapping()) return VK_SUCCESS;
+    struct InvalidateItem {
+        VkDevice device;
+        VkMappedMemoryRange range;
+        uint64_t allocationSize;
+        uint32_t memoryTypeIndex;
+        VkBufferUsageFlags usageMask;
+    };
+    std::vector<InvalidateItem> mapped;
+    {
+        std::lock_guard<std::recursive_mutex> lock(mLock);
+        for (auto& [mem, info] : info_VkDeviceMemory) {
+            if (!info.socketShadow || !info.socketMapped || !info.socketGpuWritten || !info.device) continue;
+            if (device != VK_NULL_HANDLE && info.device != device) continue;
+            auto devIt = info_VkDevice.find(info.device);
+            if (devIt == info_VkDevice.end()) continue;
+            if (info.memoryTypeIndex >= devIt->second.memProps.memoryTypeCount) continue;
+            if (!(devIt->second.memProps.memoryTypes[info.memoryTypeIndex].propertyFlags &
+                  VK_MEMORY_PROPERTY_HOST_COHERENT_BIT)) {
+                continue;
+            }
+            const VkDeviceSize mapBegin = info.socketMapOffset;
+            const VkDeviceSize mapEnd = info.socketMapOffset + info.socketMapSize;
+            VkDeviceSize dirtyBegin = info.socketGpuWrittenBegin;
+            VkDeviceSize dirtyEnd = info.socketGpuWrittenEnd;
+            info.socketGpuWritten = false;
+            info.socketGpuWrittenBegin = 0;
+            info.socketGpuWrittenEnd = 0;
+            if (dirtyEnd <= dirtyBegin) {
+                dirtyBegin = mapBegin;
+                dirtyEnd = mapEnd;
+            }
+            if (dirtyBegin < mapBegin) dirtyBegin = mapBegin;
+            if (dirtyEnd > mapEnd) dirtyEnd = mapEnd;
+            if (dirtyEnd <= dirtyBegin) continue;
+            const VkDeviceSize atom = std::max<VkDeviceSize>(1, devIt->second.props.limits.nonCoherentAtomSize);
+            dirtyBegin = (dirtyBegin / atom) * atom;
+            if (dirtyBegin < mapBegin) dirtyBegin = mapBegin;
+            if (dirtyEnd < info.allocationSize) {
+                const VkDeviceSize rem = dirtyEnd % atom;
+                if (rem != 0) {
+                    dirtyEnd = std::min<VkDeviceSize>(info.allocationSize, dirtyEnd + (atom - rem));
+                }
+            }
+            if (dirtyEnd > mapEnd) dirtyEnd = mapEnd;
+            if (dirtyEnd <= dirtyBegin) continue;
+            VkMappedMemoryRange range{};
+            range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+            range.memory = mem;
+            range.offset = dirtyBegin;
+            range.size = dirtyEnd - dirtyBegin;
+            mapped.push_back(InvalidateItem{
+                info.device, range, info.allocationSize, info.memoryTypeIndex, info.socketBufferUsageMask
+            });
+        }
+    }
+    if (mapped.empty()) return VK_SUCCESS;
+    const uint64_t invOrd = gCabooseCoherentInvalidateOrdinal.fetch_add(1, std::memory_order_relaxed);
+    gCabooseCoherentPendingPostInvalidateLog.store(true, std::memory_order_relaxed);
+    uint64_t totalBytes = 0;
+    for (const auto& item : mapped) totalBytes += item.range.size;
+    if (invOrd < 64) {
+        std::fprintf(stderr,
+            "CABOOSE_COHERENT_INVALIDATE ordinal=%" PRIu64 " ranges=%zu total_bytes=%" PRIu64,
+            invOrd, mapped.size(), totalBytes);
+        for (size_t idx = 0; idx < mapped.size(); ++idx) {
+            const auto& it = mapped[idx];
+            std::fprintf(stderr,
+                " mem[%zu]=0x%" PRIx64 "(off=%" PRIu64 ",size=%" PRIu64 "B,alloc=%" PRIu64 "B,type=%u,usage=0x%x)",
+                idx, uint64_t(uintptr_t(it.range.memory)), uint64_t(it.range.offset),
+                uint64_t(it.range.size), it.allocationSize, it.memoryTypeIndex, unsigned(it.usageMask));
+        }
+        std::fputc('\n', stderr);
+        std::fflush(stderr);
+    }
+    size_t i = 0;
+    while (i < mapped.size()) {
+        VkDevice dev = mapped[i].device;
+        std::vector<VkMappedMemoryRange> batch;
+        for (size_t j = i; j < mapped.size(); ++j) {
+            if (mapped[j].device == dev) batch.push_back(mapped[j].range);
+        }
+        VkResult res = enc->vkInvalidateMappedMemoryRanges(
+            dev, static_cast<uint32_t>(batch.size()), batch.data(), doLock);
+        if (res != VK_SUCCESS) return res;
+        while (i < mapped.size() && mapped[i].device == dev) ++i;
+    }
+    return VK_SUCCESS;
+}
