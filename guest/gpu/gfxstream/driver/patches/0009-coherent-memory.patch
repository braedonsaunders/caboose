+VkResult ResourceTracker::cabooseFlushCoherentMappings(VkEncoder* enc) {
+    if (!enc || usingDirectMapping()) return VK_SUCCESS;
+    struct Candidate {
+        VkDevice device;
+        VkMappedMemoryRange range;
+        uint64_t allocationSize;
+        uint32_t memoryTypeIndex;
+        VkBufferUsageFlags usageMask;
+        bool gpuWrittenEver;
+    };
+    std::vector<Candidate> mapped;
+    uint32_t skippedReadbackCount = 0;
+    uint64_t skippedReadbackBytes = 0;
+    {
+        std::lock_guard<std::recursive_mutex> lock(mLock);
+        for (const auto& [mem, info] : info_VkDeviceMemory) {
+            if (!info.socketShadow || !info.socketMapped || !info.device) continue;
+            auto devIt = info_VkDevice.find(info.device);
+            if (devIt == info_VkDevice.end()) continue;
+            if (info.memoryTypeIndex >= devIt->second.memProps.memoryTypeCount) continue;
+            if (!(devIt->second.memProps.memoryTypes[info.memoryTypeIndex].propertyFlags &
+                  VK_MEMORY_PROPERTY_HOST_COHERENT_BIT)) {
+                continue;
+            }
+            if (info.socketBufferUsageMask == VK_BUFFER_USAGE_TRANSFER_DST_BIT) {
+                ++skippedReadbackCount;
+                skippedReadbackBytes += info.socketMapSize;
+                continue;
+            }
+            VkMappedMemoryRange range{};
+            range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+            range.memory = mem;
+            range.offset = info.socketMapOffset;
+            range.size = info.socketMapSize;
+            mapped.push_back(Candidate{
+                info.device, range, info.allocationSize, info.memoryTypeIndex,
+                info.socketBufferUsageMask, info.socketGpuWrittenEver
+            });
+        }
+    }
+    const uint64_t submitOrd = gCabooseCoherentSubmitOrdinal.fetch_add(1, std::memory_order_relaxed);
+    const bool postInv = gCabooseCoherentPendingPostInvalidateLog.exchange(false, std::memory_order_relaxed);
+    const bool shouldLog = (submitOrd < 64) ||
+        (postInv && gCabooseCoherentPostInvalidateLogged.fetch_add(1, std::memory_order_relaxed) < 64);
+    if (mapped.empty()) {
+        if (shouldLog) {
+            std::fprintf(stderr,
+                "CABOOSE_COHERENT_SUBMIT ordinal=%" PRIu64 " post_invalidate=%u candidates=0 skipped_readback=%u(%" PRIu64 "B) total_sent_bytes=0\n",
+                submitOrd, postInv ? 1u : 0u, skippedReadbackCount, skippedReadbackBytes);
+            std::fflush(stderr);
+        }
+        return VK_SUCCESS;
+    }
+    if (!shouldLog) {
+        size_t i = 0;
+        while (i < mapped.size()) {
+            VkDevice dev = mapped[i].device;
+            std::vector<VkMappedMemoryRange> batch;
+            for (size_t j = i; j < mapped.size(); ++j) {
+                if (mapped[j].device == dev) batch.push_back(mapped[j].range);
+            }
+            VkResult res = enc->vkFlushMappedMemoryRanges(
+                dev, static_cast<uint32_t>(batch.size()), batch.data(), true /* doLock */);
+            if (res != VK_SUCCESS) return res;
+            while (i < mapped.size() && mapped[i].device == dev) ++i;
+        }
+        return VK_SUCCESS;
+    }
+    uint64_t totalSent = 0;
+    std::vector<uint64_t> perCandidateSent(mapped.size(), 0);
+    for (size_t idx = 0; idx < mapped.size(); ++idx) {
+        caboose::memory::lastFlushCallSentBytes = 0;
+        VkResult res = enc->vkFlushMappedMemoryRanges(
+            mapped[idx].device, 1, &mapped[idx].range, true /* doLock */);
+        perCandidateSent[idx] = caboose::memory::lastFlushCallSentBytes;
+        totalSent += perCandidateSent[idx];
+        if (res != VK_SUCCESS) return res;
+    }
+    std::fprintf(stderr,
+        "CABOOSE_COHERENT_SUBMIT ordinal=%" PRIu64 " post_invalidate=%u candidates=%zu skipped_readback=%u(%" PRIu64 "B) total_sent_bytes=%" PRIu64,
+        submitOrd, postInv ? 1u : 0u, mapped.size(), skippedReadbackCount, skippedReadbackBytes, totalSent);
+    for (size_t idx = 0; idx < mapped.size(); ++idx) {
+        const auto& c = mapped[idx];
+        std::fprintf(stderr,
+            " mem[%zu]=0x%" PRIx64 "(map=%" PRIu64 "B,sent=%" PRIu64 "B,type=%u,usage=0x%x,gpuW=%u)",
+            idx, uint64_t(uintptr_t(c.range.memory)), uint64_t(c.range.size),
+            perCandidateSent[idx], c.memoryTypeIndex, unsigned(c.usageMask),
+            c.gpuWrittenEver ? 1u : 0u);
+    }
+    std::fputc('\n', stderr);
+    std::fflush(stderr);
+    return VK_SUCCESS;
+}
