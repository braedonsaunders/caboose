+void ResourceTracker::cabooseMarkBufferGpuWritten(VkBuffer buffer, VkDeviceSize dstOffset, VkDeviceSize size, bool requireReadbackBuffer) {
+    std::lock_guard<std::recursive_mutex> lock(mLock);
+    auto bufIt = info_VkBuffer.find(buffer);
+    if (bufIt == info_VkBuffer.end() || bufIt->second.currentBacking == VK_NULL_HANDLE) return;
+    if (requireReadbackBuffer) {
+        constexpr VkBufferUsageFlags kGpuConsumedMask =
+            VK_BUFFER_USAGE_VERTEX_BUFFER_BIT |
+            VK_BUFFER_USAGE_INDEX_BUFFER_BIT |
+            VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT |
+            VK_BUFFER_USAGE_STORAGE_BUFFER_BIT |
+            VK_BUFFER_USAGE_UNIFORM_TEXEL_BUFFER_BIT |
+            VK_BUFFER_USAGE_STORAGE_TEXEL_BUFFER_BIT |
+            VK_BUFFER_USAGE_INDIRECT_BUFFER_BIT |
+            VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
+        if ((bufIt->second.createInfo.usage & kGpuConsumedMask) != 0) {
+            return;
+        }
+    }
+    auto memIt = info_VkDeviceMemory.find(bufIt->second.currentBacking);
+    if (memIt == info_VkDeviceMemory.end()) return;
+    auto& memInfo = memIt->second;
+    if (!memInfo.allocationSize) return;
+    const VkDeviceSize bufSize = bufIt->second.createInfo.size;
+    const VkDeviceSize relBegin = dstOffset < bufSize ? dstOffset : 0;
+    VkDeviceSize byteLen = (size == VK_WHOLE_SIZE || (bufSize > relBegin && size > bufSize - relBegin))
+        ? (bufSize > relBegin ? bufSize - relBegin : memInfo.allocationSize)
+        : size;
+    if (!byteLen) byteLen = bufSize ? bufSize : memInfo.allocationSize;
+    VkDeviceSize absBegin = bufIt->second.currentBackingOffset + relBegin;
+    if (absBegin >= memInfo.allocationSize) absBegin = 0;
+    VkDeviceSize absEnd = byteLen > memInfo.allocationSize - absBegin
+        ? memInfo.allocationSize
+        : absBegin + byteLen;
+    if (absEnd <= absBegin) {
+        absBegin = 0;
+        absEnd = memInfo.allocationSize;
+    }
+    if (!memInfo.socketGpuWritten || memInfo.socketGpuWrittenEnd <= memInfo.socketGpuWrittenBegin) {
+        memInfo.socketGpuWrittenBegin = absBegin;
+        memInfo.socketGpuWrittenEnd = absEnd;
+    } else {
+        if (absBegin < memInfo.socketGpuWrittenBegin) memInfo.socketGpuWrittenBegin = absBegin;
+        if (absEnd > memInfo.socketGpuWrittenEnd) memInfo.socketGpuWrittenEnd = absEnd;
+    }
+    memInfo.socketGpuWritten = true;
+    memInfo.socketGpuWrittenEver = true;
+}
