From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Caboose <caboose@invalid>
Date: Sat, 31 Oct 2026 00:00:00 +0000
Subject: [PATCH 10/15] Advertise the client's memoryless type as ordinary
 device-local memory

MoltenVK omits its memoryless type from many transient images' memory type
bits, while ANGLE requires a lazily allocated type for every transient image
once one exists. The LAZILY_ALLOCATED property is removed from advertised
memory types.
---
 src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp    | 11 -----------
 .../guest/vulkan_enc/autogenerated/VkEncoder.cpp      |  6 ++++++
 2 files changed, 6 insertions(+), 11 deletions(-)

diff --git a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
index 8d7fa9d..cacd171 100644
--- a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
+++ b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
@@ -751,8 +751,6 @@ static void transformExternalResourceMemoryDedicatedRequirementsForGuest(
 
 void ResourceTracker::transformImageMemoryRequirementsForGuestLocked(VkImage image,
                                                                      VkMemoryRequirements* reqs) {
-    static std::atomic<int> cabooseImageReqLogs{0};
-
 #ifdef VK_USE_PLATFORM_FUCHSIA
     auto it = info_VkImage.find(image);
     if (it == info_VkImage.end()) return;
@@ -767,15 +765,6 @@ void ResourceTracker::transformImageMemoryRequirementsForGuestLocked(VkImage ima
     (void)image;
     (void)reqs;
 #endif
-    if (std::getenv("CABOOSE_GFXSTREAM_SOCKET") && cabooseImageReqLogs.fetch_add(1) < 400) {
-        auto it = info_VkImage.find(image);
-        fprintf(stderr, "CABOOSE_IMAGE_REQS bits=0x%x size=%llu align=%llu format=%d usage=0x%x tiling=%d flags=0x%x\n",
-                reqs->memoryTypeBits, (unsigned long long)reqs->size, (unsigned long long)reqs->alignment,
-                it != info_VkImage.end() ? (int)it->second.createInfo.format : -1,
-                it != info_VkImage.end() ? (unsigned)it->second.createInfo.usage : 0u,
-                it != info_VkImage.end() ? (int)it->second.createInfo.tiling : -1,
-                it != info_VkImage.end() ? (unsigned)it->second.createInfo.flags : 0u);
-    }
 }
 
 CoherentMemoryPtr ResourceTracker::freeCoherentMemoryLocked(VkDeviceMemory memory,
diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
index e9aa0d9..a28319e 100644
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
+++ b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
@@ -41,6 +41,12 @@
 #include "vk_util.h"
 static void caboosePromoteCoherentMemoryProperties(VkPhysicalDeviceMemoryProperties* props) {
     if (!props || !std::getenv("CABOOSE_GFXSTREAM_SOCKET")) return;
+    // MoltenVK omits its memoryless type from many transient images' memoryTypeBits, while
+    // ANGLE requires a lazily allocated type for every transient image once one exists.
+    // Advertise it as ordinary device-local memory.
+    for (uint32_t i = 0; i < props->memoryTypeCount; ++i) {
+        props->memoryTypes[i].propertyFlags &= ~VK_MEMORY_PROPERTY_LAZILY_ALLOCATED_BIT;
+    }
     for (uint32_t i = 0; i < props->memoryTypeCount; ++i) {
         if ((props->memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT) &&
             (props->memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT)) {
