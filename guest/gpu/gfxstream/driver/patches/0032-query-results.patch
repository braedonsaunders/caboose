From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Caboose <caboose@invalid>
Date: Sat, 31 Oct 2026 00:00:00 +0000
Subject: [PATCH 32/33] Answer query results without a round trip, and assign
 query pool handles

vkGetQueryPoolResults without VK_QUERY_RESULT_WAIT_BIT no longer waits for the
device: it sends its request and returns VK_NOT_READY, the reply is read with
the deferred replies, and the next identical call returns it
(caboose-bounded-memory/query_results.h). Resets of overlapping queries,
recorded, submitted or on the host, drop results fetched before them. With
hello feature 0x1000 the guest also assigns query pool handles, so
vkCreateQueryPool does not wait either.
---
 .../guest/vulkan_enc/ResourceTracker.cpp      |  7 ++
 .../vulkan_enc/autogenerated/VkEncoder.cpp    | 77 +++++++++++++++++--
 2 files changed, 78 insertions(+), 6 deletions(-)

diff --git a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
index 95f4e44..d015898 100644
--- a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
+++ b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
@@ -6977,6 +6977,10 @@ VkResult ResourceTracker::on_vkQueueSubmit(void* context, VkResult input_result,
         }
     }
 
+    // Query resets recorded in these command buffers make earlier fetched results stale.
+    for (uint32_t i = 0; i < submitCount; ++i)
+        for (uint32_t j = 0; pSubmits[i].pCommandBuffers && j < pSubmits[i].commandBufferCount; ++j)
+            caboose::memory::queryResults.submitted(uint64_t(uintptr_t(pSubmits[i].pCommandBuffers[j])));
     return on_vkQueueSubmitTemplate<VkSubmitInfo, VkSemaphore>(context, input_result, queue, submitCount,
                                                   pSubmits, fence);
 }
@@ -6986,6 +6990,9 @@ VkResult ResourceTracker::on_vkQueueSubmit2(void* context, VkResult input_result
                                             VkFence fence) {
     MESA_TRACE_SCOPE("on_vkQueueSubmit2");
     EmitGuestAndHostTraceMarker((VkEncoder*)context);
+    for (uint32_t i = 0; i < submitCount; ++i)
+        for (uint32_t j = 0; pSubmits[i].pCommandBufferInfos && j < pSubmits[i].commandBufferInfoCount; ++j)
+            caboose::memory::queryResults.submitted(uint64_t(uintptr_t(pSubmits[i].pCommandBufferInfos[j].commandBuffer)));
     return on_vkQueueSubmitTemplate<VkSubmitInfo2, VkSemaphoreSubmitInfo>(context, input_result, queue, submitCount,
                                                    pSubmits, fence);
 }
diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
index 04f94ff..bf6b5e1 100644
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
+++ b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
@@ -198,6 +198,8 @@ template <class T> static T* vk_extract_struct(void* start, VkStructureType sTyp
 extern "C" int caboose_gfxstream_guest_handles;
 extern "C" int caboose_gfxstream_guest_handle_arrays;
 extern "C" int caboose_gfxstream_device_fd;
+// 1 when the guest also assigns query pool handles (hello feature 0x1000, SocketStream.cpp).
+extern "C" int caboose_gfxstream_guest_query_pools;
 namespace caboose_guest_handles {
 // Negotiated by the device stream's hello (SocketStream.cpp), never assumed.
 inline bool enabled() { return caboose_gfxstream_guest_handles == 1; }
@@ -4336,7 +4338,10 @@ VkResult VkEncoder::vkCreateQueryPool(VkDevice device, const VkQueryPoolCreateIn
     if (!queueSubmitWithCommandsEnabled && doLock) this->lock();
     auto stream = mImpl->stream();
     caboose_read_profile::currentOpcode = OP_vkCreateQueryPool;
-    caboose::memory::deferredReplies.drain(this, stream);
+    // With guest-query-pools (hello 0x1000) the guest assigns the handle: no reply to wait for.
+    const bool cabooseGuestHandle = caboose_guest_handles::enabled() && caboose_gfxstream_guest_query_pools == 1 &&
+                                    pQueryPool;
+    if (!cabooseGuestHandle) caboose::memory::deferredReplies.drain(this, stream);
     auto pool = mImpl->pool();
     VkDevice local_device;
     VkQueryPoolCreateInfo* local_pCreateInfo;
@@ -4411,17 +4416,25 @@ VkResult VkEncoder::vkCreateQueryPool(VkDevice device, const VkQueryPoolCreateIn
     }
     /* is handle, possibly out */;
     uint64_t cgen_var_2;
+    if (cabooseGuestHandle) *pQueryPool = (VkQueryPool)(uintptr_t)caboose_guest_handles::next();
     *&cgen_var_2 = (uint64_t)((*pQueryPool));
     memcpy(*streamPtrPtr, (uint64_t*)&cgen_var_2, 8);
     *streamPtrPtr += 8;
     /* is handle, possibly out */;
     stream->setHandleMapping(sResourceTracker->createMapping());
     uint64_t cgen_var_3;
-    caboose_read_profile::read(stream, (uint64_t*)&cgen_var_3, 8);
+    if (cabooseGuestHandle) cgen_var_3 = cgen_var_2;
+    else caboose_read_profile::read(stream, (uint64_t*)&cgen_var_3, 8);
     stream->handleMapping()->mapHandles_u64_VkQueryPool(&cgen_var_3, (VkQueryPool*)pQueryPool, 1);
     stream->unsetHandleMapping();
     VkResult vkCreateQueryPool_VkResult_return = (VkResult)0;
-    caboose_read_profile::read(stream, &vkCreateQueryPool_VkResult_return, sizeof(VkResult));
+    if (cabooseGuestHandle) {
+        stream->flush();
+        caboose::memory::deferredReplies.reserve(this, stream, packetSize_vkCreateQueryPool);
+        caboose::memory::deferredReplies.addHandleCreate(this, cgen_var_2, packetSize_vkCreateQueryPool);
+    } else {
+        caboose_read_profile::read(stream, &vkCreateQueryPool_VkResult_return, sizeof(VkResult));
+    }
     ++encodeCount;
     if (0 == encodeCount % POOL_CLEAR_INTERVAL) {
         pool->freeAll();
@@ -4434,6 +4447,7 @@ VkResult VkEncoder::vkCreateQueryPool(VkDevice device, const VkQueryPoolCreateIn
 void VkEncoder::vkDestroyQueryPool(VkDevice device, VkQueryPool queryPool,
                                    const VkAllocationCallbacks* pAllocator, uint32_t doLock) {
     (void)doLock;
+    caboose::memory::queryResults.poolDestroyed(uint64_t(uintptr_t(queryPool)));
     // The executor is gone: report device loss, and never read garbage replies into outputs.
     if (caboose::completion::lostCall()) return;
     bool queueSubmitWithCommandsEnabled =
@@ -4523,7 +4537,43 @@ VkResult VkEncoder::vkGetQueryPoolResults(VkDevice device, VkQueryPool queryPool
     if (!queueSubmitWithCommandsEnabled && doLock) this->lock();
     auto stream = mImpl->stream();
     caboose_read_profile::currentOpcode = OP_vkGetQueryPoolResults;
-    caboose::memory::deferredReplies.drain(this, stream);
+    // Without WAIT the result may be VK_NOT_READY: the request's reply is read later, and
+    // the next identical call returns it (caboose-bounded-memory/query_results.h).
+    const bool cabooseAsync = !(flags & VK_QUERY_RESULT_WAIT_BIT) && caboose_guest_handles::enabled() &&
+                              caboose_gfxstream_device_fd >= 0 && caboose::memory::deferredReplies.singleEncoder(this);
+    const caboose::memory::QueryResults::Key cabooseKey{uint64_t(uintptr_t(queryPool)), firstQuery, queryCount,
+                                                        uint64_t(dataSize), uint64_t(stride), uint32_t(flags)};
+    std::shared_ptr<caboose::memory::QueryReply> cabooseEarlier;
+    if (cabooseAsync) {
+        const int fd = caboose_gfxstream_device_fd;
+        if (!caboose::memory::deferredReplies.drainAvailable(this, stream, [fd] {
+                int bytes = 0;
+                return ioctl(fd, FIONREAD, &bytes) == 0 && bytes > 0 ? size_t(bytes) : size_t(0);
+            })) {
+            if (!queueSubmitWithCommandsEnabled && doLock) this->unlock();
+            return VK_ERROR_DEVICE_LOST;
+        }
+        bool pending = false;
+        cabooseEarlier = caboose::memory::queryResults.take(cabooseKey, &pending);
+        if (pending) {
+            if (!queueSubmitWithCommandsEnabled && doLock) this->unlock();
+            return VK_NOT_READY;
+        }
+        if (cabooseEarlier) {
+            // Unavailable queries are left untouched unless the application asked for them.
+            const bool complete = cabooseEarlier->result == VK_SUCCESS ||
+                (flags & (VK_QUERY_RESULT_WITH_AVAILABILITY_BIT | VK_QUERY_RESULT_PARTIAL_BIT));
+            if (complete && pData && cabooseEarlier->data.size() == dataSize)
+                memcpy(pData, cabooseEarlier->data.data(), dataSize);
+            if (cabooseEarlier->result == VK_SUCCESS) {
+                // The application has its results: no further request until it asks again.
+                if (!queueSubmitWithCommandsEnabled && doLock) this->unlock();
+                return VK_SUCCESS;
+            }
+        }
+    } else {
+        caboose::memory::deferredReplies.drain(this, stream);
+    }
     auto pool = mImpl->pool();
     VkDevice local_device;
     VkQueryPool local_queryPool;
@@ -4594,9 +4644,20 @@ VkResult VkEncoder::vkGetQueryPoolResults(VkDevice device, VkQueryPool queryPool
     *streamPtrPtr += sizeof(VkDeviceSize);
     memcpy(*streamPtrPtr, (VkQueryResultFlags*)&local_flags, sizeof(VkQueryResultFlags));
     *streamPtrPtr += sizeof(VkQueryResultFlags);
-    caboose_read_profile::read(stream, (void*)pData, dataSize * sizeof(uint8_t));
     VkResult vkGetQueryPoolResults_VkResult_return = (VkResult)0;
-    caboose_read_profile::read(stream, &vkGetQueryPoolResults_VkResult_return, sizeof(VkResult));
+    if (cabooseAsync) {
+        auto reply = std::make_shared<caboose::memory::QueryReply>();
+        reply->data.resize(dataSize);
+        stream->flush();
+        caboose::memory::deferredReplies.reserve(this, stream, packetSize_vkGetQueryPoolResults);
+        caboose::memory::deferredReplies.addDataReply(this, reply, packetSize_vkGetQueryPoolResults);
+        caboose::memory::queryResults.requested(cabooseKey, std::move(reply));
+        vkGetQueryPoolResults_VkResult_return =
+            cabooseEarlier ? static_cast<VkResult>(cabooseEarlier->result) : VK_NOT_READY;
+    } else {
+        caboose_read_profile::read(stream, (void*)pData, dataSize * sizeof(uint8_t));
+        caboose_read_profile::read(stream, &vkGetQueryPoolResults_VkResult_return, sizeof(VkResult));
+    }
     ++encodeCount;
     if (0 == encodeCount % POOL_CLEAR_INTERVAL) {
         pool->freeAll();
@@ -6142,6 +6203,7 @@ VkResult VkEncoder::vkBeginCommandBuffer(VkCommandBuffer commandBuffer,
                                          const VkCommandBufferBeginInfo* pBeginInfo,
                                          uint32_t doLock) {
     (void)doLock;
+    caboose::memory::queryResults.commandBufferBegun(uint64_t(uintptr_t(commandBuffer)));
     // The executor is gone: report device loss, and never read garbage replies into outputs.
     if (caboose::completion::lostCall()) return VK_ERROR_DEVICE_LOST;
     static_assert(caboose::memory::timedRpcIndex(OP_vkBeginCommandBuffer) >= 0, "untimed RPC opcode");
@@ -7176,6 +7238,8 @@ void VkEncoder::vkCmdEndQuery(VkCommandBuffer commandBuffer, VkQueryPool queryPo
 void VkEncoder::vkCmdResetQueryPool(VkCommandBuffer commandBuffer, VkQueryPool queryPool,
                                     uint32_t firstQuery, uint32_t queryCount, uint32_t doLock) {
     (void)doLock;
+    caboose::memory::queryResults.recordReset(uint64_t(uintptr_t(commandBuffer)), uint64_t(uintptr_t(queryPool)),
+                                              firstQuery, queryCount);
     // The executor is gone: report device loss, and never read garbage replies into outputs.
     if (caboose::completion::lostCall()) return;
     bool queueSubmitWithCommandsEnabled =
@@ -15522,6 +15586,7 @@ void VkEncoder::vkDestroySamplerYcbcrConversion(VkDevice device,
 void VkEncoder::vkResetQueryPool(VkDevice device, VkQueryPool queryPool, uint32_t firstQuery,
                                  uint32_t queryCount, uint32_t doLock) {
     (void)doLock;
+    caboose::memory::queryResults.reset(uint64_t(uintptr_t(queryPool)), firstQuery, queryCount);
     // The executor is gone: report device loss, and never read garbage replies into outputs.
     if (caboose::completion::lostCall()) return;
     bool queueSubmitWithCommandsEnabled =
