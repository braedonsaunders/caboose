From: Caboose <caboose@local>
Subject: [PATCH 56/56] Clear staged command buffer query/event state on begin and return handles on create after loss

In staged command buffer mode, ResourceTracker::on_vkBeginCommandBuffer and
VkEncoder::cabooseBeginCommandBufferDeferred bypassed QueryResults::commandBufferBegun,
allowing recorded query resets on reused command buffers to accumulate past kMaxRecorded
and wipe cached query results for the entire pool on every submit. Also hook
gfxstream_vk_CmdSetEvent2KHR and gfxstream_vk_CmdResetEvent2KHR into the completion
tracker, and return mapped guest handles on device-level vkCreate*/vkAllocate* calls
after executor loss so callers like Zink only observe VK_ERROR_DEVICE_LOST on submits
and waits rather than dereferencing null handles from creation calls.
---
diff --git a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
index 20a62c9..b01f633 100644
--- a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
+++ b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
@@ -1122,6 +1122,8 @@ void ResourceTracker::unregister_VkPrivateDataSlot(VkPrivateDataSlot privateSlot
 }
 
 void ResourceTracker::unregister_VkCommandBuffer(VkCommandBuffer commandBuffer) {
+    caboose::memory::queryResults.commandBufferBegun(caboose::handle_key(commandBuffer));
+    caboose::completion::tracker().commandBufferBegun(caboose::handle_key(commandBuffer));
     {
         std::lock_guard<std::recursive_mutex> lock(mLock);
         mCabooseCommandDirtyRanges.erase(caboose::handle_key(commandBuffer));
@@ -9120,6 +9122,8 @@ VkResult ResourceTracker::on_vkBeginCommandBuffer(void* context, VkResult input_
     (void)context;
     (void)input_result;
 
+    caboose::memory::queryResults.commandBufferBegun(caboose::handle_key(commandBuffer));
+    caboose::completion::tracker().commandBufferBegun(caboose::handle_key(commandBuffer));
     {
         std::lock_guard<std::recursive_mutex> lock(mLock);
         mCabooseCommandDirtyRanges.erase(caboose::handle_key(commandBuffer));
@@ -9217,6 +9221,8 @@ VkResult ResourceTracker::on_vkResetCommandBuffer(void* context, VkResult input_
     VkEncoder* enc = (VkEncoder*)context;
     (void)input_result;
 
+    caboose::memory::queryResults.commandBufferBegun(caboose::handle_key(commandBuffer));
+    caboose::completion::tracker().commandBufferBegun(caboose::handle_key(commandBuffer));
     {
         std::lock_guard<std::recursive_mutex> lock(mLock);
         mCabooseCommandDirtyRanges.erase(caboose::handle_key(commandBuffer));
@@ -9775,6 +9781,8 @@ void ResourceTracker::resetCommandPoolStagingInfo(VkCommandPool commandPool) {
     if (!p) return;
 
     forAllObjects(p->subObjects, [this](void* commandBuffer) {
+        caboose::memory::queryResults.commandBufferBegun(caboose::handle_key((VkCommandBuffer)commandBuffer));
+        caboose::completion::tracker().commandBufferBegun(caboose::handle_key((VkCommandBuffer)commandBuffer));
         {
             std::lock_guard<std::recursive_mutex> lock(this->mLock);
             this->mCabooseCommandDirtyRanges.erase(caboose::handle_key((VkCommandBuffer)commandBuffer));
