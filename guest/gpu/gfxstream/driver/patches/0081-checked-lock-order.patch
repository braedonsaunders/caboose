From: Caboose <caboose@local>
Subject: [PATCH 81/85] Check the tracker and encoder locks against the driver's lock hierarchy

The tracker's lock and each encoder's stream lock report every acquisition to the lock-order
checker (caboose-bounded-memory/lock_order.h), which with CABOOSE_LOCK_ORDER set reports a lock
taken above one already held, so an inversion is found where it happens rather than as a
deadlock. Unset, each acquisition costs one load.
---
diff --git a/src/gfxstream/guest/vulkan_enc/ResourceTracker.h b/src/gfxstream/guest/vulkan_enc/ResourceTracker.h
--- a/src/gfxstream/guest/vulkan_enc/ResourceTracker.h
+++ b/src/gfxstream/guest/vulkan_enc/ResourceTracker.h
@@ -22,6 +22,7 @@
  */
 #pragma once
 
+#include "caboose-bounded-memory/lock_order.h"
 #include <vulkan/vulkan.h>
 
 #include <atomic>
@@ -1045,7 +1046,9 @@
 
     void sendGuestInfo(VkEncoder* encoder);
 
-    std::recursive_mutex mLock;
+    // Caboose: checked against the driver's lock hierarchy (caboose-bounded-memory/lock_order.h).
+    using TrackerMutex = caboose::lock_order::Mutex<std::recursive_mutex, caboose::lock_order::kTracker>;
+    TrackerMutex mLock;
 
     // A LINEAR dma-buf imported as device memory on the socket transport, mapped read-only.
     struct CabooseImport {
