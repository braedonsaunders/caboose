+
+void VkEncoder::cabooseFlushPresentationRetirements() {
+    this->lock();
+    std::lock_guard<std::mutex> epochLock(caboose::completion::transportEpochMutex);
+    const auto generation=caboose::completion::executorGeneration.load(std::memory_order_acquire);
+    auto ready=caboose::memory::presentationRetirement.takeReady(generation);
+    if (!caboose::completion::executorLost.load(std::memory_order_acquire) &&
+        generation==caboose::completion::executorGeneration.load(std::memory_order_acquire)) {
+        auto stream=mImpl->stream();
+        for (const auto& packet:ready.send)
+            memcpy(stream->reserve(packet.size),packet.bytes.data(),packet.size);
+        if (!ready.send.empty()) stream->flush();
+    }
+    for (const auto& packet:ready.send)
+        if (packet.allocation) caboose::memory::asyncAllocationBudget.freed(packet.allocation);
+    this->unlock();
 }
 
