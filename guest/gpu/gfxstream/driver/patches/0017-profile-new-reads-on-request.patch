From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Caboose <caboose@invalid>
Date: Sat, 31 Oct 2026 00:00:00 +0000
Subject: [PATCH 17/17] Time replies only when the read profile is on

The non-aborting reply read and the deferred-reply drain observer added with
asynchronous creates are timed only with CABOOSE_READ_PROFILE=1, like every
other reply read.
---
 src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
index 05f0de1..b47dbbc 100644
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
+++ b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
@@ -94,6 +94,7 @@ template <class S, class P> inline void read(S* stream, P* ptr, size_t size) {
 }
 // A non-aborting reply read, timed like read().
 template <class S, class P> inline bool tryRead(S* stream, P* ptr, size_t size) {
+    if (!enabled()) return stream->tryRead(ptr, size);
     auto t0 = std::chrono::steady_clock::now();
     bool ok = stream->tryRead(ptr, size);
     note(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0).count());
@@ -185,6 +186,7 @@ inline uint64_t next() {
 }  // namespace caboose_guest_handles
 // Drains of earlier deferred replies count toward CABOOSE_READ_PROFILE as `drainN`.
 static const bool caboose_drain_profiled = [] {
+    if (!caboose_read_profile::enabled()) return false;
     caboose::memory::drainObserver = [](uint64_t us) {
         caboose_read_profile::note(us, caboose_read_profile::kDrain);
     };
