From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Caboose <caboose@invalid>
Date: Sat, 31 Oct 2026 00:00:00 +0000
Subject: [PATCH 27/28] Hold device loss until a new executor arrives, with
 CABOOSE_GPU_ON_LOSS=pause

An application launched with CABOOSE_GPU_ON_LOSS=pause must not restart while
the phone is away. Its devices cannot survive the executor, so the fence and
timeline waits and status queries that would report the loss first wait until
the broker has a new executor (caboose-bounded-memory/completion_feed.h
awaitExecutorReturn), then report VK_ERROR_DEVICE_LOST; the application
recreates its device on the returned phone.
---
 src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp         | 2 ++
 src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp | 6 +++++-
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
index 805447d..95f4e44 100644
--- a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
+++ b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
@@ -5672,6 +5672,7 @@ VkResult ResourceTracker::on_vkGetFenceStatus(void* context, VkResult input_resu
             case caboose::completion::Tracker::Answer::NotYet:
                 return VK_NOT_READY;
             case caboose::completion::Tracker::Answer::DeviceLost:
+                caboose::completion::awaitExecutorReturn();
                 return VK_ERROR_DEVICE_LOST;
             case caboose::completion::Tracker::Answer::AskDevice:
                 break;
@@ -5754,6 +5755,7 @@ VkResult ResourceTracker::on_vkWaitForFences(void* context, VkResult, VkDevice d
             case caboose::completion::Tracker::Answer::NotYet:
                 return VK_TIMEOUT;
             case caboose::completion::Tracker::Answer::DeviceLost:
+                caboose::completion::awaitExecutorReturn();
                 return VK_ERROR_DEVICE_LOST;
             case caboose::completion::Tracker::Answer::AskDevice:
                 break;
diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
index 9c4f029..e585446 100644
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
+++ b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
@@ -15267,7 +15267,10 @@ VkResult VkEncoder::vkGetSemaphoreCounterValue(VkDevice device, VkSemaphore sema
     (void)doLock;
     // A tracked timeline's completed value is known here: no round trip.
     if (caboose::completion::feedActive.load(std::memory_order_acquire) && pValue) {
-        if (caboose::completion::tracker().deviceLost(uint64_t(uintptr_t(device)))) return VK_ERROR_DEVICE_LOST;
+        if (caboose::completion::tracker().deviceLost(uint64_t(uintptr_t(device)))) {
+            caboose::completion::awaitExecutorReturn();
+            return VK_ERROR_DEVICE_LOST;
+        }
         if (caboose::completion::tracker().timelineValue(uint64_t(uintptr_t(semaphore)), pValue))
             return VK_SUCCESS;
     }
@@ -15357,6 +15360,7 @@ VkResult VkEncoder::vkWaitSemaphores(VkDevice device, const VkSemaphoreWaitInfo*
             case caboose::completion::Tracker::Answer::NotYet:
                 return VK_TIMEOUT;
             case caboose::completion::Tracker::Answer::DeviceLost:
+                caboose::completion::awaitExecutorReturn();
                 return VK_ERROR_DEVICE_LOST;
             case caboose::completion::Tracker::Answer::AskDevice:
                 break;
