From: Caboose <caboose@local>
Subject: [PATCH 70/71] Ask the executor for its instance version once per connection

The loader and Zink ask vkEnumerateInstanceVersion at every instance they make, and each
ask drained deferred replies and waited for its own: six waits in one Zink GL
initialization. The answer is the connected executor's and is kept in the capability
cache's process-local answers, which end with the connection.
---
diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
index b1878f4..bed7df5 100644
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
+++ b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
@@ -13958,7 +13958,20 @@ void VkEncoder::vkCmdEndRenderPass(VkCommandBuffer commandBuffer, uint32_t doLoc
 
 #endif
 #ifdef VK_BASE_VERSION_1_1
+// Instance-constant: the connected executor's instance version, asked once per connection
+// (the capability cache's process-local answers end with it). A loader and Zink ask it at
+// every instance they make, and each ask waited for a reply.
 VkResult VkEncoder::vkEnumerateInstanceVersion(uint32_t* pApiVersion, uint32_t doLock) {
+    const std::string cabooseKey = caboose::memory::StaticQueryCache::key(uint32_t(OP_vkEnumerateInstanceVersion));
+    const bool cabooseCacheable = pApiVersion && !caboose::completion::lostCall();
+    if (cabooseCacheable && caboose::memory::staticQueryCache.lookup(cabooseKey, pApiVersion)) return VK_SUCCESS;
+    const VkResult result = vkEnumerateInstanceVersion_cabooseAsk(pApiVersion, doLock);
+    if (cabooseCacheable && result == VK_SUCCESS && !caboose::completion::executorLost.load(std::memory_order_acquire))
+        caboose::memory::staticQueryCache.store(cabooseKey, *pApiVersion);
+    return result;
+}
+
+VkResult VkEncoder::vkEnumerateInstanceVersion_cabooseAsk(uint32_t* pApiVersion, uint32_t doLock) {
     (void)doLock;
     // The executor is gone: report device loss, and never read garbage replies into outputs.
     if (caboose::completion::lostCall()) return VK_ERROR_DEVICE_LOST;
diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.h b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.h
index 6fc5b8c..b001a87 100644
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.h
+++ b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.h
@@ -471,6 +471,7 @@ class VkEncoder {
 #endif
 #ifdef VK_BASE_VERSION_1_1
     VkResult vkEnumerateInstanceVersion(uint32_t* pApiVersion, uint32_t doLock);
+    VkResult vkEnumerateInstanceVersion_cabooseAsk(uint32_t* pApiVersion, uint32_t doLock);
     VkResult vkBindBufferMemory2(VkDevice device, uint32_t bindInfoCount,
                                  const VkBindBufferMemoryInfo* pBindInfos, uint32_t doLock);
     VkResult vkBindImageMemory2(VkDevice device, uint32_t bindInfoCount,
