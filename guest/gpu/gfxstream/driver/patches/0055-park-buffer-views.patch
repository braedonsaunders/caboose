 inline thread_local bool destroying = false;
@@ -347,6 +352,80 @@ inline std::vector<uint64_t> take(VkDevice device, VkImage image, bool forgetIma
     }
     return out;
 }
+inline bool keyOfBuffer(VkDevice device, const VkBufferViewCreateInfo* info, BufferKey* key) {
+    if (!info) return false;
+    uint64_t usage = 0;
+    for (auto* next = static_cast<const VkBaseInStructure*>(info->pNext); next; next = next->pNext) {
+        if (next->sType == VK_STRUCTURE_TYPE_BUFFER_USAGE_FLAGS_2_CREATE_INFO_KHR) {
+            usage = reinterpret_cast<const VkBufferUsageFlags2CreateInfoKHR*>(next)->usage;
+        } else {
+            return false;
+        }
+    }
+    *key = {caboose::handle_key(device), caboose::handle_key(info->buffer), uint64_t(info->flags),
+            uint64_t(info->format), uint64_t(info->offset), uint64_t(info->range), usage};
+    return true;
+}
+inline void bufferCreated(VkBuffer buffer) {
+    std::lock_guard<std::mutex> lock(state.mutex);
+    state.buffers.insert(caboose::handle_key(buffer));
+}
+inline bool acquireBuffer(VkDevice device, const VkBufferViewCreateInfo* info, VkBufferView* view) {
+    BufferKey key;
+    if (!view || !keyOfBuffer(device, info, &key)) return false;
+    std::lock_guard<std::mutex> lock(state.mutex);
+    auto it = state.parkedBuffers.find(key);
+    if (it == state.parkedBuffers.end() || it->second.empty()) return false;
+    uint64_t handle = it->second.back();
+    it->second.pop_back();
+    if (it->second.empty()) state.parkedBuffers.erase(it);
+    --state.parkedBufferCount;
+    state.liveBuffers[handle] = key;
+    *view = caboose::to_handle<VkBufferView>(handle);
+    return true;
+}
+inline void createdBuffer(VkDevice device, const VkBufferViewCreateInfo* info, VkBufferView view) {
+    BufferKey key;
+    if (!keyOfBuffer(device, info, &key)) return;
+    std::lock_guard<std::mutex> lock(state.mutex);
+    if (state.buffers.count(key[1])) state.liveBuffers[caboose::handle_key(view)] = key;
+}
+inline bool parkBuffer(VkBufferView view) {
+    if (destroying || !view) return false;
+    std::lock_guard<std::mutex> lock(state.mutex);
+    uint64_t handle = caboose::handle_key(view);
+    auto it = state.liveBuffers.find(handle);
+    if (it == state.liveBuffers.end()) return false;
+    BufferKey key = it->second;
+    state.liveBuffers.erase(it);
+    auto& slot = state.parkedBuffers[key];
+    if (slot.size() >= kPerKey || state.parkedBufferCount >= kTotal || !state.buffers.count(key[1])) {
+        if (slot.empty()) state.parkedBuffers.erase(key);
+        return false;
+    }
+    slot.push_back(handle);
+    ++state.parkedBufferCount;
+    return true;
+}
+inline std::vector<uint64_t> takeBuffers(VkDevice device, VkBuffer buffer, bool forgetBuffer) {
+    std::vector<uint64_t> out;
+    std::lock_guard<std::mutex> lock(state.mutex);
+    for (auto it = state.parkedBuffers.begin(); it != state.parkedBuffers.end();) {
+        if (it->first[0] == caboose::handle_key(device) && (!buffer || it->first[1] == caboose::handle_key(buffer))) {
+            out.insert(out.end(), it->second.begin(), it->second.end());
+            state.parkedBufferCount -= it->second.size();
+            it = state.parkedBuffers.erase(it);
+        } else {
+            ++it;
+        }
+    }
+    if (forgetBuffer && buffer) {
+        state.buffers.erase(caboose::handle_key(buffer));
+        for (auto it = state.liveBuffers.begin(); it != state.liveBuffers.end();)
+            it = it->second[1] == caboose::handle_key(buffer) ? state.liveBuffers.erase(it) : std::next(it);
+    }
+    return out;
+}
 }  // namespace caboose_view_cache
