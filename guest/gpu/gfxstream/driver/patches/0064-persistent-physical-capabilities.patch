+    const auto cacheEpoch=caboose::memory::staticQueryCache.epoch();
+    VkPhysicalDeviceIDProperties identityLocal{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ID_PROPERTIES};
+    auto* identityProps=vk_find_struct(pProperties,PHYSICAL_DEVICE_ID_PROPERTIES);
+    if (!identityProps) {
