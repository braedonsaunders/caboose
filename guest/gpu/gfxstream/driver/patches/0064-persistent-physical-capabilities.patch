     enc->vkGetPhysicalDeviceProperties2(physicalDevice, pProperties, false /* no lock */);
+    // Physical capability answers belong to the actual backend identity before the
+    // guest-facing driver name/version is projected below. Never key by a process handle.
+    if (!caboose::completion::executorLost.load(std::memory_order_acquire)) {
+        const auto& props=pProperties->properties;
+        std::string identity="caboose-format-cache-v1:" CABOOSE_DRIVER_SOURCE_ID;
+        auto put=[&identity](const auto& value) {
+            identity.append(reinterpret_cast<const char*>(&value),sizeof(value));
+        };
+        put(uint32_t(sizeof(void*))); put(props.apiVersion); put(props.driverVersion);
+        put(props.vendorID); put(props.deviceID); put(props.deviceType);
+        put(props.pipelineCacheUUID); put(identityProps->deviceUUID); put(identityProps->driverUUID);
+        put(hostDriverProps->driverID); put(hostDriverProps->conformanceVersion);
+        identity.append(props.deviceName,strnlen(props.deviceName,sizeof(props.deviceName))); identity+='\0';
+        identity.append(hostDriverProps->driverName,strnlen(hostDriverProps->driverName,sizeof(hostDriverProps->driverName))); identity+='\0';
+        identity.append(hostDriverProps->driverInfo,strnlen(hostDriverProps->driverInfo,sizeof(hostDriverProps->driverInfo))); identity+='\0';
+        const char* socket=std::getenv("CABOOSE_GFXSTREAM_SOCKET");
+        std::string directory;
+        if (socket && socket[0]=='/' && std::strrchr(socket,'/')!=socket) {
+            directory=std::string(socket,size_t(std::strrchr(socket,'/')-socket))+"/capabilities";
+        } else {
+            const char* cache=std::getenv("XDG_CACHE_HOME");
+            const char* home=std::getenv("HOME");
+            directory=cache && *cache=='/' ? std::string(cache)
+                : home && *home=='/' ? std::string(home)+"/.cache" : std::string();
+            if (!directory.empty()) { mkdir(directory.c_str(),0700); directory+="/caboose-gpu"; }
+        }
+        if (!directory.empty() && mkdir(directory.c_str(),0700)!=0 && errno!=EEXIST) directory.clear();
+        caboose::memory::staticQueryCache.identify(caboose::handle_key(physicalDevice),identity,directory,cacheEpoch);
+    }
+    if (identityProps==&identityLocal) vk_filter_struct(pProperties,PHYSICAL_DEVICE_ID_PROPERTIES);
+
 
     // Filter driver properties from the pNext chain if it was appended locally
     if (hostDriverProps == &driverPropsLocal) {
