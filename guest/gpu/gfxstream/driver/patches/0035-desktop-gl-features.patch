From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Caboose <caboose@invalid>
Date: Sat, 31 Oct 2026 00:00:00 +0000
Subject: [PATCH 35/35] Offer logic operations and custom border colours the
 host GPU lacks

Zink needs logicOp and VK_EXT_custom_border_color among its base requirements
for desktop OpenGL; Metal, under the phone's MoltenVK, has neither. When the
host lacks them the driver offers both and keeps them from the host: the
feature queries report them, device creation leaves them out, a pipeline's
logic operation is dropped, and a sampler's custom border colour becomes the
nearest built-in one (caboose-features/feature_emulation.h). A host that has
them is used as before.
---
 src/gfxstream/guest/vulkan/gfxstream_vk_device.cpp | 27 +++++++++++
 src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp | 56 +++++++++++++++++++++-
 src/gfxstream/guest/vulkan_enc/ResourceTracker.h   | 10 ++++
 .../guest/vulkan_enc/autogenerated/VkEncoder.cpp   | 10 ++++
 .../guest/vulkan_enc/autogenerated/func_table.cpp  |  1 +
 5 files changed, 103 insertions(+), 1 deletion(-)

diff --git a/src/gfxstream/guest/vulkan/gfxstream_vk_device.cpp b/src/gfxstream/guest/vulkan/gfxstream_vk_device.cpp
index f601e9a..52b3c7d 100644
--- a/src/gfxstream/guest/vulkan/gfxstream_vk_device.cpp
+++ b/src/gfxstream/guest/vulkan/gfxstream_vk_device.cpp
@@ -220,6 +220,11 @@ static std::vector<const char*> filteredDeviceExtensionNames(
             } else {
                 retList.push_back(extName);
             }
+        } else if (!strncmp(extName, caboose::features::kCustomBorderColor, VK_MAX_EXTENSION_NAME_SIZE)) {
+            // Offered by the guest when the host lacks it: the host never sees it.
+            if (!gfxstream::vk::ResourceTracker::get()->cabooseEmulatesCustomBorderColor()) {
+                retList.push_back(extName);
+            }
         } else if (!isGuestEmulatedDeviceExtension(extName)) {
             retList.push_back(extName);
         }
@@ -704,6 +709,24 @@ VkResult gfxstream_vk_CreateDevice(VkPhysicalDevice physicalDevice,
 
     VkBaseOutStructure* extractedProvokingVertex = caboose_extract_struct(
         &localCreateInfo, VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROVOKING_VERTEX_FEATURES_EXT);
+    // Features the guest offers on a host that lacks them are not asked of the host.
+    auto* tracker = gfxstream::vk::ResourceTracker::get();
+    const bool emulatedLogicOp =
+        tracker->cabooseEmulatesLogicOp(gfxstream_physicalDevice->internal_object);
+    VkPhysicalDeviceFeatures hostFeatures;
+    if (emulatedLogicOp && localCreateInfo.pEnabledFeatures) {
+        hostFeatures = *localCreateInfo.pEnabledFeatures;
+        hostFeatures.logicOp = VK_FALSE;
+        localCreateInfo.pEnabledFeatures = &hostFeatures;
+    }
+    VkPhysicalDeviceFeatures2* enabledFeatures2 =
+        vk_find_struct(&localCreateInfo, PHYSICAL_DEVICE_FEATURES_2);
+    const VkBool32 requestedLogicOp = enabledFeatures2 ? enabledFeatures2->features.logicOp : VK_FALSE;
+    if (emulatedLogicOp && enabledFeatures2) enabledFeatures2->features.logicOp = VK_FALSE;
+    VkBaseOutStructure* extractedBorderColor = tracker->cabooseEmulatesCustomBorderColor()
+        ? caboose_extract_struct(&localCreateInfo,
+                                 VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_CUSTOM_BORDER_COLOR_FEATURES_EXT)
+        : nullptr;
     auto vkEnc = gfxstream::vk::ResourceTracker::getThreadLocalEncoder();
     result = vkEnc->vkCreateDevice(gfxstream_physicalDevice->internal_object, &localCreateInfo,
                                    pAllocator, &gfxstream_device->internal_object,
@@ -721,6 +744,10 @@ VkResult gfxstream_vk_CreateDevice(VkPhysicalDevice physicalDevice,
     if (extractedProvokingVertex) {
         __vk_append_struct(&localCreateInfo, extractedProvokingVertex);
     }
+    if (extractedBorderColor) {
+        __vk_append_struct(&localCreateInfo, extractedBorderColor);
+    }
+    if (enabledFeatures2) enabledFeatures2->features.logicOp = requestedLogicOp;
     if (result != VK_SUCCESS) {
         vk_free(pMesaAllocator, gfxstream_device);
         return result;
diff --git a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
index 59d1f38..3144d1f 100644
--- a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
+++ b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
@@ -2331,6 +2331,9 @@ VkResult ResourceTracker::on_vkEnumerateDeviceExtensionProperties(
     if (getHostDeviceExtensionIndex("VK_EXT_provoking_vertex") == -1) {
         filteredExts.push_back(VkExtensionProperties{"VK_EXT_provoking_vertex", 1});
     }
+    if (cabooseEmulatesCustomBorderColor()) {
+        filteredExts.push_back(VkExtensionProperties{"VK_EXT_custom_border_color", 12});
+    }
 
 #if defined(VK_USE_PLATFORM_ANDROID_KHR) || DETECT_OS_LINUX
     bool hostSupportsExternalFenceFd =
@@ -2556,6 +2559,36 @@ VkResult ResourceTracker::on_vkEnumeratePhysicalDevices(void* context, VkResult,
     }
 }
 
+void ResourceTracker::cabooseOfferFeatures(VkPhysicalDeviceFeatures* features) {
+    if (!features) return;
+    mCabooseHostLogicOp.store(features->logicOp ? 1 : 0, std::memory_order_relaxed);
+    features->logicOp = VK_TRUE;
+}
+
+void ResourceTracker::cabooseOfferFeatures2(VkPhysicalDeviceFeatures2* features,
+                                            VkPhysicalDeviceCustomBorderColorFeaturesEXT* borderColor) {
+    if (!features) return;
+    cabooseOfferFeatures(&features->features);
+    if (borderColor) {
+        borderColor->customBorderColors = VK_TRUE;
+        borderColor->customBorderColorWithoutFormat = VK_TRUE;
+        __vk_append_struct(features, borderColor);
+    }
+}
+
+bool ResourceTracker::cabooseEmulatesLogicOp(VkPhysicalDevice physicalDevice) {
+    if (mCabooseHostLogicOp.load(std::memory_order_relaxed) < 0 && physicalDevice) {
+        VkPhysicalDeviceFeatures host{};
+        getThreadLocalEncoder()->vkGetPhysicalDeviceFeatures(physicalDevice, &host, true /* do lock */);
+        mCabooseHostLogicOp.store(host.logicOp ? 1 : 0, std::memory_order_relaxed);
+    }
+    return mCabooseHostLogicOp.load(std::memory_order_relaxed) == 0;
+}
+
+bool ResourceTracker::cabooseEmulatesCustomBorderColor() const {
+    return getHostDeviceExtensionIndex(caboose::features::kCustomBorderColor) == -1;
+}
+
 void ResourceTracker::on_vkGetPhysicalDeviceFeatures2(void*, VkPhysicalDevice,
                                                       VkPhysicalDeviceFeatures2* pFeatures) {
     if (pFeatures) {
@@ -2594,6 +2627,10 @@ void ResourceTracker::on_vkGetPhysicalDeviceProperties2(void* context,
         pProperties, VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PCI_BUS_INFO_PROPERTIES_EXT);
     auto* provokingVertexProps = vk_extract_struct<VkPhysicalDeviceProvokingVertexPropertiesEXT>(
         pProperties, VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROVOKING_VERTEX_PROPERTIES_EXT);
+    auto* borderColorProps = cabooseEmulatesCustomBorderColor()
+        ? vk_extract_struct<VkPhysicalDeviceCustomBorderColorPropertiesEXT>(
+              pProperties, VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_CUSTOM_BORDER_COLOR_PROPERTIES_EXT)
+        : nullptr;
 #if defined(VK_USE_PLATFORM_ANDROID_KHR)
     auto* presentationProps = vk_extract_struct<VkPhysicalDevicePresentationPropertiesANDROID>(
         pProperties, VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PRESENTATION_PROPERTIES_ANDROID);
@@ -2628,6 +2665,10 @@ void ResourceTracker::on_vkGetPhysicalDeviceProperties2(void* context,
         provokingVertexProps->transformFeedbackPreservesTriangleFanProvokingVertex = VK_TRUE;
         __vk_append_struct(pProperties, provokingVertexProps);
     }
+    if (borderColorProps) {
+        borderColorProps->maxCustomBorderColorSamplers = caboose::features::kMaxCustomBorderColorSamplers;
+        __vk_append_struct(pProperties, borderColorProps);
+    }
 #if defined(VK_USE_PLATFORM_ANDROID_KHR)
     if (presentationProps) {
         __vk_append_struct(pProperties, presentationProps);
@@ -5439,6 +5480,14 @@ VkResult ResourceTracker::on_vkCreateSampler(void* context, VkResult, VkDevice d
     VkSamplerCustomBorderColorCreateInfoEXT localVkSamplerCustomBorderColorCreateInfo;
     const VkSamplerCustomBorderColorCreateInfoEXT* samplerCustomBorderColorCreateInfo =
         vk_find_struct_const(pCreateInfo, SAMPLER_CUSTOM_BORDER_COLOR_CREATE_INFO_EXT);
+    // A host without custom border colours gets the nearest built-in one, and none of the
+    // structures that only describe a custom colour.
+    const bool emulatedBorderColor = cabooseEmulatesCustomBorderColor();
+    if (emulatedBorderColor) {
+        localCreateInfo.borderColor = caboose::features::nearestBorderColor(
+            localCreateInfo.borderColor, samplerCustomBorderColorCreateInfo);
+        samplerCustomBorderColorCreateInfo = nullptr;
+    }
     if (samplerCustomBorderColorCreateInfo) {
         localVkSamplerCustomBorderColorCreateInfo =
             vk_make_orphan_copy(*samplerCustomBorderColorCreateInfo);
@@ -5458,7 +5507,7 @@ VkResult ResourceTracker::on_vkCreateSampler(void* context, VkResult, VkDevice d
         localVkSamplerBorderColorComponentMappingCreateInfo;
     const VkSamplerBorderColorComponentMappingCreateInfoEXT* samplerBorderColorComponentMappingCreateInfo =
         vk_find_struct_const(pCreateInfo, SAMPLER_BORDER_COLOR_COMPONENT_MAPPING_CREATE_INFO_EXT);
-    if (samplerBorderColorComponentMappingCreateInfo) {
+    if (samplerBorderColorComponentMappingCreateInfo && !emulatedBorderColor) {
         localVkSamplerBorderColorComponentMappingCreateInfo =
             vk_make_orphan_copy(*samplerBorderColorComponentMappingCreateInfo);
         vk_append_struct(&structChainIter, &localVkSamplerBorderColorComponentMappingCreateInfo);
@@ -9223,6 +9272,11 @@ VkResult ResourceTracker::on_vkCreateGraphicsPipelines(
             }
         }
     }
+    // A host without logic operations draws these pipelines without them.
+    std::vector<VkPipelineColorBlendStateCreateInfo> blendStates;
+    if (mCabooseHostLogicOp.load(std::memory_order_relaxed) == 0) {
+        caboose::features::dropLogicOps(localCreateInfos, blendStates);
+    }
     return enc->vkCreateGraphicsPipelines(device, pipelineCache, localCreateInfos.size(),
                                           localCreateInfos.data(), pAllocator, pPipelines,
                                           true /* do lock */);
