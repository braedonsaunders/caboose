+// Device-constant: the device's own extension list (no layer name) is answered from the
+// executor session's capability cache, keyed by the capacity asked for.
+VkResult VkEncoder::vkEnumerateDeviceExtensionProperties(VkPhysicalDevice physicalDevice, const char* pLayerName,
+                                                         uint32_t* pPropertyCount, VkExtensionProperties* pProperties,
+                                                         uint32_t doLock) {
+    const bool cabooseCacheable = !pLayerName && pPropertyCount && !caboose::completion::lostCall() &&
+        (!pProperties || *pPropertyCount <= 240);
+    const uint32_t cabooseCapacity = !pPropertyCount ? 0 : pProperties ? *pPropertyCount : UINT32_MAX;
+    const std::string cabooseKey = caboose::memory::StaticQueryCache::key(
+        uint32_t(OP_vkEnumerateDeviceExtensionProperties), caboose::handle_key(physicalDevice), cabooseCapacity);
+    std::string cabooseCached;
+    if (cabooseCacheable && caboose::memory::staticQueryCache.lookupBytes(cabooseKey, &cabooseCached) &&
+        cabooseCached.size() >= 2 * sizeof(uint32_t)) {
+        VkResult result; uint32_t count = 0;
+        std::memcpy(&result, cabooseCached.data(), sizeof(result));
+        std::memcpy(&count, cabooseCached.data() + sizeof(result), sizeof(count));
+        const size_t bytes = size_t(count) * sizeof(VkExtensionProperties);
+        if (cabooseCached.size() == 2 * sizeof(uint32_t) + (pProperties ? bytes : 0) &&
+            (!pProperties || count <= cabooseCapacity)) {
+            *pPropertyCount = count;
+            if (pProperties && bytes) std::memcpy(pProperties, cabooseCached.data() + 2 * sizeof(uint32_t), bytes);
+            return result;
+        }
+    }
+    const VkResult result = vkEnumerateDeviceExtensionProperties_cabooseAsk(physicalDevice, pLayerName, pPropertyCount, pProperties, doLock);
+    if (cabooseCacheable && (result == VK_SUCCESS || result == VK_INCOMPLETE) &&
+        !caboose::completion::executorLost.load(std::memory_order_acquire) &&
+        (!pProperties || *pPropertyCount <= cabooseCapacity)) {
+        std::string answer(reinterpret_cast<const char*>(&result), sizeof(result));
+        answer.append(reinterpret_cast<const char*>(pPropertyCount), sizeof(uint32_t));
+        if (pProperties) answer.append(reinterpret_cast<const char*>(pProperties), *pPropertyCount * sizeof(VkExtensionProperties));
+        caboose::memory::staticQueryCache.storeBytes(cabooseKey, answer);
+    }
+    return result;
+}
