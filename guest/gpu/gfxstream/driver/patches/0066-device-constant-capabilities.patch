+// Device-constant: answered from the executor session's capability cache when the whole
+// chain is known and pointer-free (caboose-bounded-memory/capability_chains.h).
+void VkEncoder::vkGetPhysicalDeviceProperties2(VkPhysicalDevice physicalDevice, VkPhysicalDeviceProperties2* pProperties, uint32_t doLock) {
+    std::string cabooseKey = caboose::memory::StaticQueryCache::key(uint32_t(OP_vkGetPhysicalDeviceProperties2), caboose::handle_key(physicalDevice));
+    const bool cabooseCacheable = !caboose::completion::lostCall() &&
+        caboose::memory::chainShape(VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2, pProperties, sizeof(VkPhysicalDeviceProperties2), cabooseChainSize, &cabooseKey);
+    std::string cabooseCached;
+    if (cabooseCacheable && caboose::memory::staticQueryCache.lookupBytes(cabooseKey, &cabooseCached) &&
+        caboose::memory::chainLoad(VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2, pProperties, sizeof(VkPhysicalDeviceProperties2), cabooseChainSize, cabooseCached))
+        return;
+    vkGetPhysicalDeviceProperties2_cabooseAsk(physicalDevice, pProperties, doLock);
+    if (cabooseCacheable && !caboose::completion::executorLost.load(std::memory_order_acquire))
+        caboose::memory::staticQueryCache.storeBytes(
+            cabooseKey, caboose::memory::chainSave(VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2, pProperties, sizeof(VkPhysicalDeviceProperties2), cabooseChainSize));
+}
