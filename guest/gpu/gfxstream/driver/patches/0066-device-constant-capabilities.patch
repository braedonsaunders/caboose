-void VkEncoder::vkGetPhysicalDeviceQueueFamilyProperties(
+// Device-constant: answered from the executor session's capability cache.
+void VkEncoder::vkGetPhysicalDeviceProperties(VkPhysicalDevice physicalDevice, VkPhysicalDeviceProperties* pProperties, uint32_t doLock) {
+    const std::string cabooseKey = caboose::memory::StaticQueryCache::key(uint32_t(OP_vkGetPhysicalDeviceProperties), caboose::handle_key(physicalDevice));
+    const bool cabooseCacheable = pProperties && !caboose::completion::lostCall();
+    if (cabooseCacheable && caboose::memory::staticQueryCache.lookup(cabooseKey, pProperties)) return;
+    vkGetPhysicalDeviceProperties_cabooseAsk(physicalDevice, pProperties, doLock);
+    if (cabooseCacheable && !caboose::completion::executorLost.load(std::memory_order_acquire))
+        caboose::memory::staticQueryCache.store(cabooseKey, *pProperties);
+}
+
+void VkEncoder::vkGetPhysicalDeviceQueueFamilyProperties_cabooseAsk(
     VkPhysicalDevice physicalDevice, uint32_t* pQueueFamilyPropertyCount,
     VkQueueFamilyProperties* pQueueFamilyProperties, uint32_t doLock) {
     (void)doLock;
@@ -1413,6 +1429,38 @@ void VkEncoder::vkGetPhysicalDeviceQueueFamilyProperties(
     if (!queueSubmitWithCommandsEnabled && doLock) this->unlock();
 }
 
+// Device-constant: answered from the executor session's capability cache, keyed by the
+// capacity asked for (none for the count alone).
+void VkEncoder::vkGetPhysicalDeviceQueueFamilyProperties(VkPhysicalDevice physicalDevice, uint32_t* pQueueFamilyPropertyCount,
+                                                        VkQueueFamilyProperties* pQueueFamilyProperties, uint32_t doLock) {
+    const bool cabooseCacheable = pQueueFamilyPropertyCount && !caboose::completion::lostCall() &&
+        (!pQueueFamilyProperties || *pQueueFamilyPropertyCount <= 64);
+    const uint32_t cabooseCapacity = !pQueueFamilyPropertyCount ? 0 : pQueueFamilyProperties ? *pQueueFamilyPropertyCount : UINT32_MAX;
+    const std::string cabooseKey = caboose::memory::StaticQueryCache::key(
+        uint32_t(OP_vkGetPhysicalDeviceQueueFamilyProperties), caboose::handle_key(physicalDevice), cabooseCapacity);
+    std::string cabooseCached;
+    if (cabooseCacheable && caboose::memory::staticQueryCache.lookupBytes(cabooseKey, &cabooseCached) &&
+        cabooseCached.size() >= sizeof(uint32_t)) {
+        uint32_t count = 0;
+        std::memcpy(&count, cabooseCached.data(), sizeof(count));
+        const size_t bytes = size_t(count) * sizeof(VkQueueFamilyProperties);
+        if (cabooseCached.size() == sizeof(count) + (pQueueFamilyProperties ? bytes : 0) &&
+            (!pQueueFamilyProperties || count <= cabooseCapacity)) {
+            *pQueueFamilyPropertyCount = count;
+            if (pQueueFamilyProperties && bytes) std::memcpy(pQueueFamilyProperties, cabooseCached.data() + sizeof(count), bytes);
+            return;
+        }
+    }
+    vkGetPhysicalDeviceQueueFamilyProperties_cabooseAsk(physicalDevice, pQueueFamilyPropertyCount, pQueueFamilyProperties, doLock);
+    if (cabooseCacheable && !caboose::completion::executorLost.load(std::memory_order_acquire) &&
+        (!pQueueFamilyProperties || *pQueueFamilyPropertyCount <= cabooseCapacity)) {
+        std::string answer(reinterpret_cast<const char*>(pQueueFamilyPropertyCount), sizeof(uint32_t));
+        if (pQueueFamilyProperties)
+            answer.append(reinterpret_cast<const char*>(pQueueFamilyProperties), *pQueueFamilyPropertyCount * sizeof(VkQueueFamilyProperties));
+        caboose::memory::staticQueryCache.storeBytes(cabooseKey, answer);
+    }
+}
