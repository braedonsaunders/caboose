+VkResult ResourceTracker::cabooseExportSyncFile(void* context, VkDevice device, VkQueue queue,
+                                                VkSemaphore semaphore, int* pFd) {
+    VkEncoder* enc = (VkEncoder*)context;
+    VkFenceCreateInfo fenceInfo{};
+    fenceInfo.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO;
+    VkFence fence = VK_NULL_HANDLE;
+    VkResult result = on_vkCreateFence(enc, VK_SUCCESS, device, &fenceInfo, nullptr, &fence);
+    if (result != VK_SUCCESS) return result;
+    // Waiting the semaphore here is the export's wait operation; with none, the fence
+    // still follows all earlier work on the queue.
+    const VkPipelineStageFlags stage = VK_PIPELINE_STAGE_ALL_COMMANDS_BIT;
+    VkSubmitInfo submit{};
+    submit.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO;
+    submit.waitSemaphoreCount = semaphore != VK_NULL_HANDLE ? 1 : 0;
+    submit.pWaitSemaphores = &semaphore;
+    submit.pWaitDstStageMask = &stage;
+    result = vkQueueSubmitEnc(enc, queue, 1, &submit, fence);
+    if (result != VK_SUCCESS) {
+        on_vkDestroyFence(enc, device, fence, nullptr);
+        return result;
+    }
+    uint32_t token = 0;
+    const int fd = caboose::dmabuf::createSyncFile(&token);
+    if (fd < 0) {
+        // Without a render node there is no sync file to hand out: wait, and report the
+        // payload as already signaled (-1).
+        on_vkWaitForFences(enc, VK_SUCCESS, device, 1, &fence, VK_TRUE, UINT64_MAX);
+        on_vkDestroyFence(enc, device, fence, nullptr);
+        *pFd = -1;
+        return VK_SUCCESS;
+    }
+    completionWaiter().enqueue(device, fence, token);
+    *pFd = fd;
+    return VK_SUCCESS;
+}
+
+void ResourceTracker::cabooseNoteQueue(VkDevice device, VkQueue queue, uint32_t family) {
+    std::lock_guard<std::recursive_mutex> lock(mLock);
+    mCabooseDeviceQueues.emplace(device, std::make_pair(queue, family));
+}
