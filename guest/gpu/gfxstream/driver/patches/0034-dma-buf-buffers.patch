+// Socket mode: memory imported from or exported as a phone-resident dma-buf
+// (docs/gpu-buffers.md). The host has no dma-bufs; one host allocation stands for the
+// buffer in this process, created by its first import or export and aliased by later
+// imports, which get their own guest handles for the same host handle.
+VkResult ResourceTracker::cabooseAllocateDmabufMemory(VkEncoder* enc, VkDevice device,
+                                                      const VkMemoryAllocateInfo* pAllocateInfo,
+                                                      const VkAllocationCallbacks* pAllocator,
+                                                      const VkImportMemoryFdInfoKHR* importFdInfo,
+                                                      VkDeviceMemory* pMemory) {
+    auto& shared = caboose::dmabuf::sharedAllocations();
+    int fd = -1;
+    std::optional<caboose::dmabuf::Identity> identity;
+    if (importFdInfo) {
+        identity = caboose::dmabuf::identify(importFdInfo->fd);
+        if (!identity) {
+            fprintf(stderr, "CABOOSE_DMABUF_IMPORT_REJECT reason=not-dmabuf fd=%d size=%llu\n",
+                    importFdInfo->fd, (unsigned long long)pAllocateInfo->allocationSize);
+            return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+        }
+        if (auto existing = shared.acquire(*identity)) {
+            if (existing->size < pAllocateInfo->allocationSize) {
+                fprintf(stderr, "CABOOSE_DMABUF_IMPORT_REJECT reason=alias-smaller host=%llu size=%llu\n",
+                        (unsigned long long)existing->size, (unsigned long long)pAllocateInfo->allocationSize);
+                shared.release(*identity);
+                return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+            }
+            uint64_t host = existing->host;
+            createMapping()->mapHandles_u64_VkDeviceMemory(&host, pMemory, 1);
+            setDeviceMemoryInfo(device, *pMemory, pAllocateInfo->allocationSize, nullptr,
+                                pAllocateInfo->memoryTypeIndex, nullptr, true, ZX_HANDLE_INVALID,
+                                nullptr, -1);
+            {
+                std::lock_guard<std::recursive_mutex> lock(mLock);
+                info_VkDeviceMemory[*pMemory].socketDmabuf = identity;
+            }
+            // The application's descriptor is ours on success; the shared entry keeps its own.
+            close(importFdInfo->fd);
+            if (const auto* dedicatedPtr = vk_find_struct_const(pAllocateInfo, MEMORY_DEDICATED_ALLOCATE_INFO)) {
+                if (dedicatedPtr->image) cabooseRegisterDmabufImage(device, dedicatedPtr->image, *identity);
+            }
+            return VK_SUCCESS;
+        }
+        fd = fcntl(importFdInfo->fd, F_DUPFD_CLOEXEC, 0);
+        if (fd < 0) return VK_ERROR_TOO_MANY_OBJECTS;
+    } else {
+        fd = caboose::dmabuf::create(pAllocateInfo->allocationSize);
+        if (fd < 0) return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+        identity = caboose::dmabuf::identify(fd);
+        if (!identity) {
+            close(fd);
+            return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+        }
+    }
+
+    // The host allocation: the application's chain without the external-memory structures.
+    VkMemoryAllocateInfo hostInfo = vk_make_orphan_copy(*pAllocateInfo);
+    vk_struct_chain_iterator chain = vk_make_chain_iterator(&hostInfo);
+    VkMemoryDedicatedAllocateInfo dedicated{};
+    if (const auto* dedicatedPtr = vk_find_struct_const(pAllocateInfo, MEMORY_DEDICATED_ALLOCATE_INFO)) {
+        dedicated = vk_make_orphan_copy(*dedicatedPtr);
+        vk_append_struct(&chain, &dedicated);
+    }
+    VkMemoryAllocateFlagsInfo flags;
+    if (const auto* flagsPtr = vk_find_struct_const(pAllocateInfo, MEMORY_ALLOCATE_FLAGS_INFO)) {
+        flags = vk_make_orphan_copy(*flagsPtr);
+        vk_append_struct(&chain, &flags);
+    }
+    VkResult result = enc->vkAllocateMemory(device, &hostInfo, pAllocator, pMemory, true /* do lock */);
+    if (result != VK_SUCCESS) {
+        close(fd);
+        return result;
+    }
+    if (!shared.insert(*identity, get_host_u64_VkDeviceMemory(*pMemory), fd, hostInfo.allocationSize)) {
+        // Another thread imported the same buffer first: this allocation is surplus.
+        close(fd);
+        enc->vkFreeMemory(device, *pMemory, pAllocator, true /* do lock */);
+        *pMemory = VK_NULL_HANDLE;
+        return cabooseAllocateDmabufMemory(enc, device, pAllocateInfo, pAllocator, importFdInfo, pMemory);
+    }
+    setDeviceMemoryInfo(device, *pMemory, hostInfo.allocationSize, nullptr, hostInfo.memoryTypeIndex,
+                        nullptr, importFdInfo != nullptr, ZX_HANDLE_INVALID, nullptr, -1);
+    {
+        std::lock_guard<std::recursive_mutex> lock(mLock);
+        info_VkDeviceMemory[*pMemory].socketDmabuf = identity;
+    }
+    if (importFdInfo) close(importFdInfo->fd);
+    if (dedicated.sType == VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO && dedicated.image) {
+        cabooseRegisterDmabufImage(device, dedicated.image, *identity);
+    }
+    return VK_SUCCESS;
+}
