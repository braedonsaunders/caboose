+namespace {
+// Observes phone completion of exported sync files' work, in submission order, and
+// signals each sync file. One thread per process, with its own connection.
+class CompletionWaiter {
+public:
+    void enqueue(VkDevice device, VkFence fence, uint32_t token) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        jobs_.push_back({device, fence, token});
+        if (!started_) {
+            started_ = true;
+            std::thread([this] { run(); }).detach();
+        }
+        ready_.notify_one();
+    }
+
+private:
+    struct Job { VkDevice device; VkFence fence; uint32_t token; };
+    void run() {
+        for (;;) {
+            Job job;
+            {
+                std::unique_lock<std::mutex> lock(mutex_);
+                ready_.wait(lock, [this] { return !jobs_.empty(); });
+                job = jobs_.front();
+                jobs_.pop_front();
+            }
+            auto* enc = ResourceTracker::getThreadLocalEncoder();
+            auto* tracker = ResourceTracker::get();
+            // A failed wait (device loss) still signals: consumers must not hang.
+            tracker->on_vkWaitForFences(enc, VK_SUCCESS, job.device, 1, &job.fence, VK_TRUE, UINT64_MAX);
+            tracker->on_vkDestroyFence(enc, job.device, job.fence, nullptr);
+            caboose::dmabuf::signalSyncFile(job.token);
+        }
+    }
+    std::mutex mutex_;
+    std::condition_variable ready_;
+    std::deque<Job> jobs_;
+    bool started_ = false;
+};
