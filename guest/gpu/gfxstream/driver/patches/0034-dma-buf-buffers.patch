+bool ResourceTracker::cabooseRemoteImageLayout(VkImage image, const VkImageSubresource* subresource,
+                                               VkSubresourceLayout* layout) {
+    std::lock_guard<std::recursive_mutex> lock(mLock);
+    auto it = info_VkImage.find(image);
+    if (it == info_VkImage.end() || !(it->second.socketRemote || it->second.cabooseDmabuf)) return false;
+    uint32_t plane;
+    switch (subresource->aspectMask) {
+        case VK_IMAGE_ASPECT_MEMORY_PLANE_0_BIT_EXT: case VK_IMAGE_ASPECT_COLOR_BIT: plane = 0; break;
+        case VK_IMAGE_ASPECT_MEMORY_PLANE_1_BIT_EXT: case VK_IMAGE_ASPECT_PLANE_1_BIT: plane = 1; break;
+        case VK_IMAGE_ASPECT_MEMORY_PLANE_2_BIT_EXT: case VK_IMAGE_ASPECT_PLANE_2_BIT: plane = 2; break;
+        case VK_IMAGE_ASPECT_PLANE_0_BIT: plane = 0; break;
+        default: return false;
+    }
+    const auto& planes = it->second.socketRemotePlanes;
+    *layout = plane < planes.size() ? planes[plane] : VkSubresourceLayout{};
+    return true;
+}
