+// Tells the broker which image holds the buffer's pixels, so the compositor can show it.
+void ResourceTracker::cabooseRegisterDmabufImage(VkDevice device, VkImage image,
+                                                 const caboose::dmabuf::Identity& identity) {
+    caboose::dmabuf::RegisteredImage registered{};
+    {
+        std::lock_guard<std::recursive_mutex> lock(mLock);
+        auto imageIt = info_VkImage.find(image);
+        auto deviceIt = info_VkDevice.find(device);
+        auto queueIt = mCabooseDeviceQueues.find(device);
+        if (imageIt == info_VkImage.end() || deviceIt == info_VkDevice.end() ||
+            queueIt == mCabooseDeviceQueues.end() || !imageIt->second.socketRemote) return;
+        VkInstance instance = VK_NULL_HANDLE;
+        for (const auto& [candidate, info] : info_VkInstance) {
+            if (std::find(info.physicalDevices.begin(), info.physicalDevices.end(),
+                          deviceIt->second.physdev) != info.physicalDevices.end()) instance = candidate;
+        }
+        if (instance == VK_NULL_HANDLE) return;
+        const auto& create = imageIt->second.createInfo;
+        registered = {get_host_u64_VkInstance(instance), get_host_u64_VkDevice(device),
+                      get_host_u64_VkQueue(queueIt->second.first), get_host_u64_VkImage(image),
+                      uint32_t(create.format), create.extent.width, create.extent.height,
+                      queueIt->second.second};
+    }
+    const int fd = caboose::dmabuf::sharedAllocations().duplicate(identity);
+    if (fd < 0) return;
+    caboose::dmabuf::registrations().add(fd, registered);
+    close(fd);
+}
