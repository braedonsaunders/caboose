From: Caboose <caboose@local>
Subject: [PATCH 84/87] Check a long-polled reset event on the device

The completion tracker answers vkGetEventStatus locally. An event it believed reset, with no
batch pending that could set it, was answered reset forever when it had missed the change: Halo:
MCC's main thread polled one event for minutes while starting Halo: CE. A reset answered locally
for 250 ms is now asked about on the device every 250 ms while the poll continues, and a set it
reports updates the tracker.
---
diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/func_table.cpp b/src/gfxstream/guest/vulkan_enc/autogenerated/func_table.cpp
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/func_table.cpp
+++ b/src/gfxstream/guest/vulkan_enc/autogenerated/func_table.cpp
@@ -1,3 +1,4 @@
+#include <chrono>
 // Copyright (C) 2018 The Android Open Source Project
 // Copyright (C) 2018 Google Inc.
 //
@@ -963,11 +964,23 @@
         // not follow is asked about without waiting (caboose-bounded-memory/event_status.h).
         bool cabooseSet = false;
         if (caboose::completion::feedActive.load(std::memory_order_acquire) &&
-            caboose::completion::tracker().eventSet(caboose::handle_key(event), &cabooseSet))
+            caboose::completion::tracker().eventSet(caboose::handle_key(event), &cabooseSet)) {
             vkGetEventStatus_VkResult_return = cabooseSet ? VK_EVENT_SET : VK_EVENT_RESET;
-        else
+            // Caboose: a reset the tracker keeps answering is checked on the device now and
+            // then; a set it missed is taken from there (caboose-bounded-memory/event_status.h).
+            const int64_t cabooseNowMs = std::chrono::duration_cast<std::chrono::milliseconds>(
+                std::chrono::steady_clock::now().time_since_epoch()).count();
+            if (!cabooseSet && caboose::memory::eventRecheck.due(caboose::handle_key(event), cabooseNowMs) &&
+                vkEnc->vkGetEventStatus(gfxstream_device->internal_object, event, true /* do lock */) == VK_EVENT_SET) {
+                caboose::completion::tracker().eventHost(caboose::handle_key(event), true);
+                vkGetEventStatus_VkResult_return = VK_EVENT_SET;
+            }
+        } else {
             vkGetEventStatus_VkResult_return =
                 vkEnc->vkGetEventStatus(gfxstream_device->internal_object, event, true /* do lock */);
+        }
+        if (vkGetEventStatus_VkResult_return != VK_EVENT_RESET)
+            caboose::memory::eventRecheck.done(caboose::handle_key(event));
         caboose::memory::pollStall().poll("vkGetEventStatus", caboose::handle_key(event),
                                           vkGetEventStatus_VkResult_return != VK_EVENT_RESET,
                                           [event] { return caboose::completion::tracker().describeEvent(caboose::handle_key(event)); });
