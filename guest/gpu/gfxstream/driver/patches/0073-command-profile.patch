From: Caboose <caboose@local>
Subject: [PATCH 73/87] Report device-stream bytes per command on request

CABOOSE_COMMAND_PROFILE=1 reports, every 2 s and at exit, the twelve commands that took the
most bytes of the device stream, with their count and mean size, and the total bytes and
commands: where a frame's command bytes go, so per-draw encodings can be measured.
---
diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
index cb973b5..a71021e 100644
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
+++ b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
@@ -58,6 +58,69 @@
 #include <pthread.h>
 #include <string>
 #include <vector>
+namespace caboose_command_profile {
+// CABOOSE_COMMAND_PROFILE=1: every 2 s and at exit, the twelve commands that took the most
+// bytes of the device stream, with their count and mean size; and the total bytes and
+// commands. Commands recorded into command buffers count when they are encoded.
+struct Totals { uint64_t bytes[1023 + 32] = {}; uint64_t n[1023 + 32] = {}; uint64_t all = 0, commands = 0; };
+inline Totals totals;
+inline std::mutex mu;
+inline std::chrono::steady_clock::time_point last = std::chrono::steady_clock::now();
+inline bool pending = false;
+inline bool enabled() {
+    static const bool on = [] {
+        const char* value = std::getenv("CABOOSE_COMMAND_PROFILE");
+        return value && value[0] == '1' && value[1] == '\0';
+    }();
+    return on;
+}
+// Opcodes past 21022 (extension commands) take the slots 1023 up, in order of first use.
+inline uint32_t high[32] = {};
+inline uint32_t index(uint32_t opcode) {
+    if (opcode >= 20000 && opcode < 21023) return opcode - 20000;
+    for (uint32_t k = 0; k < 32; ++k) {
+        if (high[k] == opcode) return 1023 + k;
+        if (!high[k]) { high[k] = opcode; return 1023 + k; }
+    }
+    return 1023 + 31;
+}
+inline uint32_t opcodeAt(uint32_t i) { return i < 1023 ? i + 20000 : high[i - 1023]; }
+inline void reportLocked(bool atExit) {
+    uint32_t order[12] = {}; uint64_t best[12] = {};
+    for (uint32_t i = 0; i < 1023 + 32; ++i)
+        for (int k = 0; k < 12; ++k)
+            if (totals.bytes[i] > best[k]) {
+                for (int m = 11; m > k; --m) { best[m] = best[m - 1]; order[m] = order[m - 1]; }
+                best[k] = totals.bytes[i]; order[k] = i; break;
+            }
+    std::fprintf(stderr, "CABOOSE_COMMAND_PROFILE bytes=%llu commands=%llu",
+                 (unsigned long long)totals.all, (unsigned long long)totals.commands);
+    for (int k = 0; k < 12 && best[k]; ++k)
+        std::fprintf(stderr, " op%u=%lluKiB/%llu/%llu", opcodeAt(order[k]),
+                     (unsigned long long)(best[k] / 1024), (unsigned long long)totals.n[order[k]],
+                     (unsigned long long)(best[k] / totals.n[order[k]]));
+    if (atExit) std::fprintf(stderr, " at_exit");
+    std::fprintf(stderr, "\n");
+    totals = Totals{};
+}
+inline void note(uint32_t opcode, uint32_t bytes) {
+    if (!enabled()) return;
+    std::lock_guard<std::mutex> lock(mu);
+    static const bool registered = [] {
+        std::atexit([] { std::lock_guard<std::mutex> exitLock(mu); if (pending) reportLocked(true); });
+        return true;
+    }();
+    (void)registered;
+    const uint32_t i = index(opcode);
+    totals.bytes[i] += bytes; totals.n[i] += 1; totals.all += bytes; totals.commands += 1;
+    pending = true;
+    const auto now = std::chrono::steady_clock::now();
+    if (now - last < std::chrono::seconds(2)) return;
+    last = now;
+    reportLocked(false);
+    pending = false;
+}
+}  // namespace caboose_command_profile
