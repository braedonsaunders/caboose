@@ -86,14 +86,27 @@ class VkEncoder::Impl {
     std::atomic<long> mOwner{0};
 };
 
-VkEncoder::~VkEncoder() {}
+// Only an encoder on a device stream may switch to silent success; one recording a command
+// buffer into local staging never does (caboose-bounded-memory/silent_success.h).
+VkEncoder::~VkEncoder() { caboose::silent::replyMode().encoderGone(this); }
 
 VkEncoder::VkEncoder(gfxstream::guest::IOStream* stream)
-    : mImpl(new VkEncoder::Impl(stream)) {}
+    : mImpl(new VkEncoder::Impl(stream)) {
+    caboose::silent::replyMode().encoderMade(this, stream);
+}
 
 void VkEncoder::flush() { mImpl->flush(); }
 
-void VkEncoder::lock() { mImpl->lock(); }
+// Silent success: a device stream switches with REPLY_MODE at the first lock hold once its feed
+// runs, before anything that hold sends (caboose-bounded-memory/silent_success.h).
+void VkEncoder::lock() {
+    mImpl->lock();
+    if (caboose::silent::replyMode().due(this, caboose::completion::feedActive.load(std::memory_order_acquire))) {
+        auto* stream = mImpl->stream();
+        caboose::silent::encodeReplyMode(stream->reserve(caboose::silent::kReplyModePacketSize));
+        stream->flush();
+    }
+}
 
 void VkEncoder::unlock() { mImpl->unlock(); }
 
