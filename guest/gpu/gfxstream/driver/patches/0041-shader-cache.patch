diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/func_table.cpp b/src/gfxstream/guest/vulkan_enc/autogenerated/func_table.cpp
index de23ca9..8e07bf7 100644
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/func_table.cpp
+++ b/src/gfxstream/guest/vulkan_enc/autogenerated/func_table.cpp
@@ -35,6 +35,13 @@
 #include "gfxstream_vk_entrypoints.h"
 #include "gfxstream_vk_private.h"
 #include "goldfish_vk_private_defs.h"
+#include "caboose-shader-cache/shader_cache.h"
+#include "util/mesa-blake3.h"
+
+// 1 when the phone keeps shader modules (hello feature 0x2000); the descriptor of the
+// process's only device stream, or a negative value (SocketStream.cpp).
+extern "C" int caboose_gfxstream_shader_cache;
+extern "C" int caboose_gfxstream_device_fd;
 
 // Stuff we are not going to use but if included,
 // will cause compile errors. These are Android Vulkan
@@ -994,6 +1001,26 @@ VkResult gfxstream_vk_CreateShaderModule(VkDevice device,
             cabooseInfo.pCode = cabooseCode.data();
             pCreateInfo = &cabooseInfo;
         }
+        // A module the phone's shader store holds goes as its hash (docs/gpu-live.md,
+        // "Shader cache"); the key covers the bytes sent, after the rewrite above.
+        uint8_t cabooseToken[caboose::shader_cache::kTokenBytes];
+        VkShaderModuleCreateInfo cabooseTokenInfo;
+        if (caboose_gfxstream_shader_cache == 1 &&
+            caboose::shader_cache::substitute(
+                caboose::shader_cache::known(), pCreateInfo->pCode, pCreateInfo->codeSize,
+                caboose_gfxstream_device_fd >= 0,
+                [](const void* code, size_t size, caboose::shader_cache::Key* key) {
+                    _mesa_blake3_compute(code, size, key->data());
+                },
+                [vkEnc](std::vector<uint8_t>* keys) {
+                    return vkEnc->cabooseShaderInventory(keys, true /* do lock */);
+                },
+                cabooseToken)) {
+            cabooseTokenInfo = *pCreateInfo;
+            cabooseTokenInfo.codeSize = sizeof(cabooseToken);
+            cabooseTokenInfo.pCode = reinterpret_cast<const uint32_t*>(cabooseToken);
+            pCreateInfo = &cabooseTokenInfo;
+        }
         vkCreateShaderModule_VkResult_return =
             vkEnc->vkCreateShaderModule(gfxstream_device->internal_object, pCreateInfo, pAllocator,
                                         pShaderModule, true /* do lock */);
