+// Frees and destroys held until the work sent before them has completed
+// (caboose-bounded-memory/deferred_destroys.h). Callers hold the encoder lock.
+namespace caboose_deferred_destroy {
+using caboose::memory::DeferredDestroys;
+// One destroy as its encoder function sends it without an allocator: opcode, size, the
+// host's device and object handles, and a null allocator pointer.
+template <class Stream>
+inline void send(Stream* stream, const DeferredDestroys::Destroy& destroy) {
+    constexpr uint32_t packetSize = 4 + 4 + 8 + 8 + 8;
+    uint8_t* ptr = stream->reserve(packetSize);
+    memcpy(ptr, &destroy.opcode, 4);
+    memcpy(ptr + 4, &packetSize, 4);
+    memcpy(ptr + 8, &destroy.device, 8);
+    memcpy(ptr + 16, &destroy.handle, 8);
+    memset(ptr + 24, 0, 8);
+}
+// Sends the held destroys whose work has completed, and every one of `device` when it is
+// being destroyed. A free releases its allocation budget once it is sent.
+template <class Stream>
+inline void sendReady(Stream* stream, uint64_t device = 0) {
+    if (caboose::memory::deferredDestroys.empty()) return;
+    auto taken = caboose::memory::deferredDestroys.take(
+        caboose::completion::tracker().outstandingFrom(),
+        caboose::completion::executorGeneration.load(std::memory_order_acquire), device);
+    for (const auto& destroy : taken.send) {
+        send(stream, destroy);
+        if (destroy.memory) caboose::memory::asyncAllocationBudget.freed(destroy.memory);
+    }
+    for (const auto& destroy : taken.dropped)
+        if (destroy.memory) caboose::memory::asyncAllocationBudget.freed(destroy.memory);
+    if (!taken.send.empty()) stream->flush();
+}
+// Holds a destroy while work sent before it may still use the object; false when nothing
+// is in flight and the caller sends it now. Queues whose latest submissions no watch
+// follows get one first, so the hold covers every submission on every queue.
+template <class Stream>
+inline bool hold(Stream* stream, uint32_t opcode, uint64_t device, uint64_t handle, uint64_t memory = 0) {
+    if (!caboose::completion::feedActive.load(std::memory_order_acquire) ||
+        caboose::completion::executorLost.load(std::memory_order_acquire))
+        return false;
+    sendReady(stream);
+    auto& tracker = caboose::completion::tracker();
+    bool watched = false;
+    for (const auto& queue : caboose::memory::deferredDestroys.takeUnwatched()) {
+        const uint64_t serial = tracker.submitted(0, {}, queue.queue, queue.device);
+        caboose::completion::encodeWatch(stream->reserve(caboose::completion::kWatchPacketSize),
+                                         queue.hostQueue, serial);
+        watched = true;
+    }
+    if (watched) stream->flush();
+    const uint64_t serial = tracker.lastSerial();
+    if (caboose::memory::deferredDestroys.empty() && tracker.completedThrough(serial)) return false;
+    if (caboose::memory::deferredDestroys.size() >= DeferredDestroys::kLimit) {
+        // Too many held: wait a little for the oldest, then send whatever is ready.
+        tracker.waitCompletedThrough(caboose::memory::deferredDestroys.oldestSerial(),
+                                     std::chrono::steady_clock::now() + std::chrono::seconds(1));
+        sendReady(stream);
+    }
+    DeferredDestroys::Destroy destroy;
+    destroy.opcode = opcode;
+    destroy.device = device;
+    destroy.handle = handle;
+    destroy.memory = memory;
+    caboose::memory::deferredDestroys.hold(
+        serial, caboose::completion::executorGeneration.load(std::memory_order_acquire), destroy);
+    return true;
+}
