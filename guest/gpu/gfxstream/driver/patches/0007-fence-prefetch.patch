 void VkEncoder::vkDestroyFence(VkDevice device, VkFence fence,
                                const VkAllocationCallbacks* pAllocator, uint32_t doLock) {
+    caboose::memory::deferredReplies.forgetFence(uint64_t(uintptr_t(fence)));
     (void)doLock;
     bool queueSubmitWithCommandsEnabled =
         sFeatureBits & VULKAN_STREAM_FEATURE_QUEUE_SUBMIT_WITH_COMMANDS_BIT;
@@ -3303,6 +3304,7 @@ void VkEncoder::vkDestroyFence(VkDevice device, VkFence fence,
 
 VkResult VkEncoder::vkResetFences(VkDevice device, uint32_t fenceCount, const VkFence* pFences,
                                   uint32_t doLock) {
+    for (uint32_t i = 0; i < fenceCount; ++i) caboose::memory::deferredReplies.forgetFence(uint64_t(uintptr_t(pFences[i])));
     (void)doLock;
     static_assert(caboose::memory::timedRpcIndex(OP_vkResetFences) >= 0, "untimed RPC opcode");
     caboose::memory::RpcCallScope caboose_rpc_timing{OP_vkResetFences};
@@ -3435,6 +3437,11 @@ VkResult VkEncoder::vkWaitForFences(VkDevice device, uint32_t fenceCount, const
     if (!queueSubmitWithCommandsEnabled && doLock) caboose_rpc_timing.lock([&] { this->lock(); });
     auto stream = mImpl->stream();
     caboose::memory::deferredReplies.drain(this, stream);
+    if (!caboose::memory::sendingPrefetchedFenceWait &&
+        caboose::memory::deferredReplies.signaled(pFences, fenceCount, waitAll)) {
+        if (!queueSubmitWithCommandsEnabled && doLock) this->unlock();
+        return static_cast<VkResult>(caboose_rpc_timing.finish(VK_SUCCESS));
+    }
     auto pool = mImpl->pool();
     VkDevice local_device;
     uint32_t local_fenceCount;
@@ -3461,6 +3468,8 @@ VkResult VkEncoder::vkWaitForFences(VkDevice device, uint32_t fenceCount, const
         *countPtr += sizeof(uint64_t);
     }
     uint32_t packetSize_vkWaitForFences = 4 + 4 + (queueSubmitWithCommandsEnabled ? 4 : 0) + count;
+    if (caboose::memory::sendingPrefetchedFenceWait)
+        caboose::memory::deferredReplies.reserve(this, stream, packetSize_vkWaitForFences);
     uint8_t* streamPtr = stream->reserve(packetSize_vkWaitForFences);
     uint8_t** streamPtrPtr = &streamPtr;
     uint32_t opcode_vkWaitForFences = OP_vkWaitForFences;
@@ -3493,7 +3502,13 @@ VkResult VkEncoder::vkWaitForFences(VkDevice device, uint32_t fenceCount, const
     memcpy(*streamPtrPtr, (uint64_t*)&local_timeout, sizeof(uint64_t));
     *streamPtrPtr += sizeof(uint64_t);
     VkResult vkWaitForFences_VkResult_return = (VkResult)0;
-    stream->read(&vkWaitForFences_VkResult_return, sizeof(VkResult));
+    if (caboose::memory::sendingPrefetchedFenceWait) {
+        stream->flush();
+        caboose::memory::deferredReplies.addFenceWait(
+            this, uint64_t(uintptr_t(local_pFences[0])), packetSize_vkWaitForFences);
+    } else {
+        stream->read(&vkWaitForFences_VkResult_return, sizeof(VkResult));
+    }
     ++encodeCount;
     if (0 == encodeCount % POOL_CLEAR_INTERVAL) {
         pool->freeAll();
@@ -5249,6 +5264,19 @@ VkResult VkEncoder::cabooseQueueSubmitWithStagedCommands(VkQueue queue,
             }
         }
     }
+    bool timelineSubmit = false;
+    for (uint32_t i = 0; i < submitCount; ++i)
+        for (auto* next = static_cast<const VkBaseInStructure*>(pSubmits[i].pNext); next;
+             next = next->pNext)
+            timelineSubmit |= next->sType == VK_STRUCTURE_TYPE_TIMELINE_SEMAPHORE_SUBMIT_INFO;
+    VkDevice fenceDevice = finalResult == VK_SUCCESS && fence != VK_NULL_HANDLE && !timelineSubmit
+        ? ResourceTracker::get()->caboosePrefetchFenceDevice(fence) : VK_NULL_HANDLE;
+    if (fenceDevice != VK_NULL_HANDLE) {
+        caboose::memory::sendingPrefetchedFenceWait = true;
+        this->vkWaitForFences(fenceDevice, 1, &fence, VK_TRUE,
+                              caboose::memory::prefetchedFenceWaitNs, 0 /* doLock */);
+        caboose::memory::sendingPrefetchedFenceWait = false;
+    }
     return static_cast<VkResult>(caboose_rpc_timing.finish(finalResult));
 }
 
@@ -21078,6 +21106,7 @@ void VkEncoder::vkGetPhysicalDeviceExternalFencePropertiesKHR(
 VkResult VkEncoder::vkImportFenceFdKHR(VkDevice device,
                                        const VkImportFenceFdInfoKHR* pImportFenceFdInfo,
                                        uint32_t doLock) {
+    if (pImportFenceFdInfo) caboose::memory::deferredReplies.forgetFence(uint64_t(uintptr_t(pImportFenceFdInfo->fence)));
     (void)doLock;
     bool queueSubmitWithCommandsEnabled =
         sFeatureBits & VULKAN_STREAM_FEATURE_QUEUE_SUBMIT_WITH_COMMANDS_BIT;
