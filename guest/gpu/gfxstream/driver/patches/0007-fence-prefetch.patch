From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Caboose <caboose@invalid>
Date: Sat, 31 Oct 2026 00:00:00 +0000
Subject: [PATCH 07/15] Prefetch the frame fence wait with its queue submit

A submit that signals a fence is followed on the same stream by a bounded wait
for that fence, so its result arrives while the application presents. A later
vkWaitForFences or vkGetFenceStatus on that fence is answered locally until the
fence is reset, destroyed or imported. Fences backed by a sync file are never
prefetched.
---
 .../guest/vulkan_enc/ResourceTracker.cpp      | 16 ++++++++++
 .../guest/vulkan_enc/ResourceTracker.h        |  1 +
 .../vulkan_enc/autogenerated/VkEncoder.cpp    | 31 ++++++++++++++++++-
 3 files changed, 47 insertions(+), 1 deletion(-)

diff --git a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
index ee95054..751b8cd 100644
--- a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
+++ b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
@@ -1438,6 +1438,17 @@ bool ResourceTracker::cabooseMappedRange(VkDevice device, VkDeviceMemory memory,
     return true;
 }
 
+// Fences backed by a sync file are waited on in the guest, never prefetched.
+VkDevice ResourceTracker::caboosePrefetchFenceDevice(VkFence fence) {
+    std::lock_guard<std::recursive_mutex> lock(mLock);
+    auto found = info_VkFence.find(fence);
+    if (found == info_VkFence.end() || found->second.external) return VK_NULL_HANDLE;
+#if defined(VK_USE_PLATFORM_ANDROID_KHR) || DETECT_OS_LINUX
+    if (found->second.syncFd) return VK_NULL_HANDLE;
+#endif
+    return found->second.device;
+}
+
 VkDeviceSize ResourceTracker::getMappedSize(VkDeviceMemory memory) {
     std::lock_guard<std::recursive_mutex> lock(mLock);
     const auto it = info_VkDeviceMemory.find(memory);
@@ -4963,6 +4974,11 @@ VkResult ResourceTracker::on_vkCreateFence(void* context, VkResult input_result,
         enc->vkCreateFence(device, &finalCreateInfo, pAllocator, pFence, true /* do lock */);
 
     if (input_result != VK_SUCCESS) return input_result;
+    {
+        std::lock_guard<std::recursive_mutex> lock(mLock);
+        auto created = info_VkFence.find(*pFence);
+        if (created != info_VkFence.end()) created->second.device = device;
+    }
 
 #if defined(VK_USE_PLATFORM_ANDROID_KHR) || DETECT_OS_LINUX
     if (exportSyncFd) {
diff --git a/src/gfxstream/guest/vulkan_enc/ResourceTracker.h b/src/gfxstream/guest/vulkan_enc/ResourceTracker.h
index dbf644a..8167ada 100644
--- a/src/gfxstream/guest/vulkan_enc/ResourceTracker.h
+++ b/src/gfxstream/guest/vulkan_enc/ResourceTracker.h
@@ -531,6 +531,7 @@ class ResourceTracker {
     bool hostSupportsVulkan() const;
     bool usingDirectMapping() const;
     bool cabooseMappedRange(VkDevice device, VkDeviceMemory memory, caboose::memory::Range& out);
+    VkDevice caboosePrefetchFenceDevice(VkFence fence);
     uint32_t getStreamFeatures() const;
     // Read-only proof that setupFeatures actually selected the private sync profile.
     bool cabooseSynchronousProfile() const {
diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
index 4102081..4eabb38 100644
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
+++ b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
