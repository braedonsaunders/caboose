+// Device-constant for devices made the same way: answered from the executor session's
+// capability cache, keyed by the device's fingerprint and the layout exactly as the executor
+// would receive it (device_answers.h). Zink asks it for every layout it makes, in each process.
+bool VkEncoder::cabooseLayoutSupport(uint32_t opcode, VkDevice device,
+                                     const VkDescriptorSetLayoutCreateInfo* pCreateInfo,
+                                     VkDescriptorSetLayoutSupport* pSupport, std::string* key) {
+    key->clear();
+    if (!pCreateInfo || !pSupport || caboose::completion::lostCall(cabooseGenerationOf(device))) return false;
+    caboose::memory::DeviceFingerprints::Fingerprint fingerprint;
+    if (!caboose::memory::deviceFingerprints.find(caboose::handle_key(device), &fingerprint)) return false;
+    uint32_t variable = 0;
+    for (auto* next = static_cast<const VkBaseOutStructure*>(pSupport->pNext); next; next = next->pNext) {
+        if (next->sType != VK_STRUCTURE_TYPE_DESCRIPTOR_SET_VARIABLE_DESCRIPTOR_COUNT_LAYOUT_SUPPORT || variable)
+            return false;
+        variable = 1;
+    }
+    std::string question = caboose::memory::StaticQueryCache::key(opcode, fingerprint.physical, fingerprint.high,
+                                                                  fingerprint.low, variable);
+    if (!caboose::memory::layoutQuestion(pCreateInfo, &question) ||
+        question.size() > caboose::memory::StaticQueryCache::kMaxKeyBytes)
+        return false;
+    *key = std::move(question);
+    caboose::memory::LayoutSupportAnswer answer;
+    if (!caboose::memory::staticQueryCache.lookup(*key, &answer)) return false;
+    pSupport->supported = answer.supported;
+    if (variable)
+        reinterpret_cast<VkDescriptorSetVariableDescriptorCountLayoutSupport*>(pSupport->pNext)
+            ->maxVariableDescriptorCount = answer.maxVariableDescriptorCount;
+    // The driver's own adjustments apply to a cached answer as to an asked one.
+    transform_fromhost_VkDescriptorSetLayoutSupport(sResourceTracker, pSupport);
+    return true;
+}
+
+// Keeps an asked answer, unless the executor was lost while it was asked (its reply is then
+// the driver's stand-in).
+void VkEncoder::cabooseKeepLayoutSupport(const std::string& key, const VkDescriptorSetLayoutSupport* pSupport) {
+    if (key.empty() || caboose::completion::executorLost.load(std::memory_order_acquire)) return;
+    caboose::memory::LayoutSupportAnswer answer;
+    answer.supported = pSupport->supported;
+    if (pSupport->pNext)
+        answer.maxVariableDescriptorCount =
+            reinterpret_cast<const VkDescriptorSetVariableDescriptorCountLayoutSupport*>(pSupport->pNext)
+                ->maxVariableDescriptorCount;
+    caboose::memory::staticQueryCache.store(key, answer);
+}
