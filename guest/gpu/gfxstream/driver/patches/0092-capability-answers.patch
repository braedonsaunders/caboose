+// Appends a device creation's pNext structures to `out`, each alone and as the executor
+// receives it. False for a structure the encoder does not know, or one that refers to memory
+// its own value does not hold (a device group's devices, a memory report's callback).
+static bool cabooseAppendDeviceChain(VulkanStreamGuest* stream, uint32_t featureBits, VkStructureType rootType,
+                                     const void* next, std::string* out) {
+    for (auto* link = static_cast<const VkBaseInStructure*>(next); link; link = link->pNext) {
+        if (link->sType == VK_STRUCTURE_TYPE_LOADER_INSTANCE_CREATE_INFO ||
+            link->sType == VK_STRUCTURE_TYPE_LOADER_DEVICE_CREATE_INFO)
+            continue;
+        if (link->sType == VK_STRUCTURE_TYPE_DEVICE_GROUP_DEVICE_CREATE_INFO ||
+            link->sType == VK_STRUCTURE_TYPE_DEVICE_DEVICE_MEMORY_REPORT_CREATE_INFO_EXT)
+            return false;
+        const size_t size = goldfish_vk_extension_struct_size_with_stream_features(featureBits, rootType, link);
+        if (!size || size > 4096) return false;
+        std::vector<uint8_t> alone(reinterpret_cast<const uint8_t*>(link), reinterpret_cast<const uint8_t*>(link) + size);
+        reinterpret_cast<VkBaseInStructure*>(alone.data())->pNext = nullptr;
+        size_t count = 0;
+        count_extension_struct(featureBits, rootType, alone.data(), &count);
+        const size_t at = out->size();
+        out->resize(at + count);
+        uint8_t* bytes = reinterpret_cast<uint8_t*>(&(*out)[at]);
+        reservedmarshal_extension_struct(stream, rootType, alone.data(), &bytes);
+        if (bytes != reinterpret_cast<uint8_t*>(&(*out)[0]) + out->size()) return false;
+    }
+    return true;
+}
+
+// A device creation's parameters, for its fingerprint (device_answers.h): its queues, its
+// extensions (in any order), its features and every pNext structure's contents.
+static bool cabooseDeviceCreation(VulkanStreamGuest* stream, uint32_t featureBits, const VkDeviceCreateInfo* info,
+                                  std::string* out) {
+    auto put = [out](const auto& value) { out->append(reinterpret_cast<const char*>(&value), sizeof(value)); };
+    if (!info || (info->queueCreateInfoCount && !info->pQueueCreateInfos) ||
+        (info->enabledExtensionCount && !info->ppEnabledExtensionNames))
+        return false;
+    put(info->flags);
+    put(info->queueCreateInfoCount);
+    for (uint32_t i = 0; i < info->queueCreateInfoCount; ++i) {
+        const VkDeviceQueueCreateInfo& queue = info->pQueueCreateInfos[i];
+        if (queue.queueCount && !queue.pQueuePriorities) return false;
+        put(queue.flags); put(queue.queueFamilyIndex); put(queue.queueCount);
+        for (uint32_t q = 0; q < queue.queueCount; ++q) put(queue.pQueuePriorities[q]);
+        if (!cabooseAppendDeviceChain(stream, featureBits, VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO, queue.pNext, out))
+            return false;
+    }
+    std::vector<std::string> extensions;
+    for (uint32_t i = 0; i < info->enabledExtensionCount; ++i) {
+        if (!info->ppEnabledExtensionNames[i]) return false;
+        extensions.emplace_back(info->ppEnabledExtensionNames[i]);
+    }
+    std::sort(extensions.begin(), extensions.end());
+    put(uint32_t(extensions.size()));
+    for (const auto& extension : extensions) out->append(extension.c_str(), extension.size() + 1);
+    put(uint32_t(info->pEnabledFeatures ? 1 : 0));
+    if (info->pEnabledFeatures) put(*info->pEnabledFeatures);
+    return cabooseAppendDeviceChain(stream, featureBits, VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO, info->pNext, out);
+}
