From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Caboose <caboose@invalid>
Date: Sat, 31 Oct 2026 00:00:00 +0000
Subject: [PATCH 22/24] Present behind device-stream order marks without
 waiting

With hello bit 0x400, VkEncoder::cabooseSendOrderMark sends a COMPLETION_ORDER
mark with the process's next order serial; the virtual WSI names it in an
ordered present instead of draining the device stream before presenting.
Serials rise with the stream only while a single encoder carries the
process's work, so with a second encoder no mark is sent and the present
drains as before.
---
 .../guest/vulkan_enc/autogenerated/VkEncoder.cpp | 16 ++++++++++++++++
 .../guest/vulkan_enc/autogenerated/VkEncoder.h   |  4 ++++
 2 files changed, 20 insertions(+)

diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
index 5d1d00b..ff01560 100644
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
+++ b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
@@ -5732,6 +5732,22 @@ bool VkEncoder::cabooseDrainDeferredReplies(uint32_t doLock) {
     return drained;
 }
 
+uint64_t VkEncoder::cabooseSendOrderMark(uint32_t doLock) {
+    // Serials rise in stream order only while one encoder carries all of the process's work.
+    static std::atomic<uint64_t> lastOrder{0};
+    if (doLock) this->lock();
+    uint64_t serial = 0;
+    if (caboose::memory::deferredReplies.singleEncoder(this)) {
+        serial = lastOrder.fetch_add(1, std::memory_order_relaxed) + 1;
+        auto stream = mImpl->stream();
+        uint8_t* packet = stream->reserve(caboose::completion::kOrderPacketSize);
+        caboose::completion::encodeOrder(packet, serial);
+        stream->flush();
+    }
+    if (doLock) this->unlock();
+    return serial;
+}
+
 bool VkEncoder::cabooseDrainDeferredObjects(uint32_t doLock) {
     if (doLock) this->lock();
     const bool drained = caboose::memory::deferredReplies.drainObjects(this, mImpl->stream());
diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.h b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.h
index 20ccc9d..9b715f5 100644
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.h
+++ b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.h
@@ -201,6 +201,10 @@ class VkEncoder {
     // later fence waits. Required before another channel (the WSI surface socket) names
     // objects or work this stream created.
     bool cabooseDrainDeferredObjects(uint32_t doLock);
+    // Sends a COMPLETION_ORDER mark and returns its serial: an ordered present naming it
+    // runs only after the device has decoded everything this stream sent before it. Zero
+    // when marks cannot order this process's work (more than one encoder).
+    uint64_t cabooseSendOrderMark(uint32_t doLock);
     VkResult cabooseBeginCommandBufferDeferred(VkCommandBuffer commandBuffer,
                                                const VkCommandBufferBeginInfo* pBeginInfo,
                                                uint32_t doLock);
