From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Caboose <caboose@invalid>
Date: Sat, 31 Oct 2026 00:00:00 +0000
Subject: [PATCH 36/36] Answer DRM format modifier lists in the guest on the
 socket transport

On the socket transport the guest answers VkDrmFormatModifierPropertiesListEXT
and its 64-bit form itself (patch 0034), but the 32-bit list still went to the
host in the format query's chain. A host whose reply did not match the guest's
array pointer desynchronised the stream, which aborted or hung the application
(libplacebo and Zink query the list). Both lists are now kept from the host and
always answered in the guest, and vkGetPhysicalDeviceFormatProperties2KHR takes
the same path as the core entry point.
---
 src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp      | 17 ++++++++++++++++-
 .../guest/vulkan_enc/autogenerated/func_table.cpp       |  6 +++---
 2 files changed, 19 insertions(+), 4 deletions(-)

diff --git a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
index 3144d1f..7c12cf5 100644
--- a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
+++ b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
@@ -8406,10 +8406,24 @@ void ResourceTracker::on_vkGetPhysicalDeviceFormatProperties2(
     void* context, VkPhysicalDevice physicalDevice, VkFormat format,
     VkFormatProperties2* pFormatProperties) {
     VkEncoder* enc = (VkEncoder*)context;
+#ifdef LINUX_GUEST_BUILD
+    // Socket mode answers both modifier lists here, so they never reach the host: its
+    // modifiers are not the guest's, and its reply would not match the guest's pointers.
+    auto* socketList = pFormatProperties && !usingDirectMapping()
+        ? vk_extract_struct<VkDrmFormatModifierPropertiesListEXT>(
+              pFormatProperties, VK_STRUCTURE_TYPE_DRM_FORMAT_MODIFIER_PROPERTIES_LIST_EXT)
+        : nullptr;
+    auto* socketList2 = pFormatProperties && !usingDirectMapping()
+        ? vk_extract_struct<VkDrmFormatModifierPropertiesList2EXT>(
+              pFormatProperties, VK_STRUCTURE_TYPE_DRM_FORMAT_MODIFIER_PROPERTIES_LIST_2_EXT)
+        : nullptr;
+#endif
     enc->vkGetPhysicalDeviceFormatProperties2(physicalDevice, format, pFormatProperties,
                                               true /* do lock */);
 
 #ifdef LINUX_GUEST_BUILD
+    if (socketList) __vk_append_struct(pFormatProperties, socketList);
+    if (socketList2) __vk_append_struct(pFormatProperties, socketList2);
     VkDrmFormatModifierPropertiesListEXT* emulatedDrmFmtModPropsList =
         vk_find_struct(pFormatProperties, DRM_FORMAT_MODIFIER_PROPERTIES_LIST_EXT);
     // The encoder has no wire form for the 64-bit list: it is always answered here.
@@ -8436,7 +8450,8 @@ void ResourceTracker::on_vkGetPhysicalDeviceFormatProperties2(
             list2->drmFormatModifierCount = list32.drmFormatModifierCount;
         }
     }
-    if (emulatedDrmFmtModPropsList && doImageDrmFormatModifierEmulation(physicalDevice)) {
+    if (emulatedDrmFmtModPropsList &&
+        (!usingDirectMapping() || doImageDrmFormatModifierEmulation(physicalDevice))) {
         if (!usingDirectMapping()) {
             fillRemoteDrmFormatModPropsList(format, &pFormatProperties->formatProperties,
                                             emulatedDrmFmtModPropsList);
diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/func_table.cpp b/src/gfxstream/guest/vulkan_enc/autogenerated/func_table.cpp
index 730111d..d50aae7 100644
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/func_table.cpp
+++ b/src/gfxstream/guest/vulkan_enc/autogenerated/func_table.cpp
@@ -3197,9 +3197,9 @@ void gfxstream_vk_GetPhysicalDeviceFormatProperties2KHR(VkPhysicalDevice physica
     VK_FROM_HANDLE(gfxstream_vk_physical_device, gfxstream_physicalDevice, physicalDevice);
     {
         auto vkEnc = gfxstream::vk::ResourceTracker::getThreadLocalEncoder();
-        vkEnc->vkGetPhysicalDeviceFormatProperties2KHR(gfxstream_physicalDevice->internal_object,
-                                                       format, pFormatProperties,
-                                                       true /* do lock */);
+        // The same query as vkGetPhysicalDeviceFormatProperties2, with its guest answers.
+        gfxstream::vk::ResourceTracker::get()->on_vkGetPhysicalDeviceFormatProperties2(
+            vkEnc, gfxstream_physicalDevice->internal_object, format, pFormatProperties);
     }
 }
 VkResult gfxstream_vk_GetPhysicalDeviceImageFormatProperties2KHR(
