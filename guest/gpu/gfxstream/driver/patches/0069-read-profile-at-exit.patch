From: Caboose <caboose@local>
Subject: [PATCH 69/72] Report the read profile at exit too

CABOOSE_READ_PROFILE reported every 2 s, so a process shorter than that (a launcher's
splash, one GL initialization) never reported, and a longer one lost its last period. The
totals not yet reported are now printed when the process exits, marked `at_exit`.
---
diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
index d623165..b1878f4 100644
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
+++ b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
@@ -59,7 +59,7 @@
 #include <string>
 #include <vector>
 namespace caboose_read_profile {
-// CABOOSE_READ_PROFILE: every 2 s, the eight largest totals of time this process spent
+// CABOOSE_READ_PROFILE: every 2 s and at exit, the eight largest totals of time this process spent
 // blocked reading device replies. `opN` is a call waiting for its own reply; `drainN` is
 // call N waiting first for earlier commands' deferred replies. `waitN` is call N waiting
 // locally (a fence or semaphore answered by the completion feed); `wait_acquire`,
@@ -123,18 +123,9 @@ inline const std::string& threadName() {
     }();
     return name;
 }
-inline void note(uint64_t us, Kind kind = kOwnReply, uint32_t opcode = currentOpcode) {
-    uint32_t idx = mapOpcodeIndex(opcode);
-    std::lock_guard<std::mutex> lock(mu);
-    totals.us[kind][idx] += us; totals.n[kind][idx] += 1;
-    if (kind == kWait && waiters.size() < 64) {
-        auto& waiter = waiters[threadName()];
-        waiter.first += us;
-        waiter.second += 1;
-    }
-    auto now = std::chrono::steady_clock::now();
-    if (now - last < std::chrono::seconds(2)) return;
-    last = now;
+// Prints and clears the totals; `mu` is held. `atExit` marks the last report of a process,
+// so a process shorter than one period still reports.
+inline void reportLocked(bool atExit) {
     uint32_t order[8] = {}; uint64_t best[8] = {};
     for (uint32_t i = 0; i < 3 * 1024; ++i) {
         uint64_t value = totals.us[i / 1024][i % 1024];
@@ -165,10 +156,36 @@ inline void note(uint64_t us, Kind kind = kOwnReply, uint32_t opcode = currentOp
         std::fprintf(stderr, "%s%s:%llums/%llu", k ? "," : " waiters=", byThread[k].second.c_str(),
                      (unsigned long long)(byThread[k].first / 1000),
                      (unsigned long long)waiters[byThread[k].second].second);
+    if (atExit) std::fprintf(stderr, " at_exit");
     std::fprintf(stderr, "\n");
     totals = Totals{};
     waiters.clear();
 }
+inline bool pending = false;
+inline void note(uint64_t us, Kind kind = kOwnReply, uint32_t opcode = currentOpcode) {
+    uint32_t idx = mapOpcodeIndex(opcode);
+    std::lock_guard<std::mutex> lock(mu);
+    static const bool registered = [] {
+        std::atexit([] {
+            std::lock_guard<std::mutex> exitLock(mu);
+            if (pending) reportLocked(true);
+        });
+        return true;
+    }();
+    (void)registered;
+    totals.us[kind][idx] += us; totals.n[kind][idx] += 1;
+    pending = true;
+    if (kind == kWait && waiters.size() < 64) {
+        auto& waiter = waiters[threadName()];
+        waiter.first += us;
+        waiter.second += 1;
+    }
+    auto now = std::chrono::steady_clock::now();
+    if (now - last < std::chrono::seconds(2)) return;
+    last = now;
+    reportLocked(false);
+    pending = false;
+}
 // CABOOSE_READ_PROFILE=1 turns the profile on; otherwise a read is only a read.
 inline bool enabled() {
     static const bool on = [] {
