             std::lock_guard<std::recursive_mutex> lock(mLock);
@@ -4621,8 +4663,10 @@ VkResult ResourceTracker::on_vkAllocateMemory(void* context, VkResult input_resu
 #endif
 
     if (ahw || bufferBlob || !requestedMemoryIsHostVisible) {
