+// Sends an allocation to the device, returning before the device answers when the
+// allocation is plain (no import, export or capture replay) and its heap keeps ample room
+// (caboose::memory::AsyncAllocationBudget). The device then registers it under the handle
+// the guest assigned; a refusal discovered later is device loss.
+static VkResult cabooseEncodeAllocateMemory(VkEncoder* enc, VkDevice device,
+                                            const VkPhysicalDeviceMemoryProperties& props,
+                                            const VkMemoryAllocateInfo* info,
+                                            const VkAllocationCallbacks* pAllocator,
+                                            VkDeviceMemory* pMemory, bool plain) {
+    bool async = false;
+    uint32_t heap = 0;
+    const uint64_t dev = uint64_t(uintptr_t(device));
+    if (info->memoryTypeIndex < props.memoryTypeCount) {
+        heap = props.memoryTypes[info->memoryTypeIndex].heapIndex;
+        for (auto* ext = static_cast<const VkBaseInStructure*>(info->pNext); plain && ext; ext = ext->pNext) {
+            if (ext->sType == VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_FLAGS_INFO) {
+                plain = !(reinterpret_cast<const VkMemoryAllocateFlagsInfo*>(ext)->flags &
+                          VK_MEMORY_ALLOCATE_DEVICE_ADDRESS_CAPTURE_REPLAY_BIT);
+            } else {
+                plain = ext->sType == VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO ||
+                        ext->sType == VK_STRUCTURE_TYPE_MEMORY_PRIORITY_ALLOCATE_INFO_EXT;
+            }
+        }
+        async = plain && heap < props.memoryHeapCount &&
+                caboose::memory::asyncAllocationBudget.reserve(dev, heap, props.memoryHeaps[heap].size,
+                                                               info->allocationSize);
+    }
+    caboose::memory::asyncAllocation = async;
+    VkResult result = enc->vkAllocateMemory(device, info, pAllocator, pMemory, true /* do lock */);
+    caboose::memory::asyncAllocation = false;
+    if (result != VK_SUCCESS) {
+        if (async) caboose::memory::asyncAllocationBudget.cancel(dev, heap, info->allocationSize);
+        return result;
+    }
+    if (!async) caboose::memory::asyncAllocationBudget.commit(dev, heap, info->allocationSize);
+    caboose::memory::asyncAllocationBudget.track(uint64_t(uintptr_t(*pMemory)), dev, heap,
+                                                 info->allocationSize);
+    return VK_SUCCESS;
+}
