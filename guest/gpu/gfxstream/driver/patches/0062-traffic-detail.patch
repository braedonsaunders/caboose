From: Caboose <caboose@local>
Subject: [PATCH 62/62] Split the coherent upkeep and upload pieces in the traffic report

CABOOSE_GPU_MEMORY_TRAFFIC also reports the bytes the coherent upkeep considered, from the
write watch or as whole mappings, the bytes flushed into staging memory, and what the upload
cache pieces went as.
---
diff --git a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
index 4b6a1be..5602298 100644
--- a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
+++ b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
@@ -1529,6 +1529,8 @@ VkResult ResourceTracker::cabooseFlushCoherentMappings(VkEncoder* enc) {
                     written.push_back(part);
                 });
             if (!watched) written.push_back(range);
+            for (const VkMappedMemoryRange& part : written)
+                caboose::memory::traffic::counters().considered(watched, part.size);
             for (const VkMappedMemoryRange& part : written) {
                 mapped.push_back(Candidate{
                     info.device, part, info.allocationSize, info.memoryTypeIndex,
diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
index af399e0..92d0be5 100644
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
+++ b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
@@ -2911,7 +2911,7 @@ VkResult VkEncoder::vkFlushMappedMemoryRanges(VkDevice device, uint32_t count,
                 timing.invalidate();
                 stream->invalidate();
             }};
-        struct Mapping { const uint8_t* base; uint64_t allocation; uint64_t offset; uint64_t size; bool staging; };
+        struct Mapping { const uint8_t* base; uint64_t allocation; uint64_t offset; uint64_t size; bool staging; bool stagingMemory; };
         caboose::memory::Reservation metadata{caboose::memory::processBudget};
         if (!metadata.add(sizeof(packet) + sizeof(timing) +
                           sizeof(VkMappedMemoryRange) * caboose::memory::flushFragmentCapacity +
@@ -2929,10 +2929,11 @@ VkResult VkEncoder::vkFlushMappedMemoryRanges(VkDevice device, uint32_t count,
                 }
                 out.offset = ranges[i].offset; out.size = ranges[i].size;
                 out.whole = ranges[i].size == VK_WHOLE_SIZE;
+                const bool stagingMemory = caboose::upload_cache::staging(
+                    sResourceTracker->cabooseBufferUsage(ranges[i].memory));
                 mappings[i] = {out.base, out.allocation, out.offset,
                                out.whole ? out.mapEnd - out.offset : out.size,
-                               uploads && caboose::upload_cache::staging(
-                                   sResourceTracker->cabooseBufferUsage(ranges[i].memory))};
+                               uploads && stagingMemory, stagingMemory};
                 return !ranges[i].pNext && ranges[i].sType == VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
             }, [&](uint32_t i, uint64_t offset, uint64_t size, uint8_t*) {
                 const uint64_t key = caboose::handle_key(ranges[i].memory);
@@ -2942,6 +2943,7 @@ VkResult VkEncoder::vkFlushMappedMemoryRanges(VkDevice device, uint32_t count,
                     return caboose::memory::flushShadow.emitChanged(
                         key, mapping.base, mapping.allocation, begin, end - begin,
                         [&](uint64_t changedOffset, uint64_t changedSize) {
+                            if (mapping.stagingMemory) caboose::memory::traffic::counters().staged(changedSize);
                             return packet.push(i, changedOffset, changedSize);
                         });
                 };
@@ -2959,6 +2961,7 @@ VkResult VkEncoder::vkFlushMappedMemoryRanges(VkDevice device, uint32_t count,
                     if (caboose::memory::flushShadow.unchanged(key, mapping.base, mapping.allocation, piece,
                                                                caboose::upload_cache::kPieceBytes)) {
                         caboose::upload_cache::counts().unchanged.fetch_add(1, std::memory_order_relaxed);
+                        caboose::memory::traffic::counters().piece(caboose::memory::traffic::unchangedPiece);
                         continue;
                     }
                     caboose::upload_cache::Prefix prefix;
@@ -2966,6 +2969,10 @@ VkResult VkEncoder::vkFlushMappedMemoryRanges(VkDevice device, uint32_t count,
                         caboose::upload_cache::inventory(), *mImpl->uploadKnown(), mapping.base + piece,
                         mapping.staging, cabooseUploadPrefix, &prefix);
                     if (kind == caboose::upload_cache::literal) continue;
+                    caboose::memory::traffic::counters().piece(kind == caboose::upload_cache::store
+                        ? caboose::memory::traffic::storedPiece : caboose::memory::traffic::namedPiece);
+                    if (kind == caboose::upload_cache::store && mapping.stagingMemory)
+                        caboose::memory::traffic::counters().staged(caboose::upload_cache::kPieceBytes);
                     int result = changed(pending, piece);
                     if (result != caboose::memory::success) return result;
                     caboose::memory::flushShadow.noteRefreshed(key, mapping.base, mapping.allocation,
