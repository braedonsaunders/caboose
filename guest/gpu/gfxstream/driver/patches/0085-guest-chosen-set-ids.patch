From: Caboose <caboose@local>
Subject: [PATCH 85/88] Choose batched descriptor pools' set ids in the guest

With batched descriptor sets a pool asked the phone for the set ids it made at the pool's
creation (vkCollectDescriptorPoolIdsGOOGLE). 0071 stopped waiting at the create, but the pool's
first allocation still drained every reply owed before the ids: about 33 ms each, 429 ms in five
seconds of Halo. With hello 0x100000 the pool instead takes 1 + maxSets consecutive guest
handles, its own and its sets', marks its create info with the guest-chosen-ids flag the
decoder takes off before the driver sees it, and fills its free ids locally
(caboose-bounded-memory/guest_set_ids.h). Nothing is asked and nothing waits. Without the
feature, or for a pool too large for one handle block, the ids are asked for as before.
---
diff --git a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
--- a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
+++ b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
@@ -11,6 +11,7 @@
 
 #include "ResourceTracker.h"
 #include "caboose-bounded-memory/deferred_destroys.h"
+#include "caboose-bounded-memory/guest_set_ids.h"
 #include "caboose-bounded-memory/static_query_cache.h"
 #include "caboose-bounded-memory/source_identity.h"
 
@@ -6490,8 +6491,13 @@ VkResult ResourceTracker::on_vkCreateDescriptorPool(void* context, VkResult, VkD
                                                     VkDescriptorPool* pDescriptorPool) {
     VkEncoder* enc = (VkEncoder*)context;
 
+    // Caboose: a batched pool may choose its set ids (hello 0x100000); the encoder names the
+    // pool's handle here when it did (caboose-bounded-memory/guest_set_ids.h).
+    uint64_t guestSetIdsPool = 0;
+    caboose::memory::guest_set_ids::request = cabooseBatchedSets() ? &guestSetIdsPool : nullptr;
     VkResult res = enc->vkCreateDescriptorPool(device, pCreateInfo, pAllocator, pDescriptorPool,
                                                true /* do lock */);
+    caboose::memory::guest_set_ids::request = nullptr;
 
     if (res != VK_SUCCESS) return res;
 
@@ -6511,7 +6517,11 @@ VkResult ResourceTracker::on_vkCreateDescriptorPool(void* context, VkResult, VkD
         });
     }
 
-    if (cabooseBatchedSets()) {
+    if (guestSetIdsPool) {
+        // The ids are the handles after the pool's: nothing to ask, nothing to wait for.
+        dp->allocInfo->freePoolIds =
+            caboose::memory::guest_set_ids::ids(guestSetIdsPool, pCreateInfo->maxSets);
+    } else if (cabooseBatchedSets()) {
         std::vector<uint64_t> poolIds(pCreateInfo->maxSets);
 
         uint32_t count = pCreateInfo->maxSets;
diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
+++ b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
@@ -6,6 +6,7 @@
 #include "caboose-bounded-memory/rpc_timing.h"
 #include "caboose-bounded-memory/cb_staging.h"
 #include "caboose-bounded-memory/deferred_replies.h"
+#include "caboose-bounded-memory/guest_set_ids.h"
 #include "caboose-bounded-memory/deferred_destroys.h"
 #include "caboose-bounded-memory/presentation_retirement.h"
 #include "caboose-bounded-memory/event_status.h"
@@ -367,6 +368,8 @@ static void cabooseUploadPrefix(const uint8_t* piece, caboose::upload_cache::Pre
 // 1 when the guest also assigns query pool handles (hello feature 0x1000, SocketStream.cpp).
 extern "C" int caboose_gfxstream_guest_query_pools;
 extern "C" int caboose_gfxstream_guest_buffer_views;
+// 1 when the guest chooses its batched descriptor pools' set ids (hello feature 0x100000).
+extern "C" int caboose_gfxstream_guest_set_ids;
 namespace caboose_guest_handles {
 // Negotiated by the device stream's hello (SocketStream.cpp), never assumed.
 inline bool enabled() { return caboose_gfxstream_guest_handles == 1; }
@@ -10421,6 +10424,12 @@ VkResult VkEncoder::vkCreateDescriptorPool(VkDevice device,
     auto stream = mImpl->stream();
     caboose_read_profile::currentOpcode = OP_vkCreateDescriptorPool;
     if (!(caboose_guest_handles::enabled() && pDescriptorPool)) caboose::memory::deferredReplies.drain(this, stream);
+    // Caboose: with hello 0x100000 a pool the tracker asks for takes 1 + maxSets guest handles,
+    // its own and its sets' ids, and says so in its flags (caboose-bounded-memory/guest_set_ids.h).
+    const bool cabooseGuestSetIds =
+        caboose::memory::guest_set_ids::request && caboose_guest_handles::enabled() && pDescriptorPool &&
+        pCreateInfo && caboose::memory::guest_set_ids::fits(pCreateInfo->maxSets) &&
+        __atomic_load_n(&caboose_gfxstream_guest_set_ids, __ATOMIC_ACQUIRE) == 1;
     auto pool = mImpl->pool();
     VkDevice local_device;
     VkDescriptorPoolCreateInfo* local_pCreateInfo;
@@ -10432,6 +10441,7 @@ VkResult VkEncoder::vkCreateDescriptorPool(VkDevice device,
             (VkDescriptorPoolCreateInfo*)pool->alloc(sizeof(const VkDescriptorPoolCreateInfo));
         deepcopy_VkDescriptorPoolCreateInfo(pool, VK_STRUCTURE_TYPE_MAX_ENUM, pCreateInfo,
                                             (VkDescriptorPoolCreateInfo*)(local_pCreateInfo));
+        if (cabooseGuestSetIds) local_pCreateInfo->flags |= caboose::memory::guest_set_ids::kPoolFlag;
     }
     // Deepcopy intentionally skipped for `const VkAllocationCallbacks* pAllocator`
     local_pAllocator = nullptr;
@@ -10497,7 +10507,12 @@ VkResult VkEncoder::vkCreateDescriptorPool(VkDevice device,
     /* is handle, possibly out */;
     uint64_t cgen_var_2;
     const bool cabooseGuestHandle = caboose_guest_handles::enabled() && pDescriptorPool;
-    if (cabooseGuestHandle) *pDescriptorPool = caboose::to_handle<VkDescriptorPool>(caboose_guest_handles::next());
+    if (cabooseGuestHandle) {
+        const uint64_t cabooseHandle = cabooseGuestSetIds
+            ? caboose_guest_handles::nextBlock(1 + pCreateInfo->maxSets) : caboose_guest_handles::next();
+        *pDescriptorPool = caboose::to_handle<VkDescriptorPool>(cabooseHandle);
+        if (cabooseGuestSetIds) *caboose::memory::guest_set_ids::request = cabooseHandle;
+    }
     *&cgen_var_2 = (uint64_t)((*pDescriptorPool));
     memcpy(*streamPtrPtr, (uint64_t*)&cgen_var_2, 8);
     *streamPtrPtr += 8;
