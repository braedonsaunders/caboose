From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Caboose <caboose@invalid>
Date: Sat, 31 Oct 2026 00:00:00 +0000
Subject: [PATCH 24/25] Answer format queries from earlier identical ones

Format and image-format properties of a physical device cannot change, so the
encoder keeps each answer to vkGetPhysicalDeviceFormatProperties(2) and
vkGetPhysicalDeviceImageFormatProperties(2) asked without extension structures,
keyed by the query's exact parameters (caboose-bounded-memory/
static_query_cache.h), and asks the device only once.
---
 .../guest/vulkan_enc/ResourceTracker.h        |  1 +
 .../vulkan_enc/autogenerated/VkEncoder.cpp    | 72 +++++++++++++++++++
 2 files changed, 73 insertions(+)

diff --git a/src/gfxstream/guest/vulkan_enc/ResourceTracker.h b/src/gfxstream/guest/vulkan_enc/ResourceTracker.h
index 4276e11..49ef1ff 100644
--- a/src/gfxstream/guest/vulkan_enc/ResourceTracker.h
+++ b/src/gfxstream/guest/vulkan_enc/ResourceTracker.h
@@ -6,6 +6,7 @@
 #include "caboose-bounded-memory/async_allocation.h"
 #include "caboose-bounded-memory/requirements_cache.h"
 #include "caboose-bounded-memory/completion_feed.h"
+#include "caboose-bounded-memory/static_query_cache.h"
 /*
  * Copyright 2018 Google
  * SPDX-License-Identifier: MIT
diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
index 9cf94d4..9785af4 100644
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
+++ b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
@@ -711,6 +711,10 @@ void VkEncoder::vkGetPhysicalDeviceFormatProperties(VkPhysicalDevice physicalDev
                                                     VkFormatProperties* pFormatProperties,
                                                     uint32_t doLock) {
     (void)doLock;
+    // Format properties never change for a physical device: asked once.
+    const std::string cabooseKey = caboose::memory::StaticQueryCache::key(
+        uint32_t(OP_vkGetPhysicalDeviceFormatProperties), uint64_t(uintptr_t(physicalDevice)), format);
+    if (pFormatProperties && caboose::memory::staticQueryCache.lookup(cabooseKey, pFormatProperties)) return;
     bool queueSubmitWithCommandsEnabled =
         sFeatureBits & VULKAN_STREAM_FEATURE_QUEUE_SUBMIT_WITH_COMMANDS_BIT;
     if (!queueSubmitWithCommandsEnabled && doLock) this->lock();
@@ -766,6 +770,7 @@ void VkEncoder::vkGetPhysicalDeviceFormatProperties(VkPhysicalDevice physicalDev
         pool->freeAll();
         stream->clearPool();
     }
+    if (pFormatProperties) caboose::memory::staticQueryCache.store(cabooseKey, *pFormatProperties);
     if (!queueSubmitWithCommandsEnabled && doLock) this->unlock();
 }
 
@@ -774,6 +779,18 @@ VkResult VkEncoder::vkGetPhysicalDeviceImageFormatProperties(
     VkImageUsageFlags usage, VkImageCreateFlags flags,
     VkImageFormatProperties* pImageFormatProperties, uint32_t doLock) {
     (void)doLock;
+    // Image format properties never change for a physical device: asked once.
+    struct CabooseAnswer { VkResult result; VkImageFormatProperties properties; };
+    const std::string cabooseKey = caboose::memory::StaticQueryCache::key(
+        uint32_t(OP_vkGetPhysicalDeviceImageFormatProperties), uint64_t(uintptr_t(physicalDevice)), format, type,
+        tiling, usage, flags);
+    if (pImageFormatProperties) {
+        CabooseAnswer cached;
+        if (caboose::memory::staticQueryCache.lookup(cabooseKey, &cached)) {
+            *pImageFormatProperties = cached.properties;
+            return cached.result;
+        }
+    }
     bool queueSubmitWithCommandsEnabled =
         sFeatureBits & VULKAN_STREAM_FEATURE_QUEUE_SUBMIT_WITH_COMMANDS_BIT;
     if (!queueSubmitWithCommandsEnabled && doLock) this->lock();
@@ -852,6 +869,9 @@ VkResult VkEncoder::vkGetPhysicalDeviceImageFormatProperties(
         pool->freeAll();
         stream->clearPool();
     }
+    if (pImageFormatProperties)
+        caboose::memory::staticQueryCache.store(cabooseKey, CabooseAnswer{
+            vkGetPhysicalDeviceImageFormatProperties_VkResult_return, *pImageFormatProperties});
     if (!queueSubmitWithCommandsEnabled && doLock) this->unlock();
     return vkGetPhysicalDeviceImageFormatProperties_VkResult_return;
 }
@@ -13666,6 +13686,12 @@ void VkEncoder::vkGetPhysicalDeviceFormatProperties2(VkPhysicalDevice physicalDe
                                                      VkFormatProperties2* pFormatProperties,
                                                      uint32_t doLock) {
     (void)doLock;
+    // Format properties never change for a physical device: asked once (without extensions).
+    const bool cabooseCacheable = pFormatProperties && !pFormatProperties->pNext;
+    const std::string cabooseKey = caboose::memory::StaticQueryCache::key(
+        uint32_t(OP_vkGetPhysicalDeviceFormatProperties2), uint64_t(uintptr_t(physicalDevice)), format);
+    if (cabooseCacheable && caboose::memory::staticQueryCache.lookup(cabooseKey, &pFormatProperties->formatProperties))
+        return;
     bool queueSubmitWithCommandsEnabled =
         sFeatureBits & VULKAN_STREAM_FEATURE_QUEUE_SUBMIT_WITH_COMMANDS_BIT;
     if (!queueSubmitWithCommandsEnabled && doLock) this->lock();
@@ -13721,6 +13747,7 @@ void VkEncoder::vkGetPhysicalDeviceFormatProperties2(VkPhysicalDevice physicalDe
         pool->freeAll();
         stream->clearPool();
     }
+    if (cabooseCacheable) caboose::memory::staticQueryCache.store(cabooseKey, pFormatProperties->formatProperties);
     if (!queueSubmitWithCommandsEnabled && doLock) this->unlock();
 }
 
@@ -13728,6 +13755,22 @@ VkResult VkEncoder::vkGetPhysicalDeviceImageFormatProperties2(
     VkPhysicalDevice physicalDevice, const VkPhysicalDeviceImageFormatInfo2* pImageFormatInfo,
     VkImageFormatProperties2* pImageFormatProperties, uint32_t doLock) {
     (void)doLock;
+    // Image format properties never change for a physical device: asked once (without extensions).
+    struct CabooseAnswer { VkResult result; VkImageFormatProperties properties; };
+    const bool cabooseCacheable = pImageFormatInfo && !pImageFormatInfo->pNext && pImageFormatProperties &&
+                                  !pImageFormatProperties->pNext;
+    std::string cabooseKey;
+    if (cabooseCacheable) {
+        cabooseKey = caboose::memory::StaticQueryCache::key(
+            uint32_t(OP_vkGetPhysicalDeviceImageFormatProperties2), uint64_t(uintptr_t(physicalDevice)),
+            pImageFormatInfo->format, pImageFormatInfo->type, pImageFormatInfo->tiling, pImageFormatInfo->usage,
+            pImageFormatInfo->flags);
+        CabooseAnswer cached;
+        if (caboose::memory::staticQueryCache.lookup(cabooseKey, &cached)) {
+            pImageFormatProperties->imageFormatProperties = cached.properties;
+            return cached.result;
+        }
+    }
     bool queueSubmitWithCommandsEnabled =
         sFeatureBits & VULKAN_STREAM_FEATURE_QUEUE_SUBMIT_WITH_COMMANDS_BIT;
     if (!queueSubmitWithCommandsEnabled && doLock) this->lock();
@@ -13801,6 +13844,9 @@ VkResult VkEncoder::vkGetPhysicalDeviceImageFormatProperties2(
         pool->freeAll();
         stream->clearPool();
     }
+    if (cabooseCacheable)
+        caboose::memory::staticQueryCache.store(cabooseKey, CabooseAnswer{
+            vkGetPhysicalDeviceImageFormatProperties2_VkResult_return, pImageFormatProperties->imageFormatProperties});
     if (!queueSubmitWithCommandsEnabled && doLock) this->unlock();
     return vkGetPhysicalDeviceImageFormatProperties2_VkResult_return;
 }
@@ -20399,6 +20445,12 @@ void VkEncoder::vkGetPhysicalDeviceFormatProperties2KHR(VkPhysicalDevice physica
                                                         VkFormatProperties2* pFormatProperties,
                                                         uint32_t doLock) {
     (void)doLock;
+    // Format properties never change for a physical device: asked once (without extensions).
+    const bool cabooseCacheable = pFormatProperties && !pFormatProperties->pNext;
+    const std::string cabooseKey = caboose::memory::StaticQueryCache::key(
+        uint32_t(OP_vkGetPhysicalDeviceFormatProperties2), uint64_t(uintptr_t(physicalDevice)), format);
+    if (cabooseCacheable && caboose::memory::staticQueryCache.lookup(cabooseKey, &pFormatProperties->formatProperties))
+        return;
     bool queueSubmitWithCommandsEnabled =
         sFeatureBits & VULKAN_STREAM_FEATURE_QUEUE_SUBMIT_WITH_COMMANDS_BIT;
     if (!queueSubmitWithCommandsEnabled && doLock) this->lock();
@@ -20454,6 +20506,7 @@ void VkEncoder::vkGetPhysicalDeviceFormatProperties2KHR(VkPhysicalDevice physica
         pool->freeAll();
         stream->clearPool();
     }
+    if (cabooseCacheable) caboose::memory::staticQueryCache.store(cabooseKey, pFormatProperties->formatProperties);
     if (!queueSubmitWithCommandsEnabled && doLock) this->unlock();
 }
 
@@ -20461,6 +20514,22 @@ VkResult VkEncoder::vkGetPhysicalDeviceImageFormatProperties2KHR(
     VkPhysicalDevice physicalDevice, const VkPhysicalDeviceImageFormatInfo2* pImageFormatInfo,
     VkImageFormatProperties2* pImageFormatProperties, uint32_t doLock) {
     (void)doLock;
+    // Image format properties never change for a physical device: asked once (without extensions).
+    struct CabooseAnswer { VkResult result; VkImageFormatProperties properties; };
+    const bool cabooseCacheable = pImageFormatInfo && !pImageFormatInfo->pNext && pImageFormatProperties &&
+                                  !pImageFormatProperties->pNext;
+    std::string cabooseKey;
+    if (cabooseCacheable) {
+        cabooseKey = caboose::memory::StaticQueryCache::key(
+            uint32_t(OP_vkGetPhysicalDeviceImageFormatProperties2), uint64_t(uintptr_t(physicalDevice)),
+            pImageFormatInfo->format, pImageFormatInfo->type, pImageFormatInfo->tiling, pImageFormatInfo->usage,
+            pImageFormatInfo->flags);
+        CabooseAnswer cached;
+        if (caboose::memory::staticQueryCache.lookup(cabooseKey, &cached)) {
+            pImageFormatProperties->imageFormatProperties = cached.properties;
+            return cached.result;
+        }
+    }
     bool queueSubmitWithCommandsEnabled =
         sFeatureBits & VULKAN_STREAM_FEATURE_QUEUE_SUBMIT_WITH_COMMANDS_BIT;
     if (!queueSubmitWithCommandsEnabled && doLock) this->lock();
@@ -20534,6 +20603,9 @@ VkResult VkEncoder::vkGetPhysicalDeviceImageFormatProperties2KHR(
         pool->freeAll();
         stream->clearPool();
     }
+    if (cabooseCacheable)
+        caboose::memory::staticQueryCache.store(cabooseKey, CabooseAnswer{
+            vkGetPhysicalDeviceImageFormatProperties2KHR_VkResult_return, pImageFormatProperties->imageFormatProperties});
     if (!queueSubmitWithCommandsEnabled && doLock) this->unlock();
     return vkGetPhysicalDeviceImageFormatProperties2KHR_VkResult_return;
 }
