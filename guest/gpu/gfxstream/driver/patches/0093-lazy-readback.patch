 // The size of a chained structure the encoder can marshal, 0 for any other.
 static size_t cabooseChainSize(VkStructureType root, const void* extension) {
     return goldfish_vk_extension_struct_size(root, extension);
@@ -3258,6 +3272,14 @@ VkResult VkEncoder::vkFlushMappedMemoryRanges(VkDevice device, uint32_t count,
         struct Unlock { VkEncoder* encoder; bool held; ~Unlock() { if (held) encoder->unlock(); } };
