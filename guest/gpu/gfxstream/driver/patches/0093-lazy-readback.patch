+// Caboose: whether the command buffers copy into coherent memory whose bytes their batch's
+// completion record carries (captured). Their other writes are read back after a wait, lazily
+// or behind the device stream's WAIT_SERIAL, so they keep a batch speculable.
+bool ResourceTracker::cabooseHasCommandBuffersCapturedWrites(const std::vector<uint64_t>& commandBuffers) {
+    if (commandBuffers.empty()) return false;
+    std::lock_guard<ResourceTracker::TrackerMutex> lock(mLock);
+    for (uint64_t cb : commandBuffers) {
+        auto it = mCabooseCommandDirtyRanges.find(cb);
+        if (it == mCabooseCommandDirtyRanges.end()) continue;
+        for (const auto& r : it->second)
+            if (r.captured) return true;
+    }
+    return false;
+}
