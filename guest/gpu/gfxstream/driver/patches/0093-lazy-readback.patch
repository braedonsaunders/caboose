+#ifdef CABOOSE_GFXSTREAM_PRIVATE_ICD
+// Caboose: a Vulkan encoder on a second connection of this process (lazy readback's fills,
+// caboose-bounded-memory/write_watch.h): it reads memory beside the device stream, with a lock
+// of its own. Its hello sets nothing of the process's (SocketStream.cpp); it is never freed,
+// as the process's own connection is not.
+extern "C" void caboose_gfxstream_connect_auxiliary(int on);
+extern "C" void* caboose_gfxstream_auxiliary_encoder(void** stream);
+extern "C" void* caboose_gfxstream_auxiliary_encoder(void** stream) {
+    if (!std::getenv("CABOOSE_GFXSTREAM_SOCKET")) return nullptr;
+    auto* manager = new GfxStreamConnectionManager(renderControlGetTransport(), kCapsetGfxStreamVulkan);
+    caboose_gfxstream_connect_auxiliary(1);
+    const bool connected = manager->initialize();
+    caboose_gfxstream_connect_auxiliary(0);
+    if (!connected) {
+        delete manager;
+        return nullptr;
+    }
+    if (stream) *stream = manager->getStream();
+    return new gfxstream::vk::VkEncoder(manager->getStream());
+}
