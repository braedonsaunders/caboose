+// Lazy readback (caboose-bounded-memory/write_watch.h): reads blocks of an allocation from the
+// phone into `out`, for a fill on first use. With `locked` the caller holds the encoder.
+static bool cabooseLazyFetch(uint64_t device, uint64_t memory, uint64_t offset, uint64_t size, uint8_t* out,
+                             bool locked) {
+    if (caboose::completion::executorLost.load(std::memory_order_acquire)) return false;
+    VkEncoder* enc = ResourceTracker::getThreadLocalEncoder();
+    if (!enc) return false;
+    VkMappedMemoryRange range{VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE, nullptr,
+                              caboose::to_handle<VkDeviceMemory>(memory), offset, size};
+    return enc->cabooseInvalidateMemoryChunk(reinterpret_cast<VkDevice>(uintptr_t(device)), 1, &range,
+                                             locked ? 0 : 1, out) == VK_SUCCESS;
+}
