+        // Lazy blocks of what is sent are filled first (caboose-bounded-memory/write_watch.h):
+        // the encoder never reads one while it holds itself.
+        for (uint32_t i = 0; i < count; ++i) {
+            caboose::memory::Range mapped;
+            if (!sResourceTracker->cabooseMappedRange(device, ranges[i].memory, mapped)) continue;
+            const uint64_t end = ranges[i].size == VK_WHOLE_SIZE ? mapped.mapEnd : ranges[i].offset + ranges[i].size;
+            caboose::memory::writeWatch().settle(mapped.base, ranges[i].offset, end, true);
+        }
         auto stream = mImpl->stream();
         // Upload cache pieces (docs/gpu-live.md, "Upload cache"): the process asks for the
         // store's prefixes once per executor, before its first cacheable flush.
@@ -3405,6 +3427,51 @@ VkResult VkEncoder::vkInvalidateMappedMemoryRanges(VkDevice device, uint32_t cou
         struct Unlock { VkEncoder* encoder; bool held; ~Unlock() { if (held) encoder->unlock(); } };
         if (!queueSubmitWithCommandsEnabled && doLock) this->lock();
         Unlock unlock{this, !queueSubmitWithCommandsEnabled && doLock != 0};
+        // Lazy readback (caboose-bounded-memory/write_watch.h): the blocks of watched coherent
+        // memory that can wait for their first use are filled then, from the phone; the rest of
+        // each range is read now. Decided with the encoder held, so no read or write the
+        // encoder makes meanwhile meets a block made lazy.
+        std::vector<VkMappedMemoryRange> pieces;
+        caboose::memory::writeWatch().setFetch(&cabooseLazyFetch);
+        const uint64_t page = uint64_t(sysconf(_SC_PAGESIZE));
+        for (uint32_t i = 0; i < count; ++i) {
+            caboose::memory::Range mapped;
+            const bool known = !ranges[i].pNext && ranges[i].sType == VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE &&
+                               sResourceTracker->cabooseMappedRange(device, ranges[i].memory, mapped);
+            const uint64_t atom = known ? std::max<uint64_t>(1, mapped.atom) : 1;
+            const uint64_t begin = ranges[i].offset;
+            const uint64_t end = !known ? 0 : ranges[i].size == VK_WHOLE_SIZE ? mapped.mapEnd
+                                 : ranges[i].size > mapped.allocation - std::min(begin, mapped.allocation)
+                                     ? mapped.allocation : begin + ranges[i].size;
+            if (!known || begin >= end || caboose::memory::watchBlockBytes % atom || page % atom) {
+                pieces.push_back(ranges[i]);
+                continue;
+            }
+            uint64_t from = begin;
+            caboose::memory::writeWatch().makeLazy(mapped.base, caboose::handle_key(device),
+                caboose::handle_key(ranges[i].memory), mapped.allocation, mapped.mapBegin, mapped.mapEnd, begin, end,
+                [&](uint64_t lazyBegin, uint64_t lazyEnd) {
+                    if (lazyBegin > from) {
+                        VkMappedMemoryRange piece = ranges[i];
+                        piece.offset = from; piece.size = lazyBegin - from;
+                        pieces.push_back(piece);
+                    }
+                    from = lazyEnd;
+                    // The host's copy of a lazy block is not known here until it is filled.
+                    caboose::memory::flushShadow.forgetRange(caboose::handle_key(ranges[i].memory), lazyBegin,
+                                                             lazyEnd);
+                });
+            if (from == begin) {
+                pieces.push_back(ranges[i]);
+            } else if (from < end) {
+                VkMappedMemoryRange piece = ranges[i];
+                piece.offset = from; piece.size = ranges[i].size == VK_WHOLE_SIZE ? VK_WHOLE_SIZE : end - from;
+                pieces.push_back(piece);
+            }
+        }
+        if (pieces.empty()) return VK_SUCCESS;
+        ranges = pieces.data();
+        count = uint32_t(pieces.size());
         struct Mapping { const uint8_t* base; uint64_t allocation; uint64_t offset; uint64_t size; };
         caboose::memory::Reservation metadata{caboose::memory::processBudget};
