+// Lazy readback (caboose-bounded-memory/write_watch.h): reads blocks of an allocation from the
+// phone into `out`, for a fill on first use, on a connection of the process's own beside the
+// device stream (gfxstream_vk_device.cpp): no lock a faulting thread may hold is taken. It
+// always returns: a device of an executor the process no longer has, or no executor, is not
+// asked (the fill stores zeros, as the lost device's memory reads), the connection ends with
+// its executor (cabooseLazyEncoderLost), and a new executor gets a new connection.
+extern "C" void* caboose_gfxstream_auxiliary_encoder(void** stream);
+static std::mutex& cabooseLazyEncoderMutex = *new std::mutex;
+static VkEncoder* cabooseLazyEncoderValue = nullptr;
+static gfxstream::guest::IOStream* cabooseLazyStream = nullptr;
+static uint64_t cabooseLazyEncoderGeneration = 0;
+static bool cabooseLazyDeviceLost(uint64_t device) {
+    return caboose::completion::executorLost.load(std::memory_order_acquire) ||
+           cabooseGenerationOf(reinterpret_cast<VkDevice>(uintptr_t(device))) !=
+               caboose::completion::connectionGeneration.load(std::memory_order_acquire);
+}
+// The executor is gone: a fill reading from it is ended at once, never left waiting.
+static void cabooseLazyEncoderLost() {
+    std::lock_guard<std::mutex> lock(cabooseLazyEncoderMutex);
+    if (cabooseLazyStream) cabooseLazyStream->invalidate();
+}
+static const bool cabooseLazyLossHooked = caboose::completion::onExecutorLost(&cabooseLazyEncoderLost);
+static bool cabooseLazyFetch(uint64_t device, uint64_t memory, uint64_t offset, uint64_t size, uint8_t* out,
+                             uint64_t after) {
+    (void)cabooseLazyLossHooked;
+    if (cabooseLazyDeviceLost(device)) return false;
+    // Writes of a submission a wait reported complete before its record came: read once it
+    // has completed (the tracker's wait also ends with the executor).
+    if (after) caboose::completion::tracker().waitCompleted(after);
+    if (cabooseLazyDeviceLost(device)) return false;
+    VkEncoder* enc = nullptr;
+    {
+        std::lock_guard<std::mutex> lock(cabooseLazyEncoderMutex);
+        const uint64_t generation = caboose::completion::connectionGeneration.load(std::memory_order_acquire);
+        if (!cabooseLazyEncoderValue || cabooseLazyEncoderGeneration != generation) {
+            // An earlier executor's connection is left as it is: it may still be in use.
+            void* stream = nullptr;
+            cabooseLazyEncoderValue = static_cast<VkEncoder*>(caboose_gfxstream_auxiliary_encoder(&stream));
+            cabooseLazyStream = static_cast<gfxstream::guest::IOStream*>(stream);
+            cabooseLazyEncoderGeneration = generation;
+        }
+        enc = cabooseLazyEncoderValue;
+    }
+    if (!enc) return false;
+    VkMappedMemoryRange range{VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE, nullptr,
+                              caboose::to_handle<VkDeviceMemory>(memory), offset, size};
+    return enc->cabooseInvalidateMemoryChunk(reinterpret_cast<VkDevice>(uintptr_t(device)), 1, &range, 1, out) ==
+           VK_SUCCESS;
+}
