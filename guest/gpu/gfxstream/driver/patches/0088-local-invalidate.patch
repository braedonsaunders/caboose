+VkDeviceSize ResourceTracker::cabooseImageCopyBytes(VkImage image, VkImageAspectFlags aspect, uint32_t rowLength,
+                                                    uint32_t imageHeight, VkExtent3D extent, uint32_t baseLayer,
+                                                    uint32_t layerCount) {
+    VkFormat format = VK_FORMAT_UNDEFINED;
+    uint32_t layers = layerCount;
+    {
+        std::lock_guard<ResourceTracker::TrackerMutex> lock(mLock);
+        auto found = info_VkImage.find(image);
+        if (found == info_VkImage.end()) return VK_WHOLE_SIZE;
+        format = found->second.createInfo.format;
+        if (layerCount == VK_REMAINING_ARRAY_LAYERS)
+            layers = found->second.createInfo.arrayLayers > baseLayer ? found->second.createInfo.arrayLayers - baseLayer : 0;
+    }
+    // One aspect of the format, as a copy names it: a depth or stencil part, or a plane.
+    if (format == VK_FORMAT_UNDEFINED || __builtin_popcount(aspect) != 1 || !(vk_format_aspects(format) & aspect))
+        return VK_WHOLE_SIZE;
+    constexpr VkImageAspectFlags kCopyAspects = VK_IMAGE_ASPECT_COLOR_BIT | VK_IMAGE_ASPECT_DEPTH_BIT |
+        VK_IMAGE_ASPECT_STENCIL_BIT | VK_IMAGE_ASPECT_PLANE_0_BIT | VK_IMAGE_ASPECT_PLANE_1_BIT |
+        VK_IMAGE_ASPECT_PLANE_2_BIT;
+    if (!(aspect & kCopyAspects)) return VK_WHOLE_SIZE;
+    const VkFormat part = vk_format_get_aspect_format(format, aspect);
+    const uint64_t bytes = caboose::memory::gpu::imageCopyBytes(
+        vk_format_get_blocksize(part), vk_format_get_blockwidth(part), vk_format_get_blockheight(part), rowLength,
+        imageHeight, extent.width, extent.height, uint64_t(std::max<uint32_t>(1, extent.depth)) * layers);
+    return bytes && bytes != UINT64_MAX ? VkDeviceSize(bytes) : VK_WHOLE_SIZE;
