From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Caboose <caboose@invalid>
Date: Sun, 1 Nov 2026 00:00:00 +0000
Subject: [PATCH 51/51] Answer vkGetEventStatus from the completion feed

A D3D11 event query is a VkEvent set by a command buffer and polled with
vkGetEventStatus, one phone round trip per poll (Halo: Combat Evolved's load
polled one about three times a second). Events are now followed in the
completion tracker (../bounded-memory/completion_feed.h): created reset, set
or reset on the host, and set or reset by a submitted command buffer
(secondaries included) once its batch completes. A batch that touches an
event is watched even without a fence or timeline signal, and the status is
answered locally; an event the tracker cannot follow is asked on the device
as before.

diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
index 205b1a1..59eec87 100644
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
+++ b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
@@ -374,22 +374,37 @@ static void cabooseAddTimelineSignals(const VkSubmitInfo2& submit,
         out->push_back({caboose::handle_key(submit.pSignalSemaphoreInfos[i].semaphore),
                         submit.pSignalSemaphoreInfos[i].value});
 }
+static void cabooseAddCommandBuffers(const VkSubmitInfo& submit, std::vector<uint64_t>* out) {
+    for (uint32_t i = 0; submit.pCommandBuffers && i < submit.commandBufferCount; ++i)
+        out->push_back(caboose::handle_key(submit.pCommandBuffers[i]));
+}
+static void cabooseAddCommandBuffers(const VkSubmitInfo2& submit, std::vector<uint64_t>* out) {
+    for (uint32_t i = 0; submit.pCommandBufferInfos && i < submit.commandBufferInfoCount; ++i)
+        out->push_back(caboose::handle_key(submit.pCommandBufferInfos[i].commandBuffer));
+}
 template <class Stream, class Submit>
 static void cabooseWatchSubmission(Stream* stream, VkQueue queue, uint32_t submitCount,
                                    const Submit* submits, VkFence fence) {
     std::vector<std::pair<uint64_t, uint64_t>> signals;
-    for (uint32_t i = 0; submits && i < submitCount; ++i) cabooseAddTimelineSignals(submits[i], &signals);
-    if (fence == VK_NULL_HANDLE && signals.empty()) return;
+    std::vector<uint64_t> commandBuffers;
+    for (uint32_t i = 0; submits && i < submitCount; ++i) {
+        cabooseAddTimelineSignals(submits[i], &signals);
+        cabooseAddCommandBuffers(submits[i], &commandBuffers);
+    }
+    // A batch that sets or resets an event is watched too: the event's state follows it.
+    const bool events = caboose::completion::tracker().setsEvents(commandBuffers);
+    if (fence == VK_NULL_HANDLE && signals.empty() && !events) return;
     if (!caboose::completion::feedActive.load(std::memory_order_acquire)) {
         // Without a running feed nothing will report this submission: its objects are
         // asked about on the device stream until they are reset.
         if (fence != VK_NULL_HANDLE) caboose::completion::tracker().fenceUntracked(caboose::handle_key(fence));
         for (const auto& signal : signals) caboose::completion::tracker().semaphoreUntracked(signal.first);
+        if (events) caboose::completion::tracker().eventsUntracked(commandBuffers);
         return;
     }
     const uint64_t serial = caboose::completion::tracker().submitted(
         caboose::handle_key(fence), signals, caboose::handle_key(queue),
-        caboose::handle_key(ResourceTracker::get()->cabooseGetQueueDevice(queue)));
+        caboose::handle_key(ResourceTracker::get()->cabooseGetQueueDevice(queue)), commandBuffers);
     uint8_t* packet = stream->reserve(caboose::completion::kWatchPacketSize);
     caboose::completion::encodeWatch(packet, get_host_u64_VkQueue(queue), serial);
     stream->flush();
