+bool ResourceTracker::cabooseHasCommandBuffersGpuWritten(const std::vector<uint64_t>& commandBuffers) {
+    if (commandBuffers.empty()) return false;
+    std::lock_guard<std::recursive_mutex> lock(mLock);
+    for (uint64_t cb : commandBuffers) {
+        auto it = mCabooseCommandDirtyRanges.find(cb);
+        if (it != mCabooseCommandDirtyRanges.end() && !it->second.empty()) return true;
+    }
+    return false;
+}
