+void ResourceTracker::cabooseSubmitCommandBuffersGpuWritten(const std::vector<uint64_t>& commandBuffers, uint64_t serial) {
+    if (commandBuffers.empty()) return;
+    std::lock_guard<std::recursive_mutex> lock(mLock);
+    const bool feedOn = caboose::completion::feedActive.load(std::memory_order_acquire) && serial != 0;
+    for (uint64_t cb : commandBuffers) {
+        auto it = mCabooseCommandDirtyRanges.find(cb);
+        if (it == mCabooseCommandDirtyRanges.end()) continue;
+        for (const auto& r : it->second) {
+            auto memIt = info_VkDeviceMemory.find(r.memory);
+            if (memIt == info_VkDeviceMemory.end()) continue;
+            auto& memInfo = memIt->second;
+            if (!memInfo.socketShadow) continue;
+            if (feedOn) {
+                bool merged = false;
+                for (auto& pending : memInfo.socketPendingGpuWrites) {
+                    if (pending.serial == serial) {
+                        if (r.begin < pending.begin) pending.begin = r.begin;
+                        if (r.end > pending.end) pending.end = r.end;
+                        merged = true;
+                        break;
+                    }
+                }
+                if (!merged) {
+                    memInfo.socketPendingGpuWrites.push_back(
+                        VkDeviceMemory_Info::CaboosePendingGpuWrite{serial, r.begin, r.end});
+                }
+            } else {
+                if (!memInfo.socketGpuWritten || memInfo.socketGpuWrittenEnd <= memInfo.socketGpuWrittenBegin) {
+                    memInfo.socketGpuWrittenBegin = r.begin;
+                    memInfo.socketGpuWrittenEnd = r.end;
+                } else {
+                    if (r.begin < memInfo.socketGpuWrittenBegin) memInfo.socketGpuWrittenBegin = r.begin;
+                    if (r.end > memInfo.socketGpuWrittenEnd) memInfo.socketGpuWrittenEnd = r.end;
+                }
+                memInfo.socketGpuWritten = true;
+            }
+        }
+    }
 }
 
