+void ResourceTracker::cabooseCachePhysicalDeviceMemoryProperties2(
+    const VkPhysicalDeviceMemoryProperties2& props2) {
+    std::lock_guard<std::recursive_mutex> lock(mLock);
+    if (!mCachedPhysicalDeviceMemoryProps) {
+        mCachedPhysicalDeviceMemoryProps.emplace(props2.memoryProperties);
+    }
+    for (const auto* next = static_cast<const VkBaseInStructure*>(props2.pNext); next; next = next->pNext) {
+        if (next->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_BUDGET_PROPERTIES_EXT) {
+            VkPhysicalDeviceMemoryBudgetPropertiesEXT copy =
+                *reinterpret_cast<const VkPhysicalDeviceMemoryBudgetPropertiesEXT*>(next);
+            copy.pNext = nullptr;
+            mCachedMemoryBudgetProps = copy;
+        }
+    }
+}
+
+bool ResourceTracker::cabooseTryFillPhysicalDeviceMemoryProperties(
+    VkPhysicalDeviceMemoryProperties* out) {
+    if (!out) return false;
+    std::lock_guard<std::recursive_mutex> lock(mLock);
+    if (!mCachedPhysicalDeviceMemoryProps) return false;
+    *out = *mCachedPhysicalDeviceMemoryProps;
+    return true;
+}
+
+bool ResourceTracker::cabooseTryFillPhysicalDeviceMemoryProperties2(
+    VkPhysicalDeviceMemoryProperties2* out) {
+    if (!out) return false;
+    std::lock_guard<std::recursive_mutex> lock(mLock);
+    if (!mCachedPhysicalDeviceMemoryProps) return false;
+    for (auto* next = static_cast<VkBaseOutStructure*>(out->pNext); next; next = next->pNext) {
+        if (next->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_BUDGET_PROPERTIES_EXT) {
+            if (!mCachedMemoryBudgetProps) return false;
+        } else {
+            return false;
+        }
+    }
+    out->memoryProperties = *mCachedPhysicalDeviceMemoryProps;
+    for (auto* next = static_cast<VkBaseOutStructure*>(out->pNext); next; next = next->pNext) {
+        if (next->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_BUDGET_PROPERTIES_EXT) {
+            auto* dst = reinterpret_cast<VkPhysicalDeviceMemoryBudgetPropertiesEXT*>(next);
+            void* savedNext = dst->pNext;
+            *dst = *mCachedMemoryBudgetProps;
+            dst->pNext = savedNext;
+        }
+    }
+    return true;
+}
