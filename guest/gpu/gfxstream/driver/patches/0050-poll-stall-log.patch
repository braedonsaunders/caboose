From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Caboose <caboose@invalid>
Date: Sun, 1 Nov 2026 00:00:00 +0000
Subject: [PATCH 50/50] Name a fence, query, event or timeline polled without
 change for 10 seconds

Halo: Combat Evolved's level load spun for minutes on a status that never
changed, answered locally with no traffic and no log. vkGetFenceStatus, short
vkWaitForFences, no-wait vkGetQueryPoolResults, vkGetEventStatus and
vkGetSemaphoreCounterValue now report each poll to
caboose::memory::pollStall() (../bounded-memory/poll_stall.h): an object
polled without change for 10 seconds prints CABOOSE_GPU_POLL_STALLED with the
call, the object, the time and polls, and what the completion feed's tracker
knows of it, and again every minute while it lasts.

diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/func_table.cpp b/src/gfxstream/guest/vulkan_enc/autogenerated/func_table.cpp
index 8e07bf7..6cbd8c4 100644
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/func_table.cpp
+++ b/src/gfxstream/guest/vulkan_enc/autogenerated/func_table.cpp
@@ -36,6 +36,9 @@
 #include "gfxstream_vk_private.h"
 #include "goldfish_vk_private_defs.h"
 #include "caboose-shader-cache/shader_cache.h"
+#include "caboose-bounded-memory/completion_feed.h"
+#include "caboose-bounded-memory/handles.h"
+#include "caboose-bounded-memory/poll_stall.h"
 #include "util/mesa-blake3.h"
 
 // 1 when the phone keeps shader modules (hello feature 0x2000); the descriptor of the
@@ -460,6 +463,10 @@ VkResult gfxstream_vk_GetFenceStatus(VkDevice device, VkFence fence) {
         auto resources = gfxstream::vk::ResourceTracker::get();
         vkGetFenceStatus_VkResult_return = resources->on_vkGetFenceStatus(
             vkEnc, VK_SUCCESS, gfxstream_device->internal_object, gfxstream_fence->internal_object);
+        // A fence polled for 10 seconds without signaling is named (poll_stall.h).
+        const uint64_t key = caboose::handle_key(gfxstream_fence->internal_object);
+        caboose::memory::pollStall().poll("vkGetFenceStatus", key, vkGetFenceStatus_VkResult_return != VK_NOT_READY,
+                                          [key] { return caboose::completion::tracker().describeFence(key); });
     }
     return vkGetFenceStatus_VkResult_return;
 }
@@ -478,6 +485,12 @@ VkResult gfxstream_vk_WaitForFences(VkDevice device, uint32_t fenceCount, const
         vkWaitForFences_VkResult_return =
             resources->on_vkWaitForFences(vkEnc, VK_SUCCESS, gfxstream_device->internal_object,
                                           fenceCount, internal_pFences.data(), waitAll, timeout);
+        // Short waits in a loop are polls too.
+        if (fenceCount && timeout < 1000000000ull) {
+            const uint64_t key = caboose::handle_key(internal_pFences[0]);
+            caboose::memory::pollStall().poll("vkWaitForFences", key, vkWaitForFences_VkResult_return != VK_TIMEOUT,
+                                              [key] { return caboose::completion::tracker().describeFence(key); });
+        }
     }
     return vkWaitForFences_VkResult_return;
 }
@@ -559,6 +572,14 @@ VkResult gfxstream_vk_GetQueryPoolResults(VkDevice device, VkQueryPool queryPool
         vkGetQueryPoolResults_VkResult_return = vkEnc->vkGetQueryPoolResults(
             gfxstream_device->internal_object, queryPool, firstQuery, queryCount, dataSize, pData,
             stride, flags, true /* do lock */);
+        caboose::memory::pollStall().poll(
+            "vkGetQueryPoolResults", caboose::handle_key(queryPool) ^ (uint64_t(firstQuery) << 40),
+            vkGetQueryPoolResults_VkResult_return != VK_NOT_READY, [&] {
+                char text[96];
+                std::snprintf(text, sizeof(text), "pool=0x%llx first=%u count=%u flags=0x%x",
+                              (unsigned long long)caboose::handle_key(queryPool), firstQuery, queryCount, unsigned(flags));
+                return std::string(text);
+            });
     }
     return vkGetQueryPoolResults_VkResult_return;
 }
@@ -923,6 +944,9 @@ VkResult gfxstream_vk_GetEventStatus(VkDevice device, VkEvent event) {
         auto vkEnc = gfxstream::vk::ResourceTracker::getThreadLocalEncoder();
         vkGetEventStatus_VkResult_return =
             vkEnc->vkGetEventStatus(gfxstream_device->internal_object, event, true /* do lock */);
+        caboose::memory::pollStall().poll("vkGetEventStatus", caboose::handle_key(event),
+                                          vkGetEventStatus_VkResult_return != VK_EVENT_RESET,
+                                          [] { return std::string("event=reset"); });
     }
     return vkGetEventStatus_VkResult_return;
 }
@@ -2118,6 +2142,11 @@ VkResult gfxstream_vk_GetSemaphoreCounterValue(VkDevice device, VkSemaphore sema
         vkGetSemaphoreCounterValue_VkResult_return = vkEnc->vkGetSemaphoreCounterValue(
             gfxstream_device->internal_object, gfxstream_semaphore->internal_object, pValue,
             true /* do lock */);
+        if (vkGetSemaphoreCounterValue_VkResult_return == VK_SUCCESS && pValue) {
+            const uint64_t key = caboose::handle_key(gfxstream_semaphore->internal_object);
+            caboose::memory::pollStall().value("vkGetSemaphoreCounterValue", key, *pValue,
+                                               [key] { return caboose::completion::tracker().describeSemaphore(key); });
+        }
     }
     return vkGetSemaphoreCounterValue_VkResult_return;
 }
