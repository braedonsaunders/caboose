From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Caboose <caboose@invalid>
Date: Sat, 31 Oct 2026 00:00:00 +0000
Subject: [PATCH 26/26] Count local waits in the read profile

CABOOSE_READ_PROFILE counted only blocking reads of device replies. Fence and
timeline waits the completion feed answers locally now count as waitN, and the
presentation client's waits for the phone as wait_acquire, wait_present_room,
wait_release and wait_sync_acquire (caboose-bounded-memory/completion_feed.h
WaitTimer), so a stall anywhere in the driver shows in the profile.
---
 .../guest/vulkan_enc/ResourceTracker.cpp      |  1 +
 .../vulkan_enc/autogenerated/VkEncoder.cpp    | 42 +++++++++++++++----
 2 files changed, 35 insertions(+), 8 deletions(-)

diff --git a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
index 14868b1..805447d 100644
--- a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
+++ b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
@@ -5737,6 +5737,7 @@ VkResult ResourceTracker::on_vkWaitForFences(void* context, VkResult, VkDevice d
         constexpr uint64_t kDay = 86400ull * 1000000000ull;
         uint64_t remaining = timeout;
         caboose::completion::Tracker::Answer answer;
+        caboose::completion::WaitTimer waited{20039};  // OP_vkWaitForFences
         do {
             const uint64_t chunk = std::min(remaining, kDay);
             remaining -= chunk;
diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
index 9785af4..9c4f029 100644
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
+++ b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
@@ -45,10 +45,22 @@
 namespace caboose_read_profile {
 // CABOOSE_READ_PROFILE: every 2 s, the eight largest totals of time this process spent
 // blocked reading device replies. `opN` is a call waiting for its own reply; `drainN` is
-// call N waiting first for earlier commands' deferred replies.
+// call N waiting first for earlier commands' deferred replies. `waitN` is call N waiting
+// locally (a fence or semaphore answered by the completion feed); `wait_acquire`,
+// `wait_present_room`, `wait_release` and `wait_sync_acquire` are the presentation
+// client waiting for the phone.
 inline thread_local uint32_t currentOpcode = 0;
-enum Kind : uint32_t { kOwnReply = 0, kDrain = 1 };
-struct Totals { uint64_t us[2][1024] = {}; uint64_t n[2][1024] = {}; };
+enum Kind : uint32_t { kOwnReply = 0, kDrain = 1, kWait = 2 };
+struct Totals { uint64_t us[3][1024] = {}; uint64_t n[3][1024] = {}; };
+inline const char* waitName(uint32_t index) {
+    switch (index) {
+        case 1001: return "wait_acquire";
+        case 1002: return "wait_present_room";
+        case 1003: return "wait_release";
+        case 1004: return "wait_sync_acquire";
+        default: return nullptr;
+    }
+}
 inline Totals totals;
 inline std::mutex mu;
 inline std::chrono::steady_clock::time_point last = std::chrono::steady_clock::now();
@@ -60,7 +72,7 @@ inline void note(uint64_t us, Kind kind = kOwnReply, uint32_t opcode = currentOp
     if (now - last < std::chrono::seconds(2)) return;
     last = now;
     uint32_t order[8] = {}; uint64_t best[8] = {};
-    for (uint32_t i = 0; i < 2 * 1024; ++i) {
+    for (uint32_t i = 0; i < 3 * 1024; ++i) {
         uint64_t value = totals.us[i / 1024][i % 1024];
         for (int k = 0; k < 8; ++k)
             if (value > best[k]) {
@@ -69,10 +81,15 @@ inline void note(uint64_t us, Kind kind = kOwnReply, uint32_t opcode = currentOp
             }
     }
     std::fprintf(stderr, "CABOOSE_READ_PROFILE");
-    for (int k = 0; k < 8 && best[k]; ++k)
-        std::fprintf(stderr, " %s%u=%llums/%llu", order[k] / 1024 ? "drain" : "op", order[k] % 1024 + 20000,
-                     (unsigned long long)(best[k] / 1000),
-                     (unsigned long long)totals.n[order[k] / 1024][order[k] % 1024]);
+    for (int k = 0; k < 8 && best[k]; ++k) {
+        const uint32_t kind = order[k] / 1024, index = order[k] % 1024;
+        const unsigned long long ms = best[k] / 1000, n = totals.n[kind][index];
+        if (const char* name = kind == kWait ? waitName(index) : nullptr)
+            std::fprintf(stderr, " %s=%llums/%llu", name, ms, n);
+        else
+            std::fprintf(stderr, " %s%u=%llums/%llu", kind == kDrain ? "drain" : kind == kWait ? "wait" : "op",
+                         index + 20000, ms, n);
+    }
     std::fprintf(stderr, "\n");
     totals = Totals{};
 }
@@ -84,6 +101,14 @@ inline bool enabled() {
     }();
     return on;
 }
+}  // namespace caboose_read_profile
+// Local waits from other files: `what` is the Vulkan opcode, or 21001-21004 for the
+// presentation client's waits (see waitName).
+extern "C" void caboose_read_profile_wait(uint64_t us, uint32_t what);
+extern "C" void caboose_read_profile_wait(uint64_t us, uint32_t what) {
+    if (caboose_read_profile::enabled()) caboose_read_profile::note(us, caboose_read_profile::kWait, what);
+}
+namespace caboose_read_profile {
 template <class S, class P> inline void read(S* stream, P* ptr, size_t size) {
     if (!enabled()) {
         stream->read(ptr, size);
@@ -15318,6 +15343,7 @@ VkResult VkEncoder::vkWaitSemaphores(VkDevice device, const VkSemaphoreWaitInfo*
         constexpr uint64_t kDay = 86400ull * 1000000000ull;
         uint64_t remaining = timeout;
         caboose::completion::Tracker::Answer answer;
+        caboose::completion::WaitTimer waited{OP_vkWaitSemaphores};
         do {
             const uint64_t chunk = std::min(remaining, kDay);
             remaining -= chunk;
-- 
