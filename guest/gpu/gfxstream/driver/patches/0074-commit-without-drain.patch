From: Caboose <caboose@local>
Subject: [PATCH 74/75] Send the descriptor set commit without waiting for earlier replies

vkQueueCommitDescriptorSetUpdatesGOOGLE has no reply, yet it drained every deferred reply
first, so each submit waited for the phone to finish decoding everything before it: 1.8 s
of every 2 s of DXVK's submit thread. It now goes out at once; the submit after it bounds
what is in flight. Pools of up to 4096 sets (32 KiB of ids) now ask for their ids without
waiting; DXVK's 1024-set pools each waited out the phone's backlog.
---
diff --git a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
index db01003..f645a38 100644
--- a/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
+++ b/src/gfxstream/guest/vulkan_enc/ResourceTracker.cpp
@@ -897,8 +897,8 @@ static void collectAllPendingDescriptorSetsBottomUp(const std::vector<VkCommandB
     }
 }
 
-// Caboose: pools of at most this many sets ask for their set ids without waiting (4 KiB of ids).
-static constexpr uint32_t kCabooseDeferredPoolIds = 512;
+// Caboose: pools of at most this many sets ask for their set ids without waiting (32 KiB of ids).
+static constexpr uint32_t kCabooseDeferredPoolIds = 4096;
 
 static void commitDescriptorSetUpdates(void* context, VkQueue queue,
                                        const std::unordered_set<VkDescriptorSet>& sets) {
diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
index a71021e..5bb921d 100644
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
+++ b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
@@ -31651,7 +31651,9 @@ void VkEncoder::vkQueueCommitDescriptorSetUpdatesGOOGLE(
         sFeatureBits & VULKAN_STREAM_FEATURE_QUEUE_SUBMIT_WITH_COMMANDS_BIT;
     if (!queueSubmitWithCommandsEnabled && doLock) this->lock();
     auto stream = mImpl->stream();
-    caboose::memory::deferredReplies.drain(this, stream);
+    // Caboose: no reply of its own, so no wait for earlier replies: the submit after it
+    // bounds what is in flight.
+    (void)0;
     auto pool = mImpl->pool();
     VkQueue local_queue;
     uint32_t local_descriptorPoolCount;
