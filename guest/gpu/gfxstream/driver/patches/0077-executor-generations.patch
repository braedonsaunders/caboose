@@ -3215,6 +3216,7 @@ void ResourceTracker::on_vkDestroyDevice_pre(void* context, VkDevice device,
 
     auto it = info_VkDevice.find(device);
     if (it == info_VkDevice.end()) return;
+    mCabooseDeviceQueues.erase(device);
     caboose::memory::asyncAllocationBudget.deviceDestroyed(caboose::handle_key(device));
     caboose::memory::requirementsCache.deviceDestroyed(caboose::handle_key(device));
 
@@ -10066,7 +10068,27 @@ static ResourceTracker* sTracker = nullptr;
 ResourceTracker::ResourceTracker() {
     mCreateMapping = new CreateMapping();
     mDestroyMapping = new DestroyMapping();
-    // nothing to do
+    static const bool hooked = caboose::completion::onNewGeneration([] { ResourceTracker::get()->cabooseNewGeneration(); });
+    (void)hooked;
+}
+
+void ResourceTracker::cabooseNewGeneration() {
+    std::lock_guard<std::recursive_mutex> lock(mLock);
+    // The previous executor's memory types, heaps and budget, and what its device features
+    // made the driver emulate, are not the next executor's.
+    mCachedPhysicalDeviceMemoryProps.reset();
+    mCachedMemoryBudgetProps.reset();
+    for (auto* known : {&mCabooseHostLogicOp, &mCabooseHostGeometryShader, &mCabooseHostCullDistance,
+                        &mCabooseHostNullDescriptor, &mCabooseHostRobustBufferAccess2})
+        known->store(-1);
+    // Queues of the previous executor's devices, whose calls report loss from now on.
+    mCabooseDeviceQueues.clear();
+    // Completion watches owed to the previous executor's queues are never sent to the next.
+    (void)caboose::memory::deferredDestroys.takeUnwatched();
+#if defined(LINUX_GUEST_BUILD)
+    // Host allocations shared through dma-bufs went with the previous executor.
+    caboose::dmabuf::sharedAllocations().clear();
+#endif
 }
 
 ResourceTracker::~ResourceTracker() {
