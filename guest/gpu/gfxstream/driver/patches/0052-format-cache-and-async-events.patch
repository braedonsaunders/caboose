From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Caboose <caboose@invalid>
Date: Sun, 1 Nov 2026 00:00:00 +0000
Subject: [PATCH 52/52] Cache format queries with VkFormatProperties3, and send
 host event sets and resets without waiting

During Halo's loads the loader thread spent about 38% of its time in
vkGetPhysicalDeviceFormatProperties2: DXVK asks it, with VkFormatProperties3
chained, for every view it creates, and the cache skipped any query with an
extension chain, so each one waited for every owed reply and then a round
trip. A chain of exactly VkFormatProperties3 is now cached with the answer.
vkSetEvent and vkResetEvent are sent without waiting, their results checked
with the deferred replies (a failure is device loss, as for a submit); the
event's state is known locally since patch 0051.

diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
index 59eec87..c3c11db 100644
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
+++ b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
@@ -7979,7 +7979,12 @@ VkResult VkEncoder::vkSetEvent(VkDevice device, VkEvent event, uint32_t doLock)
     if (!queueSubmitWithCommandsEnabled && doLock) this->lock();
     auto stream = mImpl->stream();
     caboose_read_profile::currentOpcode = OP_vkSetEvent;
-    caboose::memory::deferredReplies.drain(this, stream);
+    // A host set or reset is sent without waiting: its result is checked with the deferred
+    // replies, a failure being device loss, as for a submit. The event's state is known
+    // locally (completion_feed.h, events), and later commands on this stream follow it.
+    const bool cabooseDeferred = !queueSubmitWithCommandsEnabled && caboose_guest_handles::enabled() &&
+                                 caboose::memory::deferredReplies.singleEncoder(this);
+    if (!cabooseDeferred) caboose::memory::deferredReplies.drain(this, stream);
     auto pool = mImpl->pool();
     VkDevice local_device;
     VkEvent local_event;
@@ -8018,7 +8023,13 @@ VkResult VkEncoder::vkSetEvent(VkDevice device, VkEvent event, uint32_t doLock)
     memcpy(*streamPtrPtr, (uint64_t*)&cgen_var_1, 1 * 8);
     *streamPtrPtr += 1 * 8;
     VkResult vkSetEvent_VkResult_return = (VkResult)0;
-    caboose_read_profile::read(stream, &vkSetEvent_VkResult_return, sizeof(VkResult));
+    if (cabooseDeferred) {
+        stream->flush();
+        caboose::memory::deferredReplies.reserve(this, stream, packetSize_vkSetEvent);
+        caboose::memory::deferredReplies.addCheckedResult(this, packetSize_vkSetEvent);
+    } else {
+        caboose_read_profile::read(stream, &vkSetEvent_VkResult_return, sizeof(VkResult));
+    }
     ++encodeCount;
     if (0 == encodeCount % POOL_CLEAR_INTERVAL) {
         pool->freeAll();
@@ -8037,7 +8048,12 @@ VkResult VkEncoder::vkResetEvent(VkDevice device, VkEvent event, uint32_t doLock
     if (!queueSubmitWithCommandsEnabled && doLock) this->lock();
     auto stream = mImpl->stream();
     caboose_read_profile::currentOpcode = OP_vkResetEvent;
-    caboose::memory::deferredReplies.drain(this, stream);
+    // A host set or reset is sent without waiting: its result is checked with the deferred
+    // replies, a failure being device loss, as for a submit. The event's state is known
+    // locally (completion_feed.h, events), and later commands on this stream follow it.
+    const bool cabooseDeferred = !queueSubmitWithCommandsEnabled && caboose_guest_handles::enabled() &&
+                                 caboose::memory::deferredReplies.singleEncoder(this);
+    if (!cabooseDeferred) caboose::memory::deferredReplies.drain(this, stream);
     auto pool = mImpl->pool();
     VkDevice local_device;
     VkEvent local_event;
@@ -8076,7 +8092,13 @@ VkResult VkEncoder::vkResetEvent(VkDevice device, VkEvent event, uint32_t doLock
     memcpy(*streamPtrPtr, (uint64_t*)&cgen_var_1, 1 * 8);
     *streamPtrPtr += 1 * 8;
     VkResult vkResetEvent_VkResult_return = (VkResult)0;
-    caboose_read_profile::read(stream, &vkResetEvent_VkResult_return, sizeof(VkResult));
+    if (cabooseDeferred) {
+        stream->flush();
+        caboose::memory::deferredReplies.reserve(this, stream, packetSize_vkResetEvent);
+        caboose::memory::deferredReplies.addCheckedResult(this, packetSize_vkResetEvent);
+    } else {
+        caboose_read_profile::read(stream, &vkResetEvent_VkResult_return, sizeof(VkResult));
+    }
     ++encodeCount;
     if (0 == encodeCount % POOL_CLEAR_INTERVAL) {
         pool->freeAll();
@@ -14260,12 +14282,34 @@ void VkEncoder::vkGetPhysicalDeviceFormatProperties2(VkPhysicalDevice physicalDe
     (void)doLock;
     // The executor is gone: report device loss, and never read garbage replies into outputs.
     if (caboose::completion::lostCall()) return;
-    // Format properties never change for a physical device: asked once (without extensions).
-    const bool cabooseCacheable = pFormatProperties && !pFormatProperties->pNext;
+    // Format properties never change for a physical device: asked once, alone or with the
+    // VkFormatProperties3 that DXVK chains to every query (one per view it creates).
+    VkFormatProperties3* cabooseThree = nullptr;
+    if (pFormatProperties && pFormatProperties->pNext) {
+        auto* next = static_cast<VkBaseOutStructure*>(pFormatProperties->pNext);
+        if (next->sType == VK_STRUCTURE_TYPE_FORMAT_PROPERTIES_3 && !next->pNext)
+            cabooseThree = reinterpret_cast<VkFormatProperties3*>(next);
+    }
+    const bool cabooseCacheable = pFormatProperties && (!pFormatProperties->pNext || cabooseThree);
+    struct CabooseFormatAnswer {
+        VkFormatProperties properties;
+        VkFormatFeatureFlags2 linear, optimal, buffer;
+    };
     const std::string cabooseKey = caboose::memory::StaticQueryCache::key(
-        uint32_t(OP_vkGetPhysicalDeviceFormatProperties2), caboose::handle_key(physicalDevice), format);
-    if (cabooseCacheable && caboose::memory::staticQueryCache.lookup(cabooseKey, &pFormatProperties->formatProperties))
-        return;
+        uint32_t(OP_vkGetPhysicalDeviceFormatProperties2), caboose::handle_key(physicalDevice), format,
+        uint32_t(cabooseThree ? 3 : 2));
+    if (cabooseCacheable) {
+        CabooseFormatAnswer cached;
+        if (caboose::memory::staticQueryCache.lookup(cabooseKey, &cached)) {
+            pFormatProperties->formatProperties = cached.properties;
+            if (cabooseThree) {
+                cabooseThree->linearTilingFeatures = cached.linear;
+                cabooseThree->optimalTilingFeatures = cached.optimal;
+                cabooseThree->bufferFeatures = cached.buffer;
+            }
+            return;
+        }
+    }
     bool queueSubmitWithCommandsEnabled =
         sFeatureBits & VULKAN_STREAM_FEATURE_QUEUE_SUBMIT_WITH_COMMANDS_BIT;
     if (!queueSubmitWithCommandsEnabled && doLock) this->lock();
@@ -14321,7 +14365,10 @@ void VkEncoder::vkGetPhysicalDeviceFormatProperties2(VkPhysicalDevice physicalDe
         pool->freeAll();
         stream->clearPool();
     }
-    if (cabooseCacheable) caboose::memory::staticQueryCache.store(cabooseKey, pFormatProperties->formatProperties);
+    if (cabooseCacheable)
+        caboose::memory::staticQueryCache.store(cabooseKey, CabooseFormatAnswer{
+            pFormatProperties->formatProperties, cabooseThree ? cabooseThree->linearTilingFeatures : 0,
+            cabooseThree ? cabooseThree->optimalTilingFeatures : 0, cabooseThree ? cabooseThree->bufferFeatures : 0});
     if (!queueSubmitWithCommandsEnabled && doLock) this->unlock();
 }
 
