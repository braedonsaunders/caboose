From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Caboose <caboose@invalid>
Date: Sat, 31 Oct 2026 00:00:00 +0000
Subject: [PATCH 39/39] End a process whose encoder lock was abandoned by a
 fault

The encoder's spinlock is not recursive. When a call faults inside a locked
section and its caller carries on (Wine abandons a faulting unix call), the
lock stays held and the thread's next call spins forever, with every other
thread behind it. The lock now records its owner thread; a thread that takes
the lock it already holds prints CABOOSE_GPU_ENCODER_REENTERED and aborts, so
the application ends with a report instead of hanging.
---
 src/gfxstream/guest/vulkan_enc/VkEncoder.cpp.inl   | 22 ++++++++++++++++++----
 .../guest/vulkan_enc/autogenerated/VkEncoder.cpp   |  3 +++
 2 files changed, 21 insertions(+), 4 deletions(-)

diff --git a/src/gfxstream/guest/vulkan_enc/VkEncoder.cpp.inl b/src/gfxstream/guest/vulkan_enc/VkEncoder.cpp.inl
index 3499964..566b8c3 100644
--- a/src/gfxstream/guest/vulkan_enc/VkEncoder.cpp.inl
+++ b/src/gfxstream/guest/vulkan_enc/VkEncoder.cpp.inl
@@ -44,13 +44,26 @@ class VkEncoder::Impl {
         unlock();
     }
 
-    // can be recursive
+    // Not recursive. A thread that takes the lock it already holds is a thread whose
+    // locked section was abandoned by a fault (Wine abandons a faulting unix call): it
+    // would spin forever, and every other thread behind it. Report it and end instead.
     void lock() {
-        while (mLock.test_and_set(std::memory_order_acquire))
-            ;
+        const long self = static_cast<long>(syscall(SYS_gettid));
+        while (mLock.test_and_set(std::memory_order_acquire)) {
+            if (mOwner.load(std::memory_order_relaxed) == self) {
+                fprintf(stderr, "CABOOSE_GPU_ENCODER_REENTERED thread %ld: an earlier call on this "
+                                "thread faulted while encoding; ending instead of waiting forever\n",
+                        self);
+                abort();
+            }
+        }
+        mOwner.store(self, std::memory_order_relaxed);
     }
 
-    void unlock() { mLock.clear(std::memory_order_release); }
+    void unlock() {
+        mOwner.store(0, std::memory_order_relaxed);
+        mLock.clear(std::memory_order_release);
+    }
 
    private:
     VulkanCountingStream m_countingStream;
@@ -60,6 +73,7 @@ class VkEncoder::Impl {
     Validation m_validation;
     bool m_logEncodes;
     std::atomic_flag mLock = ATOMIC_FLAG_INIT;
+    std::atomic<long> mOwner{0};
 };
 
 VkEncoder::~VkEncoder() {}
diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
index 8791f7c..471187b 100644
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
+++ b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
@@ -41,6 +41,9 @@
 #include <sys/ioctl.h>
 #include <chrono>
 #include <cstdio>
+#include <cstdlib>
+#include <sys/syscall.h>
+#include <unistd.h>
 #include <mutex>
 namespace caboose_read_profile {
 // CABOOSE_READ_PROFILE: every 2 s, the eight largest totals of time this process spent
