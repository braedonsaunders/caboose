+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <mutex>
+namespace caboose_read_profile {
+inline thread_local uint32_t currentOpcode = 0;
+struct Totals { uint64_t us[1024] = {}; uint64_t n[1024] = {}; };
+inline Totals totals;
+inline std::mutex mu;
+inline std::chrono::steady_clock::time_point last = std::chrono::steady_clock::now();
+inline void note(uint64_t us) {
+    uint32_t idx = currentOpcode >= 20000 && currentOpcode < 21024 ? currentOpcode - 20000 : 1023;
+    std::lock_guard<std::mutex> lock(mu);
+    totals.us[idx] += us; totals.n[idx] += 1;
+    auto now = std::chrono::steady_clock::now();
+    if (now - last < std::chrono::seconds(2)) return;
+    last = now;
+    uint32_t order[8] = {}; uint64_t best[8] = {};
+    for (uint32_t i = 0; i < 1024; ++i)
+        for (int k = 0; k < 8; ++k)
+            if (totals.us[i] > best[k]) {
+                for (int m = 7; m > k; --m) { best[m] = best[m - 1]; order[m] = order[m - 1]; }
+                best[k] = totals.us[i]; order[k] = i; break;
+            }
+    std::fprintf(stderr, "CABOOSE_READ_PROFILE");
+    for (int k = 0; k < 8 && best[k]; ++k)
+        std::fprintf(stderr, " op%u=%llums/%llu", order[k] + 20000, (unsigned long long)(best[k] / 1000),
+                     (unsigned long long)totals.n[order[k]]);
+    std::fprintf(stderr, "\n");
+    totals = Totals{};
+}
+template <class S, class P> inline void read(S* stream, P* ptr, size_t size) {
+    auto t0 = std::chrono::steady_clock::now();
+    stream->read(ptr, size);
+    note(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0).count());
+}
+}  // namespace caboose_read_profile
