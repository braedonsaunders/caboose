+#include <array>
+#include <map>
+#include <mutex>
+#include <unordered_map>
+#include <unordered_set>
+// Chromium's ANGLE creates and destroys the same image views every frame, and each
+// creation waits a full round trip for the host's handle. A destroyed view of an image
+// this encoder created is parked instead, and an identical request reuses it. Parked
+// views are destroyed for real before their image or device is.
+namespace caboose_view_cache {
+using Key = std::array<uint64_t, 15>;
+struct State {
+    std::mutex mutex;
+    std::unordered_set<uint64_t> images;                      // live images made here
+    std::unordered_map<uint64_t, Key> live;                   // cacheable live view -> key
+    std::map<Key, std::vector<uint64_t>> parked;              // key -> parked views
+    size_t parkedCount = 0;
+};
+inline State state;
+inline thread_local bool destroying = false;
+constexpr size_t kPerKey = 8, kTotal = 4096;
+inline bool keyOf(VkDevice device, const VkImageViewCreateInfo* info, Key* key) {
+    if (!info) return false;
+    uint64_t usage = 0;
+    for (auto* next = static_cast<const VkBaseInStructure*>(info->pNext); next; next = next->pNext) {
+        if (next->sType != VK_STRUCTURE_TYPE_IMAGE_VIEW_USAGE_CREATE_INFO) return false;
+        usage = reinterpret_cast<const VkImageViewUsageCreateInfo*>(next)->usage;
+    }
+    const auto& r = info->subresourceRange;
+    *key = {uint64_t(uintptr_t(device)), uint64_t(uintptr_t(info->image)), info->flags, uint64_t(info->viewType),
+            uint64_t(info->format), uint64_t(info->components.r), uint64_t(info->components.g),
+            uint64_t(info->components.b), uint64_t(info->components.a), r.aspectMask, r.baseMipLevel,
+            r.levelCount, r.baseArrayLayer, r.layerCount, usage};
+    return true;
+}
+inline void imageCreated(VkImage image) {
+    std::lock_guard<std::mutex> lock(state.mutex);
+    state.images.insert(uint64_t(uintptr_t(image)));
+}
+inline bool acquire(VkDevice device, const VkImageViewCreateInfo* info, VkImageView* view) {
+    Key key;
+    if (!view || !keyOf(device, info, &key)) return false;
+    std::lock_guard<std::mutex> lock(state.mutex);
+    auto it = state.parked.find(key);
+    if (it == state.parked.end() || it->second.empty()) return false;
+    uint64_t handle = it->second.back();
+    it->second.pop_back();
+    if (it->second.empty()) state.parked.erase(it);
+    --state.parkedCount;
+    state.live[handle] = key;
+    *view = reinterpret_cast<VkImageView>(uintptr_t(handle));
+    return true;
+}
+inline void created(VkDevice device, const VkImageViewCreateInfo* info, VkImageView view) {
+    Key key;
+    if (!keyOf(device, info, &key)) return;
+    std::lock_guard<std::mutex> lock(state.mutex);
+    if (state.images.count(key[1])) state.live[uint64_t(uintptr_t(view))] = key;
+}
+inline bool park(VkImageView view) {
+    if (destroying || !view) return false;
+    std::lock_guard<std::mutex> lock(state.mutex);
+    uint64_t handle = uint64_t(uintptr_t(view));
+    auto it = state.live.find(handle);
+    if (it == state.live.end()) return false;
+    Key key = it->second;
+    state.live.erase(it);
+    auto& slot = state.parked[key];
+    if (slot.size() >= kPerKey || state.parkedCount >= kTotal || !state.images.count(key[1])) {
+        if (slot.empty()) state.parked.erase(key);
+        return false;
+    }
+    slot.push_back(handle);
+    ++state.parkedCount;
+    return true;
+}
+// Parked views of `image` (or of `device` when image is null), removed from the cache.
+inline std::vector<uint64_t> take(VkDevice device, VkImage image, bool forgetImage) {
+    std::vector<uint64_t> out;
+    std::lock_guard<std::mutex> lock(state.mutex);
+    for (auto it = state.parked.begin(); it != state.parked.end();) {
+        if (it->first[0] == uint64_t(uintptr_t(device)) && (!image || it->first[1] == uint64_t(uintptr_t(image)))) {
+            out.insert(out.end(), it->second.begin(), it->second.end());
+            state.parkedCount -= it->second.size();
+            it = state.parked.erase(it);
+        } else {
+            ++it;
+        }
+    }
+    if (forgetImage && image) {
+        state.images.erase(uint64_t(uintptr_t(image)));
+        for (auto it = state.live.begin(); it != state.live.end();)
+            it = it->second[1] == uint64_t(uintptr_t(image)) ? state.live.erase(it) : std::next(it);
+    }
+    return out;
+}
+}  // namespace caboose_view_cache
