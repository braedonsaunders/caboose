From: Caboose <caboose@local>
Subject: [PATCH 65/65] Share external-semaphore capability answers within an executor session

A physical device's external-semaphore answers, for an empty input chain or exactly a
semaphore type, are kept in the same per-session capability cache as format answers. Zink
asks about ten of them while it starts, each one round trip to the phone. The cache keeps
the executor's answer; the tracker's adjustment for sync file and timeline semaphores is
applied to cached and asked answers alike.
---
diff --git a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
--- a/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
+++ b/src/gfxstream/guest/vulkan_enc/autogenerated/VkEncoder.cpp
@@ -15615,6 +15615,34 @@ void VkEncoder::vkGetPhysicalDeviceExternalSemaphoreProperties(
     (void)doLock;
     // The executor is gone: report device loss, and never read garbage replies into outputs.
     if (caboose::completion::lostCall()) return;
+    // A device's external-semaphore answers never change: asked once per executor session
+    // (static_query_cache.h), for an empty chain or exactly a semaphore type. The answer
+    // kept is the executor's; the tracker's adjustment below applies to every caller.
+    const auto* cabooseType = pExternalSemaphoreInfo
+        ? reinterpret_cast<const VkSemaphoreTypeCreateInfo*>(pExternalSemaphoreInfo->pNext) : nullptr;
+    const bool cabooseCacheable = pExternalSemaphoreInfo && pExternalSemaphoreProperties &&
+        !pExternalSemaphoreProperties->pNext &&
+        (!cabooseType || (cabooseType->sType == VK_STRUCTURE_TYPE_SEMAPHORE_TYPE_CREATE_INFO && !cabooseType->pNext));
+    struct CabooseSemaphoreAnswer {
+        VkExternalSemaphoreHandleTypeFlags exportFrom, compatible;
+        VkExternalSemaphoreFeatureFlags features;
+    };
+    std::string cabooseKey;
+    if (cabooseCacheable) {
+        cabooseKey = caboose::memory::StaticQueryCache::key(
+            uint32_t(OP_vkGetPhysicalDeviceExternalSemaphoreProperties), caboose::handle_key(physicalDevice),
+            uint32_t(pExternalSemaphoreInfo->handleType), uint32_t(cabooseType ? 1 : 0),
+            uint32_t(cabooseType ? cabooseType->semaphoreType : 0), uint64_t(cabooseType ? cabooseType->initialValue : 0));
+        CabooseSemaphoreAnswer cached;
+        if (caboose::memory::staticQueryCache.lookup(cabooseKey, &cached)) {
+            pExternalSemaphoreProperties->exportFromImportedHandleTypes = cached.exportFrom;
+            pExternalSemaphoreProperties->compatibleHandleTypes = cached.compatible;
+            pExternalSemaphoreProperties->externalSemaphoreFeatures = cached.features;
+            sResourceTracker->on_vkGetPhysicalDeviceExternalSemaphoreProperties(
+                this, physicalDevice, pExternalSemaphoreInfo, pExternalSemaphoreProperties);
+            return;
+        }
+    }
     bool queueSubmitWithCommandsEnabled =
         sFeatureBits & VULKAN_STREAM_FEATURE_QUEUE_SUBMIT_WITH_COMMANDS_BIT;
     if (!queueSubmitWithCommandsEnabled && doLock) this->lock();
@@ -15683,6 +15711,11 @@ void VkEncoder::vkGetPhysicalDeviceExternalSemaphoreProperties(
         transform_fromhost_VkExternalSemaphoreProperties(
             sResourceTracker, (VkExternalSemaphoreProperties*)(pExternalSemaphoreProperties));
     }
+    if (cabooseCacheable && !caboose::completion::executorLost.load(std::memory_order_acquire))
+        caboose::memory::staticQueryCache.store(cabooseKey, CabooseSemaphoreAnswer{
+            pExternalSemaphoreProperties->exportFromImportedHandleTypes,
+            pExternalSemaphoreProperties->compatibleHandleTypes,
+            pExternalSemaphoreProperties->externalSemaphoreFeatures});
     sResourceTracker->on_vkGetPhysicalDeviceExternalSemaphoreProperties(
         this, physicalDevice, pExternalSemaphoreInfo, pExternalSemaphoreProperties);
     ++encodeCount;
