#!/usr/bin/env python3
"""Private live GPU broker, supervised by the owner compositor.

No public ICD is enabled here. The inherited AF_UNIX control socket receives
TCP connections from the compositor; local Vulkan streams use the supplied
owner-only socket path. Receipts must come from the real executor.
"""
import argparse
import array
import asyncio
import contextlib
import os
from pathlib import Path
import socket
import stat
import sys

from executor_lease import ExecutorLease, MAX_QUEUED_BYTES, MAX_QUEUED_MESSAGES
from gpu_admission import MAX_REQUEST, MAX_TOKEN, admit
from gpu_websocket import Decoder as WebSocketDecoder, server_frame
from ipc_handoff import receive_record
import control_protocol
from process_binding import PeerIdentity, ProcessBindings, pidfd_alive, pidfd_pid, process_start_ticks
from live_protocol import Decoder as EnvelopeDecoder, Envelope, Kind, encode

HELLO = (b'CBGLREF1' + bytes((3, 0, 0, 0, 48, 0, 0, 0)) + bytes.fromhex(
    '20d3bb2e30337cabf0febb006ed102ab25ccf6d9ddbfaf624c7e68f9040969c0'))


async def close_owned_writer(writer, *, abort, timeout=1):
    """Bound local or remote transport cleanup; false means cleanup timed out."""
    if abort:
        writer.transport.abort()
    writer.close()
    try:
        await asyncio.wait_for(writer.wait_closed(), timeout)
        return True
    except (OSError, asyncio.TimeoutError):
        writer.transport.abort()
        return False


class Session:
    def __init__(self, broker, executor, generation, reader, writer):
        self.broker, self.executor, self.generation = broker, executor, generation
        self.reader, self.writer = reader, writer
        self.decoder = EnvelopeDecoder(executor, generation)
        self.ws = WebSocketDecoder()
        self.bindings = ProcessBindings()
        self.binding_generation = self.bindings.begin()
        self.sequence = 1
        self.pending = asyncio.Queue(maxsize=MAX_QUEUED_MESSAGES)
        self.pending_bytes = 0
        self.pending_count = 0
        self.processes, self.streams = {}, {}
        self.session_ready = asyncio.Event()
        self.revoked = asyncio.Event()
        self.revoking = False
        self.draining = False
        self.ready_reported = False
        self.lost_reported = False
        self.drain_requested = asyncio.Event()
        self.local_tasks = set()
        self.failed = False

    def send(self, kind, process=0, stream=0, payload=b''):
        if self.failed: raise ConnectionError('session failed')
        data = encode(Envelope(kind, self.executor, self.generation, process, stream, self.sequence, payload))
        frame = server_frame(2, data)
        if self.pending_count >= MAX_QUEUED_MESSAGES or len(frame) > MAX_QUEUED_BYTES - self.pending_bytes:
            raise BufferError('executor queue full')
        self.pending.put_nowait(frame)
        self.pending_bytes += len(frame)
        self.pending_count += 1
        self.sequence += 1

    async def send_loop(self):
        while True:
            data = await self.pending.get()
            self.writer.write(data)
            await self.writer.drain()
            self.pending_bytes -= len(data)
            self.pending_count -= 1
            self.pending.task_done()

    async def message(self, frame):
        if frame.kind == Kind.SESSION_READY:
            if self.session_ready.is_set() or frame.payload != HELLO: raise ValueError('bad session receipt')
            self.session_ready.set(); return
        if not self.session_ready.is_set(): raise ValueError('session not ready')
        if frame.kind == Kind.EXECUTOR_DRAIN:
            if self.draining: raise ValueError('duplicate drain')
            self.draining = True
            await self.broker.report_lifecycle(self, 5)
            self.drain_requested.set()
            return
        if frame.kind == Kind.REVOKED:
            if not self.revoking or self.revoked.is_set(): raise ValueError('unexpected revoked')
            self.revoked.set(); return
        process = self.processes.get(frame.process)
        if process is None: raise ValueError('unknown process')
        if frame.kind == Kind.PROCESS_READY:
            if process['ready'].is_set() or process['stopping']: raise ValueError('bad process receipt')
            process['ready'].set(); return
        if frame.kind == Kind.PROCESS_RETIRED:
            if not process['stopping'] or process['retired'].is_set(): raise ValueError('bad process retirement')
            process['retired'].set(); return
        stream = self.streams.get(frame.stream)
        if stream is None or stream['process'] != frame.process: raise ValueError('unknown stream')
        bound_process, _identity = self.bindings.identity(self.binding_generation, frame.stream)
        if bound_process != frame.process: raise ValueError('stream identity mismatch')
        if frame.kind == Kind.STREAM_READY:
            if stream['ready'].is_set(): raise ValueError('duplicate stream receipt')
            stream['ready'].set(); return
        if not stream['ready'].is_set() or stream['remote_fin'].is_set(): raise ValueError('stream not ready')
        if self.draining:
            # The local client has been cancelled; drain native output until
            # real process retirement without publishing a successful reply.
            if frame.kind == Kind.DATA: return
            if frame.kind == Kind.FIN:
                stream['remote_fin'].set(); return
            raise ValueError('unexpected draining stream message')
        if frame.kind == Kind.DATA:
            stream['writer'].write(frame.payload)
            await stream['writer'].drain(); return
        if frame.kind == Kind.FIN:
            stream['writer'].write_eof()
            await stream['writer'].drain()
            stream['remote_fin'].set(); return
        raise ValueError('unexpected executor message')

    async def revoke(self):
        if self.processes or self.streams or self.revoking:
            raise RuntimeError('cannot revoke with live resources')
        self.revoking = True
        self.send(Kind.REVOKE)
        await asyncio.wait_for(self.revoked.wait(), 4)

    async def drain(self):
        """Cancel local work, then wait for actual process retirement receipts."""
        self.draining = True
        for process_id, process in tuple(self.processes.items()):
            if not process['stopping']:
                process['stopping'] = True
                self.send(Kind.PROCESS_STOP, process_id)
        # Native process-stop is now ordered after all previously queued data.
        for task in tuple(self.local_tasks): task.cancel()
        if self.local_tasks:
            await asyncio.wait_for(asyncio.gather(*tuple(self.local_tasks), return_exceptions=True), 2)
        if self.failed:
            raise ConnectionError('local transport cleanup failed')
        for process_id, process in tuple(self.processes.items()):
            await asyncio.wait_for(process['retired'].wait(), 4)
            for stream_id in tuple(process['streams']):
                self.streams.pop(stream_id, None)
                self.bindings.unbind_stream(self.binding_generation, stream_id)
                process['streams'].remove(stream_id)
            self.bindings.retire_process(self.binding_generation, process_id)
            self.processes.pop(process_id, None)
        if self.streams:
            raise RuntimeError('streams remain after native retirement')
        await self.revoke()

    async def read_loop(self):
        while True:
            data = await self.reader.read(65536)
            if not data:
                self.ws.eof(); self.decoder.finish(); raise ConnectionError('executor disconnected')
            events = []
            def collect_event(kind, payload):
                if len(events) >= MAX_QUEUED_MESSAGES:
                    raise BufferError('incoming WebSocket event limit')
                events.append((kind, payload))
            self.ws.feed(data, collect_event)
            for kind, payload in events:
                if kind == 'close': raise ConnectionError('executor closed')
                if kind == 'ping':
                    frame = server_frame(10, payload)
                    if self.pending_count >= MAX_QUEUED_MESSAGES or len(frame) > MAX_QUEUED_BYTES - self.pending_bytes: raise BufferError('queue full')
                    self.pending.put_nowait(frame); self.pending_bytes += len(frame); self.pending_count += 1
                if kind != 'binary': continue
                messages = []
                def collect(message):
                    if len(messages) >= MAX_QUEUED_MESSAGES: raise BufferError('incoming queue full')
                    messages.append(message)
                self.decoder.feed(payload, collect)
                for message in messages: await self.message(message)

    async def local(self, reader, writer):
        peer = None
        process_id = stream_id = None
        try:
            sock = writer.get_extra_info('socket')
            if self.draining:
                return
            peer = PeerIdentity.from_socket(sock, os.getuid())
            offered = await asyncio.wait_for(reader.readexactly(48), 5)
            if offered != HELLO: raise ValueError('local hello mismatch')
            if self.draining:
                return
            process_id, stream_id = self.bindings.bind(self.binding_generation, peer)
            peer = None  # bindings owns it
            process = self.processes.get(process_id)
            if process is None:
                process = {'ready': asyncio.Event(), 'retired': asyncio.Event(), 'stopping': False, 'streams': set()}
                self.processes[process_id] = process
                self.send(Kind.PROCESS_OPEN, process_id)
            if process['stopping']: raise ValueError('process retiring')
            process['streams'].add(stream_id)
            await asyncio.wait_for(process['ready'].wait(), 10)
            stream = {'process': process_id, 'writer': writer, 'ready': asyncio.Event(), 'remote_fin': asyncio.Event()}
            self.streams[stream_id] = stream
            self.send(Kind.STREAM_OPEN, process_id, stream_id)
            await asyncio.wait_for(stream['ready'].wait(), 10)
            writer.write(HELLO); await writer.drain()
            while True:
                self.bindings.identity(self.binding_generation, stream_id)
                try:
                    payload = await asyncio.wait_for(reader.read(65536), 1)
                except asyncio.TimeoutError:
                    continue
                self.bindings.identity(self.binding_generation, stream_id)
                if not payload: break
                self.send(Kind.DATA, process_id, stream_id, payload)
            self.send(Kind.FIN, process_id, stream_id)
            await asyncio.wait_for(stream['remote_fin'].wait(), 10)
        except OverflowError:
            # Reject an excess local stream without taking ownership or poisoning
            # already admitted processes.
            pass
        except (OSError, ValueError, RuntimeError, BufferError, asyncio.TimeoutError, asyncio.IncompleteReadError):
            self.failed = True
            self.writer.close()
        finally:
            if peer is not None: peer.close()
            if not await close_owned_writer(writer, abort=self.draining or self.failed):
                self.failed = True
            if stream_id is not None and not self.draining:
                self.streams.pop(stream_id, None)
                with contextlib.suppress(RuntimeError, KeyError): self.bindings.unbind_stream(self.binding_generation, stream_id)
                process = self.processes.get(process_id)
                if process:
                    process['streams'].discard(stream_id)
                    if not process['streams'] and not self.failed and not self.draining:
                        process['stopping'] = True
                        try:
                            self.send(Kind.PROCESS_STOP, process_id)
                            await asyncio.wait_for(process['retired'].wait(), 10)
                            self.bindings.retire_process(self.binding_generation, process_id)
                            self.processes.pop(process_id, None)
                        except (OSError, RuntimeError, BufferError, asyncio.TimeoutError):
                            self.failed = True; self.writer.close()


class Broker:
    def __init__(self, control, token_file, socket_path):
        self.control, self.token_file, self.socket_path = control, token_file, socket_path
        self.compositor_pid = os.getppid()
        self.compositor_start = process_start_ticks(Path(f'/proc/{self.compositor_pid}/stat').read_text())
        self.lease = ExecutorLease()
        self.tasks = set(); self.closing = asyncio.Event()
        self.session = None
        self.next_bind = 0
        self.pending_binds = {}
        self.bind_send_lock = asyncio.Lock()

    async def request_bind(self, session, process_id, object_id, expected_epoch):
        """Ask the compositor to bind a live process and native Wayland object."""
        if (self.session is not session or session.draining or process_id not in session.processes or
            not session.processes[process_id]['ready'].is_set()):
            raise RuntimeError('process is not ready for surface binding')
        if len(expected_epoch) != 16 or expected_epoch == bytes(16):
            raise ValueError('invalid expected compositor epoch')
        if len(self.pending_binds) >= 64 or self.next_bind == (1 << 64) - 1:
            raise OverflowError('surface bind capacity')
        (uid, pid, start), pidfd = session.bindings.duplicate_process_identity(session.binding_generation, process_id)
        self.next_bind += 1
        request = self.next_bind
        future = asyncio.get_running_loop().create_future()
        self.pending_binds[request] = future
        try:
            data = control_protocol.encode_bind(control_protocol.Bind(request, process_id, uid, pid, start, object_id))
            await self.send_control(data, pidfd)
            result = await asyncio.wait_for(future, 5)
            if result.status:
                raise PermissionError('surface bind denied')
            if (result.epoch != expected_epoch or self.session is not session or session.draining or
                not pidfd_alive(pidfd) or pidfd_pid(pidfd) != pid):
                # The compositor may already hold a grant. Retire the entire
                # service rather than expose or silently leak a stale grant.
                self.closing.set()
                raise PermissionError('surface bind became stale')
            return result
        finally:
            os.close(pidfd)
            self.pending_binds.pop(request, None)

    async def send_control(self, data, fd=None):
        loop = asyncio.get_running_loop()
        ancillary = [] if fd is None else [(socket.SOL_SOCKET, socket.SCM_RIGHTS, array.array('i', [fd]))]
        async with self.bind_send_lock:
            deadline = loop.time() + 5
            while True:
                try:
                    n = self.control.sendmsg([data], ancillary)
                    if n != len(data): raise OSError('partial sequenced-packet control record')
                    return
                except BlockingIOError:
                    ready = loop.create_future()
                    def writable():
                        if not ready.done(): ready.set_result(None)
                    loop.add_writer(self.control.fileno(), writable)
                    try: await asyncio.wait_for(ready, max(0, deadline - loop.time()))
                    finally: loop.remove_writer(self.control.fileno())

    async def report_lifecycle(self, session, kind):
        if kind == 5 and session.lost_reported: return
        data = control_protocol.encode_lifecycle(control_protocol.ExecutorLifecycle(kind, session.executor, session.generation))
        await self.send_control(data)
        if kind == 4: session.ready_reported = True
        if kind == 5: session.lost_reported = True

    async def run(self):
        loop = asyncio.get_running_loop()
        self.control.setblocking(False)
        def ready():
            try:
                record = receive_record(self.control, os.getuid(), self.compositor_pid, self.compositor_start)
                if isinstance(record, control_protocol.BindResult):
                    future = self.pending_binds.get(record.request)
                    if future is None or future.done(): raise ValueError('unexpected bind response')
                    future.set_result(record)
                    return
                if isinstance(record, control_protocol.RevokeGrant):
                    # Surface CGLV revoke is not yet assigned: terminate rather
                    # than let an obsolete grant remain usable.
                    self.closing.set(); return
                stream = record
            except BlockingIOError: return
            except (OSError, ValueError, PermissionError): self.closing.set(); return
            if len(self.tasks) >= MAX_QUEUED_MESSAGES:
                stream.close(); return
            stream.setblocking(False)
            task = asyncio.create_task(self.remote(stream))
            self.tasks.add(task); task.add_done_callback(self.tasks.discard)
        loop.add_reader(self.control.fileno(), ready)
        try: await self.closing.wait()
        finally:
            loop.remove_reader(self.control.fileno()); self.control.close()
            for future in self.pending_binds.values():
                if not future.done(): future.set_exception(ConnectionError('compositor control closed'))
            if self.tasks:
                _done, pending = await asyncio.wait(tuple(self.tasks), timeout=10)
                for task in pending: task.cancel()
                if pending: await asyncio.gather(*pending, return_exceptions=True)

    async def remote(self, stream):
        writer = server = None
        session = executor = generation = None
        sender = receiver = stop_wait = drain_wait = None
        owned_socket = None
        try:
            reader, writer = await asyncio.open_connection(sock=stream, limit=MAX_REQUEST + 4)
            raw = await asyncio.wait_for(reader.readuntil(b'\r\n\r\n'), 5)
            with self.token_file.open('rb') as token_file:
                token = token_file.read(MAX_TOKEN + 1)
            if len(token) > MAX_TOKEN:
                raise ValueError('token file too large')
            _computer, executor, response = admit(raw, token.strip())
            generation = self.lease.admit(executor.bytes)
            session = Session(self, executor.bytes, generation, reader, writer)
            writer.write(response); await writer.drain()
            sender = asyncio.create_task(session.send_loop())
            receiver = asyncio.create_task(session.read_loop())
            session.send(Kind.SESSION, payload=HELLO)
            await asyncio.wait_for(session.session_ready.wait(), 10)
            await self.report_lifecycle(session, 4)
            self.lease.ready(executor.bytes, generation)
            self.session = session
            directory = self.socket_path.parent
            info = directory.lstat()
            if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or
                stat.S_IMODE(info.st_mode) != 0o700 or os.path.lexists(self.socket_path)):
                raise PermissionError('unsafe local socket directory or existing path')
            def start_local(local_reader, local_writer):
                if len(session.local_tasks) >= MAX_QUEUED_MESSAGES:
                    local_writer.close(); return
                task = asyncio.create_task(session.local(local_reader, local_writer))
                session.local_tasks.add(task)
                task.add_done_callback(session.local_tasks.discard)
            server = await asyncio.start_unix_server(start_local, path=str(self.socket_path))
            os.chmod(self.socket_path, 0o600)
            owned_socket = self.socket_path.lstat().st_ino
            stop_wait = asyncio.create_task(self.closing.wait())
            drain_wait = asyncio.create_task(session.drain_requested.wait())
            done, _ = await asyncio.wait((sender, receiver, stop_wait, drain_wait), return_when=asyncio.FIRST_COMPLETED)
            if stop_wait in done or drain_wait in done:
                server.close()
                with contextlib.suppress(OSError, asyncio.TimeoutError):
                    await self.report_lifecycle(session, 5)
                self.lease.revoke(executor.bytes, generation)
                await session.drain()
                await server.wait_closed(); server = None
                await self.report_lifecycle(session, 6)
                self.lease.finished(executor.bytes, generation)
            else:
                for task in done: task.result()
        except (OSError, ValueError, RuntimeError, BufferError, asyncio.TimeoutError, asyncio.IncompleteReadError, asyncio.LimitOverrunError):
            pass
        finally:
            if self.session is session:
                self.session = None
            if server:
                server.close()
            if owned_socket is not None:
                with contextlib.suppress(OSError):
                    if self.socket_path.lstat().st_ino == owned_socket: self.socket_path.unlink()
            if session:
                if session.ready_reported and not session.lost_reported:
                    with contextlib.suppress(OSError, asyncio.TimeoutError):
                        await self.report_lifecycle(session, 5)
                session.failed = True
                for task in tuple(session.local_tasks): task.cancel()
                if session.local_tasks:
                    try:
                        await asyncio.wait_for(asyncio.gather(*tuple(session.local_tasks), return_exceptions=True), 2)
                    except asyncio.TimeoutError:
                        session.failed = True
                if not session.revoked.is_set():
                    # Socket loss alone is not native finish; leave lease draining.
                    self.lease.revoke(executor.bytes, generation)
                with contextlib.suppress(RuntimeError): session.bindings.finish(session.binding_generation)
            if server:
                with contextlib.suppress(OSError, asyncio.TimeoutError):
                    await asyncio.wait_for(server.wait_closed(), 1)
            for task in (sender, receiver, stop_wait, drain_wait):
                if task and not task.done(): task.cancel()
            if sender or receiver or stop_wait or drain_wait:
                await asyncio.gather(*(t for t in (sender, receiver, stop_wait, drain_wait) if t), return_exceptions=True)
            if writer:
                await close_owned_writer(writer, abort=session is None or not session.revoked.is_set())
            else: stream.close()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--control-fd', type=int, required=True)
    parser.add_argument('--token-file', type=Path, required=True)
    parser.add_argument('--socket', type=Path, required=True)
    args = parser.parse_args()
    control = socket.socket(fileno=args.control_fd)
    if control.family != socket.AF_UNIX or control.getsockopt(socket.SOL_SOCKET, socket.SO_TYPE) != socket.SOCK_SEQPACKET:
        raise SystemExit('private Unix sequenced-packet control socket required')
    asyncio.run(Broker(control, args.token_file, args.socket).run())


if __name__ == '__main__': main()
