#!/usr/bin/python3 -I
"""Wine and Proton at the display's density (README.md).

Wine takes its DPI from each prefix's registry, HKCU\\Control Panel\\Desktop\\LogPixels,
96 by default: not from X11. On a display at scale 3 every Wine window is a third of the
size of the computer's other windows. This service follows the owner's display density
(XSETTINGS Xft/DPI, which caboose-display publishes) and writes it as LogPixels into every
Wine prefix it finds but Steam games', when the density changes and as prefixes appear.
Steam games' Proton prefixes are kept at 96.

usage: caboose-wine-dpi            the service (runs as the owner)
       caboose-wine-dpi --once DPI  set DPI in every prefix now and exit"""
import os
from pathlib import Path
import re
import sys
import tempfile

DISPLAY_ENV = Path("/run/caboose/display.env")
STEAM_ROOTS = (".var/app/com.valvesoftware.Steam/.local/share/Steam", ".local/share/Steam")
DESKTOP = "[Control Panel\\\\Desktop]"
EXPLORER = "[Software\\\\Wine\\\\Explorer]"
DESKTOPS = "[Software\\\\Wine\\\\Explorer\\\\Desktops]"
# A Steam game's virtual desktop: landscape, at least what games commonly require.
GAME_DESKTOP = (1920, 1080)
RESCAN_SECONDS = 10


def dpi_for(xft_dpi):
    """LogPixels for an Xft/DPI value (dots per inch times 1024): 96 when unknown."""
    if not xft_dpi or xft_dpi <= 0:
        return 96
    return max(96, min(480, round(xft_dpi / 1024)))


def library_paths(steam_root):
    """The library folders Steam's libraryfolders.vdf names, with Steam's own first."""
    paths = [steam_root]
    vdf = steam_root / "steamapps" / "libraryfolders.vdf"
    try:
        text = vdf.read_text(errors="replace")
    except OSError:
        return paths
    for match in re.finditer(r'"path"\s+"((?:[^"\\]|\\.)*)"', text):
        path = Path(match.group(1).replace("\\\\", "\\"))
        if path not in paths:
            paths.append(path)
    return paths


def prefixes(home):
    """Every Wine prefix under `home`, as (prefix, is a Steam game's): ~/.wine, winetricks'
    and each Steam game's Proton prefix."""
    home = Path(home)
    candidates = [(home / ".wine", False)]
    candidates += [(p, False) for p in sorted((home / ".local/share/wineprefixes").glob("*"))]
    for relative in STEAM_ROOTS:
        root = home / relative
        if not root.is_dir():
            continue
        for library in library_paths(root):
            candidates += [(p, True) for p in sorted((library / "steamapps" / "compatdata").glob("*/pfx"))]
    seen, found = set(), []
    for prefix, game in candidates:
        if (prefix / "user.reg").is_file() and prefix.resolve() not in seen:
            seen.add(prefix.resolve())
            found.append((prefix, game))
    return found


def with_value(text, section, name, value):
    """user.reg `text` with `"name"=value` in `section` ("[Key\\\\Path]"), made if missing."""
    line_value = f'"{name}"={value}'
    lines = text.split("\n")
    start = next((i for i, line in enumerate(lines) if line == section or line.startswith(section + " ")), None)
    if start is None:
        tail = "" if text.endswith("\n\n") else ("\n" if text.endswith("\n") else "\n\n")
        return f"{text}{tail}{section} 0\n{line_value}\n"
    end = start + 1
    while end < len(lines) and lines[end].strip() and not lines[end].startswith("["):
        end += 1
    for i in range(start + 1, end):
        if lines[i].startswith(f'"{name}"='):
            if lines[i] == line_value:
                return text
            lines[i] = line_value
            return "\n".join(lines)
    lines.insert(end, line_value)
    return "\n".join(lines)


def with_log_pixels(text, dpi):
    """user.reg `text` with LogPixels = `dpi` in its Control Panel\\Desktop section."""
    return with_value(text, DESKTOP, "LogPixels", f"dword:{dpi:08x}")


def game_desktop(display):
    """A Steam game's virtual desktop for a display of `display` (width, height) pixels:
    landscape, the display's own size where that is larger than GAME_DESKTOP on each side."""
    width, height = max(display), min(display)
    return max(width, GAME_DESKTOP[0]), max(height, GAME_DESKTOP[1])


def with_game_settings(text, desktop):
    """A Steam game's user.reg: 96 DPI, and a virtual desktop of `desktop` (width, height).
    Wine reports the virtual desktop's size as the screen whatever the phone's orientation,
    and the phone shows the desktop window scaled to fit."""
    text = with_log_pixels(text, 96)
    text = with_value(text, EXPLORER, "Desktop", '"Default"')
    return with_value(text, DESKTOPS, "Default", f'"{desktop[0]}x{desktop[1]}"')


def apply(prefix, dpi, desktop=None):
    """Writes `dpi` into `prefix`'s user.reg, or, with a `desktop` size, a Steam game's
    settings; True if it changed."""
    reg = Path(prefix) / "user.reg"
    try:
        current = reg.read_text(encoding="utf-8", errors="surrogateescape")
    except OSError:
        return False
    updated = with_game_settings(current, desktop) if desktop else with_log_pixels(current, dpi)
    if updated == current:
        return False
    fd, temporary = tempfile.mkstemp(prefix=".user.reg.", dir=reg.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8", errors="surrogateescape") as out:
            out.write(updated)
        os.chmod(temporary, reg.stat().st_mode & 0o777)
        os.replace(temporary, reg)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    return True


def apply_all(home, dpi, display=(0, 0)):
    """`dpi` in every prefix but games'. Games keep 96, since Wine shows one that does not
    declare itself DPI-aware a screen smaller by the DPI's factor, and run in a virtual
    desktop (`game_desktop` for `display`, in pixels), since games refuse to run below their
    minimum resolution and a phone in portrait is narrow."""
    changed = []
    desktop = game_desktop(display)
    for prefix, game in prefixes(home):
        if apply(prefix, dpi, desktop if game else None):
            what = f"virtual desktop {desktop[0]}x{desktop[1]}" if game else f"LogPixels {dpi}"
            print(f"{what} in {prefix}", flush=True)
            changed.append(prefix)
    return changed


def display_environment(path=DISPLAY_ENV):
    """DISPLAY and XAUTHORITY from the owner display's launch environment."""
    env = {}
    for line in path.read_text().splitlines():
        key, _, value = line.partition("=")
        if key in ("DISPLAY", "XAUTHORITY"):
            env[key] = value.strip().strip("'\"")
    return env


def serve(home):
    import time
    while not DISPLAY_ENV.exists() or "DISPLAY" not in display_environment():
        time.sleep(2)
    os.environ.update(display_environment())
    os.environ["GDK_BACKEND"] = "x11"
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import GLib, Gtk
    if not Gtk.init_check(None)[0]:
        sys.exit("caboose-wine-dpi: cannot open the display")
    settings = Gtk.Settings.get_default()
    state = {"dpi": None}

    from gi.repository import Gdk
    display = Gdk.Display.get_default()

    def screen_size():
        """The X screen in pixels: the union of its monitors (GDK_SCALE is unset)."""
        rects = [display.get_monitor(i).get_geometry() for i in range(display.get_n_monitors())]
        return (max((r.x + r.width for r in rects), default=0), max((r.y + r.height for r in rects), default=0))

    def update(*_):
        state["dpi"] = dpi_for(settings.props.gtk_xft_dpi)
        apply_all(home, state["dpi"], screen_size())
        return True

    settings.connect("notify::gtk-xft-dpi", update)
    update()
    GLib.timeout_add_seconds(RESCAN_SECONDS, update)
    # The display's X server ending ends this service, which its manager restarts.
    Gtk.main()


if __name__ == "__main__":
    home = Path(os.environ.get("HOME", Path.home()))
    if len(sys.argv) == 3 and sys.argv[1] == "--once":
        apply_all(home, int(sys.argv[2]))
        sys.exit(0)
    if len(sys.argv) != 1:
        sys.exit(__doc__.split("\n\n")[-1])
    serve(home)
