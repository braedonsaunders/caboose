#!/usr/bin/python3 -I
"""Every Wine prefix set up the same way for the phone's display (README.md).

Each prefix gets 96 DPI (HKCU\\Control Panel\\Desktop\\LogPixels): Wine then reports the
display's real pixels as the screen, which a program checks against the resolution it needs.
On a display smaller than 1280x720 on either side (a phone in portrait), each prefix runs in
a Wine virtual desktop, landscape and at least 1920x1080, which Wine reports as the screen.

The prefixes are ~/.wine, winetricks' (~/.local/share/wineprefixes/*) and every prefix a
running Wine process on the owner's display names in WINEPREFIX (never one on the agent seat),
remembered once seen.

usage: caboose-wine-dpi    the service (runs as the owner)"""
import os
from pathlib import Path
import sys
import tempfile

DISPLAY_ENV = Path("/run/caboose/display.env")
KNOWN = ".local/state/caboose/wine-prefixes"
DESKTOP = "[Control Panel\\\\Desktop]"
EXPLORER = "[Software\\\\Wine\\\\Explorer]"
DESKTOPS = "[Software\\\\Wine\\\\Explorer\\\\Desktops]"
# The virtual desktop: landscape, at least what programs commonly require.
VIRTUAL_DESKTOP = (1920, 1080)
MINIMUM = (1280, 720)
DPI = 96
RESCAN_SECONDS = 10


def with_value(text, section, name, value):
    """user.reg `text` with `"name"=value` in `section` ("[Key\\\\Path]"), made if missing."""
    line_value = f'"{name}"={value}'
    lines = text.split("\n")
    start = next((i for i, line in enumerate(lines) if line == section or line.startswith(section + " ")), None)
    if start is None:
        tail = "" if text.endswith("\n\n") else ("\n" if text.endswith("\n") else "\n\n")
        return f"{text}{tail}{section} 0\n{line_value}\n"
    end = start + 1
    while end < len(lines) and lines[end].strip() and not lines[end].startswith("["):
        end += 1
    for i in range(start + 1, end):
        if lines[i].startswith(f'"{name}"='):
            if lines[i] == line_value:
                return text
            lines[i] = line_value
            return "\n".join(lines)
    lines.insert(end, line_value)
    return "\n".join(lines)


def without_value(text, section, name):
    """user.reg `text` without `"name"=…` in `section`."""
    lines = text.split("\n")
    start = next((i for i, line in enumerate(lines) if line == section or line.startswith(section + " ")), None)
    if start is None:
        return text
    end = start + 1
    while end < len(lines) and lines[end].strip() and not lines[end].startswith("["):
        end += 1
    kept = [line for line in lines[start + 1:end] if not line.startswith(f'"{name}"=')]
    if len(kept) == end - start - 1:
        return text
    return "\n".join(lines[:start + 1] + kept + lines[end:])


def needs_desktop(display):
    """Whether a display of `display` (width, height) pixels is smaller than 1280x720, the
    least programs commonly require, on either side."""
    return display[0] < MINIMUM[0] or display[1] < MINIMUM[1]


def virtual_desktop(display):
    """The virtual desktop for a display of `display` (width, height) pixels: landscape, the
    display's own size where that is larger than VIRTUAL_DESKTOP on each side."""
    width, height = max(display), min(display)
    return max(width, VIRTUAL_DESKTOP[0]), max(height, VIRTUAL_DESKTOP[1])


def with_settings(text, desktop):
    """A prefix's user.reg with 96 DPI and a virtual desktop of `desktop` (width, height), or
    none when `desktop` is None."""
    text = with_value(text, DESKTOP, "LogPixels", f"dword:{DPI:08x}")
    if desktop is None:
        return without_value(text, EXPLORER, "Desktop")
    text = with_value(text, EXPLORER, "Desktop", '"Default"')
    return with_value(text, DESKTOPS, "Default", f'"{desktop[0]}x{desktop[1]}"')


def running_prefixes(proc="/proc", display=None):
    """The prefixes running Wine processes of this user name in WINEPREFIX. With `display`,
    only those of processes on that X display: a prefix running on another seat (a check's
    own) follows that seat's display, not this one's. Processes on the agent seat
    (CABOOSE_SEAT=agent) are left out: their prefixes run on that seat, whose windows are read
    and driven as they are, not sized for the phone's display."""
    found = set()
    for entry in Path(proc).iterdir():
        if not entry.name.isdigit():
            continue
        try:
            if entry.stat().st_uid != os.getuid():
                continue
            environ = (entry / "environ").read_bytes().split(b"\0")
        except OSError:
            continue
        if b"CABOOSE_SEAT=agent" in environ:
            continue
        if display is not None and f"DISPLAY={display}".encode() not in environ:
            continue
        for item in environ:
            if item.startswith(b"WINEPREFIX="):
                value = item[len(b"WINEPREFIX="):].decode(errors="surrogateescape")
                if value.startswith("/"):
                    found.add(Path(value))
    return found


def prefixes(home, seen=()):
    """Every known prefix with a user.reg: ~/.wine, winetricks' and `seen`, each once."""
    home = Path(home)
    candidates = [home / ".wine", *sorted((home / ".local/share/wineprefixes").glob("*")), *sorted(seen)]
    found, resolved = [], set()
    for prefix in candidates:
        if (prefix / "user.reg").is_file() and prefix.resolve() not in resolved:
            resolved.add(prefix.resolve())
            found.append(prefix)
    return found


def remembered(home):
    try:
        return {Path(line) for line in (Path(home) / KNOWN).read_text().splitlines() if line.startswith("/")}
    except OSError:
        return set()


def remember(home, prefixes_):
    path = Path(home) / KNOWN
    text = "".join(f"{p}\n" for p in sorted(prefixes_))
    try:
        if path.read_text() == text:
            return
    except OSError:
        pass
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)


def apply(prefix, desktop=None):
    """Writes the settings into `prefix`'s user.reg; True if it changed."""
    reg = Path(prefix) / "user.reg"
    try:
        current = reg.read_text(encoding="utf-8", errors="surrogateescape")
    except OSError:
        return False
    updated = with_settings(current, desktop)
    if updated == current:
        return False
    fd, temporary = tempfile.mkstemp(prefix=".user.reg.", dir=reg.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8", errors="surrogateescape") as out:
            out.write(updated)
        os.chmod(temporary, reg.stat().st_mode & 0o777)
        os.replace(temporary, reg)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    return True


def apply_all(home, display=(0, 0), seen=()):
    """The settings in every known prefix, for a display of `display` pixels."""
    changed = []
    desktop = virtual_desktop(display) if needs_desktop(display) else None
    for prefix in prefixes(home, seen):
        if apply(prefix, desktop):
            what = f"virtual desktop {desktop[0]}x{desktop[1]}" if desktop else "no virtual desktop"
            print(f"{DPI} DPI, {what} in {prefix}", flush=True)
            changed.append(prefix)
    return changed


def display_environment(path=DISPLAY_ENV):
    """DISPLAY and XAUTHORITY from the owner display's launch environment."""
    env = {}
    for line in path.read_text().splitlines():
        key, _, value = line.partition("=")
        if key in ("DISPLAY", "XAUTHORITY"):
            env[key] = value.strip().strip("'\"")
    return env


def serve(home):
    import time
    while not DISPLAY_ENV.exists() or "DISPLAY" not in display_environment():
        time.sleep(2)
    os.environ.update(display_environment())
    os.environ["GDK_BACKEND"] = "x11"
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, GLib, Gtk
    if not Gtk.init_check(None)[0]:
        sys.exit("caboose-wine-dpi: cannot open the display")
    display = Gdk.Display.get_default()

    def screen_size():
        """The X screen in pixels: the union of its monitors (GDK_SCALE is unset)."""
        rects = [display.get_monitor(i).get_geometry() for i in range(display.get_n_monitors())]
        return (max((r.x + r.width for r in rects), default=0), max((r.y + r.height for r in rects), default=0))

    def update(*_):
        seen = remembered(home) | running_prefixes(display=os.environ.get("DISPLAY"))
        remember(home, seen)
        apply_all(home, screen_size(), seen)
        return True

    update()
    GLib.timeout_add_seconds(RESCAN_SECONDS, update)
    # The display's X server ending ends this service, which its manager restarts.
    Gtk.main()


if __name__ == "__main__":
    home = Path(os.environ.get("HOME", Path.home()))
    if len(sys.argv) != 1:
        sys.exit(__doc__.split("\n\n")[-1])
    serve(home)
