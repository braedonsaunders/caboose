#!/usr/bin/python3 -I
"""Makes a Steam game that is linked to read-only files a normal Steam install.

A game can be provided to a computer as a link from its library's steamapps/common/<dir> to
a read-only tree (another library's files, shared between computers). Steam cannot write
there, so it cannot update the game or install its DLC. This copies the tree into the
library as a real directory, keeps the link beside it as <dir>.farm, and marks the game as
needing an update: at its next start Steam validates the files against the game's depots and
downloads what is missing or changed. Copies use copy_file_range, which shares blocks on a
filesystem that can (XFS, Btrfs) and copies them otherwise.

A real install also gets the Steamworks Common Redistributables the link never had, and
Steam runs their install scripts before the game's next launch. Under Proton, DirectX's
(DXSETUP.exe /silent, June 2010) has nothing to install, since Proton provides DirectX, and
can wait forever; the game's Proton prefix is marked as having run it, as Steam records a
finished step (HKLM\\Software\\Valve\\Steam\\Apps\\CommonRedist\\DirectX\\Jun2010, "dxsetup").

usage: caboose-steam-adopt [--home HOME] [--keep-dlc ID,...] [--skip DIR,...] APPID

  --keep-dlc  record only the base depots and those of these DLC as installed, and ask for
              these DLC (the game's optional DLC are otherwise kept as they are)
  --skip      top-level directories of the game not to copy (content of DLC not kept)

Run as the owner while Steam is not running; it refuses otherwise."""
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys

STEAM_DIRS = (".var/app/com.valvesoftware.Steam/.local/share/Steam", ".local/share/Steam")


# -- KeyValues (appmanifest_N.acf) --------------------------------------------------------

def blocks(text):
    """{path tuple: (start of the key, index after the closing brace)} for every block."""
    out, stack, key, i = {}, [], None, 0
    while i < len(text):
        c = text[i]
        if c == '"':
            j = i + 1
            while text[j] != '"':
                j += 2 if text[j] == "\\" else 1
            token, start = text[i + 1:j], i
            if key is None:
                key, key_at = token, start
            else:
                key = None
            i = j + 1
        elif c == "{":
            if key is None:
                raise ValueError("block without a key")
            stack.append((key, key_at))
            key = None
            i += 1
        elif c == "}":
            if not stack:
                raise ValueError("unbalanced block")
            path = tuple(k for k, _ in stack)
            out[path] = (stack[-1][1], i + 1)
            stack.pop()
            i += 1
        else:
            i += 1
    if stack:
        raise ValueError("unterminated block")
    return out


def value(text, path, name):
    """A value's text in the block at `path`, or None."""
    span = blocks(text).get(path)
    if span is None:
        return None
    body = text[span[0]:span[1]]
    m = re.search(r'\n\s*"%s"\s+"((?:[^"\\]|\\.)*)"' % re.escape(name), body)
    return m.group(1) if m else None


def with_value(text, path, name, new):
    """`text` with `"name" "new"` in the block at `path`, replaced where it is (all
    occurrences directly in that block) or added at its end."""
    span = blocks(text)[path]
    body = text[span[0]:span[1]]
    depth = len(path)
    pattern = re.compile(r'(\n\t{%d}"%s"\t+)"(?:[^"\\]|\\.)*"' % (depth, re.escape(name)))
    if pattern.search(body):
        body = pattern.sub(lambda m: f'{m.group(1)}"{new}"', body)
    else:
        close = body.rfind("}")
        body = body[:close] + "\t" * depth + f'"{name}"\t\t"{new}"\n' + "\t" * (depth - 1) + body[close:]
    return text[:span[0]] + body + text[span[1]:]


def without_block(text, path):
    span = blocks(text)[path]
    start = text.rfind("\n", 0, span[0])
    return text[:start] + text[span[1]:]


def adopted_manifest(text, keep_dlc=None):
    """An appmanifest_N.acf whose game is to be validated and brought up to date: StateFlags
    1026 (update required). With `keep_dlc`, only the base depots and those of these DLC stay
    recorded as installed and these are the optional DLC asked for."""
    app = ("AppState",)
    text = with_value(text, app, "StateFlags", "1026")
    if keep_dlc is not None:
        installed = app + ("InstalledDepots",)
        for path in sorted(p for p in blocks(text) if len(p) == 3 and p[:2] == installed):
            dlc = value(text, path, "dlcappid")
            if dlc is not None and int(dlc) not in keep_dlc:
                text = without_block(text, path)
        wanted = ",".join(str(d) for d in keep_dlc)
        for config in ("UserConfig", "MountedConfig"):
            if app + (config,) in blocks(text):
                text = with_value(text, app + (config,), "optionaldlc", wanted)
    return text


# -- Proton prefix (system.reg) ----------------------------------------------------------

DIRECTX_KEYS = ("Software\\\\Valve\\\\Steam\\\\Apps\\\\CommonRedist\\\\DirectX\\\\Jun2010",
                "Software\\\\Wow6432Node\\\\Valve\\\\Steam\\\\Apps\\\\CommonRedist\\\\DirectX\\\\Jun2010")


def with_registry_dword(text, key, name, number):
    """A Wine registry file's `text` with `"name"=dword:number` in `[key]` (as escaped in
    the file), the key made if missing."""
    line = f'"{name}"=dword:{number:08x}'
    lines = text.split("\n")
    start = next((i for i, l in enumerate(lines) if l == f"[{key}]" or l.startswith(f"[{key}] ")), None)
    if start is None:
        tail = "" if text.endswith("\n\n") else ("\n" if text.endswith("\n") else "\n\n")
        return f"{text}{tail}[{key}]\n{line}\n"
    end = start + 1
    while end < len(lines) and lines[end].strip() and not lines[end].startswith("["):
        end += 1
    for i in range(start + 1, end):
        if lines[i].startswith(f'"{name}"='):
            lines[i] = line
            return "\n".join(lines)
    lines.insert(end, line)
    return "\n".join(lines)


def mark_redistributables(prefix):
    """Records DirectX's Common Redistributable step as run in a Proton prefix, when it has
    one; True if it changed."""
    reg = Path(prefix) / "system.reg"
    try:
        text = reg.read_text(encoding="utf-8", errors="surrogateescape")
    except OSError:
        return False
    updated = text
    for key in DIRECTX_KEYS:
        updated = with_registry_dword(updated, key, "dxsetup", 1)
    if updated == text:
        return False
    temporary = reg.with_name(".system.reg.adopt")
    temporary.write_text(updated, encoding="utf-8", errors="surrogateescape")
    temporary.replace(reg)
    return True


# -- Files --------------------------------------------------------------------------------

def copy_file(source, target):
    """Copies a file's bytes with copy_file_range (block sharing where the filesystem has it)."""
    with open(source, "rb") as src, open(target, "wb") as dst:
        size = os.fstat(src.fileno()).st_size
        copied = 0
        while copied < size:
            try:
                n = os.copy_file_range(src.fileno(), dst.fileno(), size - copied)
            except (OSError, AttributeError):  # not Linux, or a filesystem without it
                shutil.copyfileobj(src, dst, 1 << 20)
                break
            if n == 0:
                break
            copied += n
    shutil.copystat(source, target, follow_symlinks=True)
    os.chmod(target, stat.S_IMODE(os.stat(target).st_mode) | stat.S_IWUSR)


def copy_tree(source, target, skip=()):
    """`source`'s files, symbolic links followed, as a real tree at `target` the owner can write."""
    os.makedirs(target, exist_ok=True)
    for entry in sorted(os.scandir(source), key=lambda e: e.name):
        if entry.name in skip:
            continue
        destination = os.path.join(target, entry.name)
        if entry.is_dir(follow_symlinks=True):
            copy_tree(entry.path, destination)
        elif entry.is_file(follow_symlinks=True):
            copy_file(entry.path, destination)
    os.chmod(target, 0o755)


def library_of(home, appid):
    """(steamapps directory, manifest path) of the library holding `appid`."""
    for relative in STEAM_DIRS:
        root = Path(home) / relative
        libraries = [root]
        vdf = root / "steamapps" / "libraryfolders.vdf"
        if vdf.is_file():
            for m in re.finditer(r'"path"\s+"((?:[^"\\]|\\.)*)"', vdf.read_text(errors="replace")):
                libraries.append(Path(m.group(1).replace("\\\\", "\\")))
        for library in libraries:
            manifest = library / "steamapps" / f"appmanifest_{appid}.acf"
            if manifest.is_file():
                return library / "steamapps", manifest
    return None, None


def steam_running():
    return subprocess.run(["pgrep", "-u", str(os.getuid()), "-f", r"steamrt64/steam|steamwebhelper|ubuntu12_32/steam"],
                          stdout=subprocess.DEVNULL).returncode == 0


def adopt(home, appid, keep_dlc=None, skip=()):
    steamapps, manifest = library_of(home, appid)
    if manifest is None:
        raise SystemExit(f"caboose-steam-adopt: no Steam library has app {appid}")
    text = manifest.read_text()
    installdir = value(text, ("AppState",), "installdir")
    if not installdir or "/" in installdir:
        raise SystemExit(f"caboose-steam-adopt: app {appid} has no install directory")
    game = steamapps / "common" / installdir
    if not game.is_symlink():
        raise SystemExit(f"caboose-steam-adopt: {game} is already a real directory")
    farm = game.with_name(installdir + ".farm")
    source = os.path.realpath(game)
    staging = game.with_name(installdir + ".adopting")
    shutil.rmtree(staging, ignore_errors=True)
    copy_tree(source, staging, skip)
    (steamapps.parent / "caboose-adopted").mkdir(exist_ok=True)
    backup = steamapps.parent / "caboose-adopted" / f"appmanifest_{appid}.acf"
    if not backup.exists():
        shutil.copy2(manifest, backup)
    game.rename(farm)
    staging.rename(game)
    temporary = manifest.with_name(manifest.name + ".new")
    temporary.write_text(adopted_manifest(text, keep_dlc))
    temporary.replace(manifest)
    mark_redistributables(steamapps / "compatdata" / str(appid) / "pfx")
    print(f"app {appid}: {game} is a real install; the link is {farm}; Steam validates it at its next start")


def main(argv):
    home, keep_dlc, skip, args = os.environ.get("HOME", str(Path.home())), None, (), []
    it = iter(argv)
    for arg in it:
        if arg == "--home":
            home = next(it)
        elif arg == "--keep-dlc":
            keep_dlc = [int(x) for x in next(it).split(",") if x]
        elif arg == "--skip":
            skip = tuple(x for x in next(it).split(",") if x and "/" not in x)
        else:
            args.append(arg)
    if len(args) != 1 or not args[0].isdigit():
        raise SystemExit(__doc__.split("\n\n")[-2])
    if steam_running():
        raise SystemExit("caboose-steam-adopt: Steam is running; quit it first")
    adopt(home, int(args[0]), keep_dlc, skip)


if __name__ == "__main__":
    main(sys.argv[1:])
