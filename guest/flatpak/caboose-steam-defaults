#!/usr/bin/python3 -I
"""Steam's defaults on a Caboose computer, applied before Steam starts.

Shader pre-caching is off. Steam compiles a game's recorded pipelines for the computer's own
GPU driver before a launch whose cache bucket changed, on every core, after downloading the
bucket: on a computer that renders on the phone's GPU the game never uses that work. Steam
also delivers some games' videos re-encoded for Proton through pre-caching; those games play
their original videos.

usage: caboose-steam-defaults [HOME]

Sets the defaults in Steam's config.vdf, in the Flatpak's data directory and the native one,
where Steam has made them, unless Steam is running: it writes the file back when it exits."""
import os
from pathlib import Path
import sys
import tempfile

# config.vdf: InstallConfigStore > Software > Valve > Steam > ShaderCacheManager, where
# Steam's Downloads settings keep "Enable Shader Pre-caching".
STEAM_PATH = ("InstallConfigStore", "Software", "Valve", "Steam", "ShaderCacheManager")
DEFAULTS = {"DisableShaderCache": "1"}
STEAM_DIRS = (".var/app/com.valvesoftware.Steam/.local/share/Steam", ".local/share/Steam")


class Block:
    """A KeyValues block: where its braces are, its values' spans and its child blocks."""

    def __init__(self, open_at):
        self.open_at = open_at
        self.close_at = None
        self.values = {}  # key -> (start, end) of the quoted value
        self.blocks = {}  # key -> Block


def tokens(text):
    """(token, start, end): quoted strings unquoted, braces as themselves; // comments skipped."""
    i = 0
    while i < len(text):
        c = text[i]
        if c in "{}":
            yield c, i, i + 1
            i += 1
        elif c == '"':
            j = i + 1
            while j < len(text) and text[j] != '"':
                j += 2 if text[j] == "\\" else 1
            if j >= len(text):
                raise ValueError("config.vdf: unterminated string")
            yield text[i + 1:j], i, j + 1
            i = j + 1
        elif text.startswith("//", i):
            newline = text.find("\n", i)
            i = len(text) if newline < 0 else newline + 1
        else:
            i += 1


def parse(text):
    """The top level of a KeyValues text, as a Block without braces."""
    top = Block(-1)
    stack = [top]
    key = None
    for tok, start, end in tokens(text):
        if tok == "{" and text[start] == "{":
            if key is None:
                raise ValueError("config.vdf: block without a key")
            block = Block(start)
            stack[-1].blocks.setdefault(key, block)
            stack.append(block)
            key = None
        elif tok == "}" and text[start] == "}":
            if len(stack) == 1 or key is not None:
                raise ValueError("config.vdf: unbalanced block")
            stack.pop().close_at = start
        elif key is None:
            key = tok
        else:
            stack[-1].values.setdefault(key, (start, end))
            key = None
    if len(stack) != 1 or key is not None:
        raise ValueError("config.vdf: unterminated block")
    top.close_at = len(text)
    return top


def with_defaults(text, path=STEAM_PATH, values=DEFAULTS):
    """`text` with each of `values` set in the block at `path`, made where it is missing."""
    block, depth = parse(text), 0
    while depth < len(path) and path[depth] in block.blocks:
        block = block.blocks[path[depth]]
        depth += 1
    edits = []
    missing = {}
    for key, value in values.items():
        if depth == len(path) and key in block.values:
            edits.append((*block.values[key], f'"{value}"'))
        else:
            missing[key] = value
    if missing:
        # The blocks still missing from `path`, holding the values, before this block closes.
        lines = []
        for n in range(depth, len(path)):
            lines += ["\t" * n + f'"{path[n]}"', "\t" * n + "{"]
        lines += ["\t" * len(path) + f'"{k}"\t\t"{v}"' for k, v in missing.items()]
        lines += ["\t" * n + "}" for n in reversed(range(depth, len(path)))]
        insert = "\n".join(lines) + "\n"
        if block.open_at < 0:
            at = len(text)
            if text and not text.endswith("\n"):
                insert = "\n" + insert
        else:
            at = text.rfind("\n", 0, block.close_at) + 1
            if text[at:block.close_at].strip():  # the closing brace shares its line
                insert = "\n" + insert
                at = block.close_at
        edits.append((at, at, insert))
    for start, end, new in sorted(edits, reverse=True):
        text = text[:start] + new + text[end:]
    return text


def steam_running(home, proc=Path("/proc")):
    """Whether this user runs a Steam client from under `home`."""
    uid = os.getuid()
    marker = str(home).encode()
    for entry in proc.iterdir():
        if not entry.name.isdigit():
            continue
        try:
            if entry.stat().st_uid != uid:
                continue
            program = (entry / "cmdline").read_bytes().split(b"\0", 1)[0]
        except OSError:
            continue
        if program.rsplit(b"/", 1)[-1] == b"steam" and program.startswith(marker):
            return True
    return False


def apply(home, proc=Path("/proc")):
    home = Path(home)
    if steam_running(home, proc):
        return 0
    for relative in STEAM_DIRS:
        config = home / relative / "config" / "config.vdf"
        if not config.parent.is_dir():
            continue
        current = config.read_text() if config.exists() else ""
        updated = with_defaults(current)
        if updated == current:
            continue
        fd, temporary = tempfile.mkstemp(prefix=".config.vdf.", dir=config.parent)
        try:
            with os.fdopen(fd, "w") as out:
                out.write(updated)
            os.replace(temporary, config)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
    return 0


if __name__ == "__main__":
    sys.exit(apply(sys.argv[1] if len(sys.argv) > 1 else Path.home()))
