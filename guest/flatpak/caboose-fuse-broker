#!/usr/bin/env python3
"""FUSE mounts for a container computer, made from outside it.

A container computer has no /dev/fuse and may not mount; the host runs this beside it, in a
privileged sidecar container that shares the computer's process namespace
(docs/architecture.md § Computers). It listens on the computer's /run/caboose/fuse.sock
(through /proc/1/root) for caboose-fusermount, the computer's fusermount3, and for each
request:

  {"op": "mount", "mountpoint": PATH, "options": "rw,nosuid,fsname=portal,..."}
  {"op": "unmount", "mountpoint": PATH, "lazy": true}

checks the caller (its uid from the socket's credentials) and the mountpoint: a directory the
caller owns under /run/user/<its uid>, resolved inside the computer. A mount opens /dev/fuse
here, mounts it there as a FUSE file system owned by the caller (nosuid, nodev, and only the
options fusermount3 allows a user), and sends the open /dev/fuse back with the reply; an
unmount takes off only a FUSE mount of the caller's. Nothing else is done for anyone."""
import array
import ctypes
import json
import os
import socket
import stat
import sys

ROOT = '/proc/1/root'  # the computer's file system, from its process namespace
SOCKET = '/run/caboose/fuse.sock'
MS_RDONLY, MS_NOSUID, MS_NODEV, MS_NOEXEC, MS_SYNCHRONOUS, MS_DIRSYNC, MS_NOATIME, MS_NODIRATIME = 1, 2, 4, 8, 16, 128, 1024, 2048
FLAGS = {'ro': MS_RDONLY, 'noexec': MS_NOEXEC, 'sync': MS_SYNCHRONOUS, 'dirsync': MS_DIRSYNC, 'noatime': MS_NOATIME,
         'nodiratime': MS_NODIRATIME}
IGNORED = {'rw', 'nosuid', 'nodev', 'suid', 'dev', 'exec', 'async', 'atime', 'diratime', 'relatime', 'norelatime',
           'strictatime', 'nostrictatime', 'lazytime', 'nolazytime', 'auto', 'noauto', 'user', 'nouser', 'users'}
KERNEL = {'default_permissions', 'max_read', 'blksize'}  # what fusermount3 passes for a user
libc = ctypes.CDLL(None, use_errno=True)


class Refused(Exception):
    pass


def mount_data(options, fd, mode, uid, gid):
    """(flags, source, type, data) for fusermount3's option string, as it builds them for a user."""
    flags, source, subtype, extra = MS_NOSUID | MS_NODEV, 'fuse', None, []
    for option in filter(None, (options or '').split(',')):
        key, _, value = option.partition('=')
        if key in FLAGS and not value:
            flags |= FLAGS[key]
        elif key in IGNORED and not value:
            continue
        elif key == 'fsname' and value:
            source = value
        elif key == 'subtype' and value:
            subtype = value
        elif key in KERNEL:
            if value and not value.isdigit():
                raise Refused(f'bad option {option}')
            extra.append(option)
        else:
            raise Refused(f'option {key} is not allowed')
    if any(c in source + (subtype or '') for c in ',\n\0'):
        raise Refused('bad fsname or subtype')
    data = ','.join([f'fd={fd}', f'rootmode={mode:o}', f'user_id={uid}', f'group_id={gid}', *extra])
    return flags, source, f'fuse.{subtype}' if subtype else 'fuse', data


def checked_mountpoint(path, uid):
    """`path` resolved in the computer: a directory `uid` owns under /run/user/<uid>."""
    if not isinstance(path, str) or not path.startswith('/') or '\0' in path:
        raise Refused('the mountpoint must be an absolute path')
    real = os.path.realpath(path)
    base = f'/run/user/{uid}'
    if real != base and not real.startswith(base + '/'):
        raise Refused(f'mounts are only allowed under {base}')
    info = os.stat(real)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != uid:
        raise Refused('the mountpoint must be a directory the caller owns')
    return real, info


def fuse_mounted_by(path, uid):
    with open('/proc/self/mountinfo') as f:
        for line in f:
            fields = line.split()
            dash = fields.index('-')
            if fields[4] == path and fields[dash + 1].startswith('fuse') and f'user_id={uid}' in fields[dash + 3].split(','):
                return True
    return False


def serve_one(conn):
    """In a child process: read one request, act on it inside the computer, reply."""
    creds = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12)
    _pid, uid, gid = array.array('i', creds)
    request = json.loads(conn.recv(65536) or b'{}')
    device = os.open('/dev/fuse', os.O_RDWR | os.O_CLOEXEC) if request.get('op') == 'mount' else None
    os.setns(os.open('/proc/1/ns/mnt', os.O_RDONLY), os.CLONE_NEWNS)
    os.chdir('/')
    try:
        if request.get('op') == 'mount':
            path, info = checked_mountpoint(request.get('mountpoint'), uid)
            flags, source, kind, data = mount_data(request.get('options'), device, stat.S_IFMT(info.st_mode), uid, gid)
            if libc.mount(source.encode(), path.encode(), kind.encode(), flags, data.encode()) != 0:
                raise Refused(os.strerror(ctypes.get_errno()))
            conn.sendmsg([json.dumps({'ok': True}).encode()], [(socket.SOL_SOCKET, socket.SCM_RIGHTS, array.array('i', [device]))])
            return
        if request.get('op') == 'unmount':
            path, _ = checked_mountpoint(request.get('mountpoint'), uid)
            if not fuse_mounted_by(path, uid):
                raise Refused('no FUSE mount of the caller there')
            if libc.umount2(path.encode(), 2 if request.get('lazy') else 0) != 0:
                raise Refused(os.strerror(ctypes.get_errno()))
            conn.sendall(json.dumps({'ok': True}).encode())
            return
        raise Refused('op must be mount or unmount')
    except (Refused, OSError, ValueError) as error:
        conn.sendall(json.dumps({'ok': False, 'error': str(error)}).encode())


def main():
    path = ROOT + SOCKET
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(path)
    os.chmod(path, 0o666)  # every user may ask to mount on what it owns
    server.listen(16)
    while True:
        conn, _ = server.accept()
        pid = os.fork()
        if pid == 0:
            try:
                serve_one(conn)
            except Exception as error:  # a broken request ends only its own child
                try:
                    conn.sendall(json.dumps({'ok': False, 'error': f'{type(error).__name__}: {error}'}).encode())
                except OSError:
                    pass
            finally:
                os._exit(0)
        conn.close()
        while True:  # reap finished children
            try:
                if os.waitpid(-1, os.WNOHANG)[0] == 0:
                    break
            except ChildProcessError:
                break


if __name__ == '__main__':
    sys.exit(main())
