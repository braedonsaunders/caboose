{
  "manifest_version": 3,
  "name": "Caboose media handoff",
  "version": "1.0.0",
  "description": "Offers videos playing on your Caboose computer to the Caboose app, so they can play on your iPhone or Apple TV.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["nativeMessaging", "storage", "alarms"],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["media-kind.js", "content.js"]
    }
  ]
}
