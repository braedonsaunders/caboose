{
  "manifest_version": 3,
  "name": "Caboose WebMCP",
  "version": "1.0.0",
  "description": "Gives the agent seat's desktop tools the tools a page declares with WebMCP, and tools derived from its forms, links and buttons.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["nativeMessaging", "tabs"],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "run_at": "document_start", "world": "MAIN", "js": ["page.js"] },
    { "matches": ["<all_urls>"], "run_at": "document_start", "js": ["content.js"] }
  ]
}
